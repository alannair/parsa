{
  "format": "parsa-benchmark-sweep-v1",
  "model": "/mnt/nvme1/models/qwen3-4b",
  "tp": 2,
  "client_defaults": {
    "prompt_source": "azure-mix",
    "azure_mix_schedule_csv": "/datasets/azure-mix/scheduled_prompts.csv",
    "stream_metrics": true
  },
  "routing": {
    "routing_policy": null,
    "routing_kwargs": {
      "feedback": { "enabled": false },
      "kv_project": { "enabled": false }
    }
  },
  "lanes": [
    {
      "role": "kv-baseline",
      "preset_id": "lane_d",
      "lane_type": "decode",
      "backend_url": "http://127.0.0.1:8200",
      "capabilities": {
        "kv_projection": true
      },
      "workloads": [
        {
          "suffix": "conv",
          "active_pools": "conversation",
          "max_tokens": 4096,
          "total_num_reqs": 100,
          "notes": "Concurrency ladder: fixed decode length, sweep concurrent sequences."
        }
      ],
      "sweep": {
        "max_num_batched_tokens": [8192],
        "max_num_seqs": [10, 25, 50, 100, 200],
        "frequency_mhz": [1300]
      }
    },
    {
      "role": "kv-baseline",
      "preset_id": "lane_d",
      "lane_type": "decode",
      "backend_url": "http://127.0.0.1:8200",
      "capabilities": {
        "kv_projection": true
      },
      "workloads": [
        {
          "suffix": "short",
          "active_pools": "conversation",
          "max_tokens": 512,
          "total_num_reqs": 100,
          "notes": "Sequence-length ladder: short decode."
        },
        {
          "suffix": "medium",
          "active_pools": "conversation",
          "max_tokens": 2048,
          "total_num_reqs": 100,
          "notes": "Sequence-length ladder: medium decode."
        },
        {
          "suffix": "long",
          "active_pools": "code",
          "max_tokens": 8192,
          "total_num_reqs": 100,
          "notes": "Sequence-length ladder: long decode."
        }
      ],
      "sweep": {
        "max_num_batched_tokens": [8192],
        "max_num_seqs": [50],
        "frequency_mhz": [1300]
      }
    }
  ]
}
