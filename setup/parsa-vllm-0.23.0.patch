+
+@config
+class ParsaConfig:
+    """Configuration for PARSA router integration (KV projection telemetry)."""
+
+    enable_kv_projection: bool = False
+    """If True, expose GET /admin/parsa/kv-projection and parse PARSA headers."""
+
+    engine_id: str = ""
+    """Backend lane id; must match the PARSA preset id when KV projection is on."""
+
+    horizon_iters: int = 32
+    """Number of future decode iterations in projection vectors."""
+
+    iter_interval_ms: int = 50
+    """Assumed milliseconds per decode iteration for recovery-time estimates."""
