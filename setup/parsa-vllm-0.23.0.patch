+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from collections.abc import Mapping
+from typing import Any
+
+from vllm.sampling_params import SamplingParams
+
+_HEADER_MAP = {
+    "x-energy-aware-request-id": "request_id",
+    "x-energy-aware-l-in": "l_in",
+    "x-energy-aware-l-out-predicted-raw": "l_out_predicted_raw",
+    "x-energy-aware-l-out-effective": "l_out_effective",
+    "x-energy-aware-max-latency-s": "max_latency_s",
+    "x-energy-aware-target-ttft-s": "target_ttft_s",
+    "x-energy-aware-target-tpot-s": "target_tpot_s",
+    "x-energy-aware-predicted-output-tokens-p50": "predicted_output_tokens_p50",
+    "x-energy-aware-predicted-output-tokens-p90": "predicted_output_tokens_p90",
+    "x-energy-aware-predicted-output-tokens-p95": "predicted_output_tokens_p95",
+}
+
+
+def extract_parsa_metadata(
+    headers: Mapping[str, str] | None,
+) -> dict[str, Any] | None:
+    if not headers:
+        return None
+    metadata: dict[str, Any] = {}
+    for key, value in headers.items():
+        field = _HEADER_MAP.get(key.lower())
+        if field is None:
+            continue
+        metadata[field] = value
+    return metadata or None
+
+
+def merge_parsa_metadata(
+    sampling_params: SamplingParams,
+    metadata: dict[str, Any] | None,
+) -> None:
+    if not metadata:
+        return
+    if sampling_params.extra_args is None:
+        sampling_params.extra_args = {}
+    sampling_params.extra_args["parsa_metadata"] = dict(metadata)
