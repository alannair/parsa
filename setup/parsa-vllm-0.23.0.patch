diff --git a/vllm/parsa/kv_projection.py b/vllm/parsa/kv_projection.py
new file mode 100644
index 0000000000000000000000000000000000000000..d11f0b2a313794aa9e4559d2f7b248ee057f246d
--- /dev/null
+++ b/vllm/parsa/kv_projection.py
@@ -0,0 +1,209 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import math
+import time
+from typing import TYPE_CHECKING, Any
+
+if TYPE_CHECKING:
+    from vllm.config import CacheConfig
+    from vllm.config.parsa import ParsaConfig
+    from vllm.v1.core.kv_cache_manager import KVCacheManager
+    from vllm.v1.core.sched.scheduler import Scheduler
+    from vllm.v1.request import Request
+
+SCHEMA_VERSION = "parsa.vllm.kv_projection.v1"
+QUANTILES = ("p50", "p90", "p95")
+RECOVERY_THRESHOLDS = ("0.80", "0.70", "0.60")
+
+
+def blocks_for_tokens(num_tokens: int, block_size: int) -> int:
+    if num_tokens <= 0 or block_size <= 0:
+        return 0
+    return int(math.ceil(float(num_tokens) / float(block_size)))
+
+
+def _predicted_output_tokens(request: "Request", quantile: str) -> float:
+    metadata = getattr(request, "parsa_metadata", None) or {}
+    key = "predicted_output_tokens_%s" % quantile
+    raw = metadata.get(key)
+    if raw is not None:
+        return max(0.0, float(raw))
+    if (
+        request.sampling_params is not None
+        and request.sampling_params.max_tokens is not None
+    ):
+        return max(0.0, float(request.sampling_params.max_tokens))
+    return max(0.0, float(request.max_tokens or 0))
+
+
+def _prompt_tokens(request: "Request") -> int:
+    metadata = getattr(request, "parsa_metadata", None) or {}
+    raw = metadata.get("l_in")
+    if raw is not None:
+        return max(request.num_prompt_tokens, int(round(float(raw))))
+    return request.num_prompt_tokens
+
+
+def _current_blocks(request: "Request", kv_cache_manager: "KVCacheManager") -> int:
+    block_ids = kv_cache_manager.get_block_ids(request.request_id)
+    if not block_ids:
+        return 0
+    return len(block_ids[0])
+
+
+def _request_projection_rows(
+    running: list["Request"],
+    kv_cache_manager: "KVCacheManager",
+    block_size: int,
+    horizon_iters: int,
+) -> list[dict[str, Any]]:
+    rows: list[dict[str, Any]] = []
+    for request in running:
+        predicted = {
+            quantile: _predicted_output_tokens(request, quantile)
+            for quantile in QUANTILES
+        }
+        rows.append({
+            "prompt_tokens": _prompt_tokens(request),
+            "generated_tokens": request.num_output_tokens,
+            "current_blocks": _current_blocks(request, kv_cache_manager),
+            "predicted": predicted,
+        })
+    return rows
+
+
+def _projected_blocks(
+    prompt_tokens: int,
+    generated_tokens: int,
+    predicted_output: float,
+    iter_offset: int,
+    block_size: int,
+    current_blocks: int,
+) -> int:
+    projected_output = min(predicted_output, float(generated_tokens + iter_offset))
+    total_tokens = prompt_tokens + int(projected_output)
+    projected = blocks_for_tokens(total_tokens, block_size)
+    return max(current_blocks, projected)
+
+
+def _recovery_times_ms(
+    utilization_series: list[float],
+    iter_interval_ms: int,
+) -> dict[str, int]:
+    result: dict[str, int] = {}
+    for threshold in RECOVERY_THRESHOLDS:
+        target = float(threshold)
+        recovery = -1
+        for iter_offset, utilization in enumerate(utilization_series):
+            if utilization < target:
+                recovery = iter_offset * iter_interval_ms
+                break
+        result[threshold] = recovery
+    return result
+
+
+def build_kv_projection_snapshot(
+    scheduler: "Scheduler",
+    kv_cache_manager: "KVCacheManager",
+    cache_config: "CacheConfig",
+    parsa_config: "ParsaConfig",
+) -> dict[str, Any]:
+    block_pool = kv_cache_manager.block_pool
+    npu_blocks = max(0, block_pool.num_gpu_blocks - 1)
+    npu_free_blocks = block_pool.get_num_free_blocks()
+    npu_used_blocks = max(0, npu_blocks - npu_free_blocks)
+    block_size = scheduler.block_size
+    host_blocks = int(cache_config.num_cpu_blocks or 0)
+    host_used_blocks = 0
+
+    running = list(scheduler.running)
+    active_requests = len(running)
+    horizon_iters = max(1, int(parsa_config.horizon_iters or 32))
+    iter_interval_ms = max(1, int(parsa_config.iter_interval_ms or 50))
+    rows = _request_projection_rows(
+        running, kv_cache_manager, block_size, horizon_iters
+    )
+
+    projection: dict[str, list[dict[str, int]]] = {
+        quantile: [] for quantile in QUANTILES
+    }
+    peak_blocks = {quantile: npu_used_blocks for quantile in QUANTILES}
+    peak_batch = {quantile: active_requests for quantile in QUANTILES}
+
+    for iter_offset in range(horizon_iters):
+        for quantile in QUANTILES:
+            batch_size = 0
+            total_blocks = 0
+            for row in rows:
+                predicted = float(row["predicted"][quantile])
+                generated = int(row["generated_tokens"])
+                if generated + iter_offset < predicted:
+                    batch_size += 1
+                total_blocks += _projected_blocks(
+                    prompt_tokens=int(row["prompt_tokens"]),
+                    generated_tokens=generated,
+                    predicted_output=predicted,
+                    iter_offset=iter_offset,
+                    block_size=block_size,
+                    current_blocks=int(row["current_blocks"]),
+                )
+            projection[quantile].append({
+                "iter_offset": iter_offset,
+                "batch_size": batch_size,
+                "npu_kv_blocks": total_blocks,
+            })
+            peak_blocks[quantile] = max(peak_blocks[quantile], total_blocks)
+            peak_batch[quantile] = max(peak_batch[quantile], batch_size)
+
+    capacity_den = float(npu_blocks) if npu_blocks > 0 else 1.0
+    peak_utilization = {
+        quantile: float(peak_blocks[quantile]) / capacity_den
+        for quantile in QUANTILES
+    }
+    current_utilization = float(npu_used_blocks) / capacity_den
+    utilization_series = [
+        max(
+            current_utilization,
+            float(projection["p95"][iter_offset]["npu_kv_blocks"]) / capacity_den,
+        )
+        for iter_offset in range(horizon_iters)
+    ]
+
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "ts_s": time.time(),
+        "engine_id": str(parsa_config.engine_id),
+        "block_size_tokens": int(block_size),
+        "capacity": {
+            "npu_blocks": int(npu_blocks),
+            "host_blocks": int(host_blocks),
+        },
+        "current": {
+            "npu_used_blocks": int(npu_used_blocks),
+            "npu_free_blocks": int(npu_free_blocks),
+            "host_used_blocks": int(host_used_blocks),
+            "active_requests": int(active_requests),
+        },
+        "projection_basis": {
+            "mode": "router_hints_plus_runtime",
+            "horizon_iters": int(horizon_iters),
+            "quantiles": [0.5, 0.9, 0.95],
+        },
+        "projection": projection,
+        "summary": {
+            "peak_npu_blocks": {
+                quantile: int(peak_blocks[quantile]) for quantile in QUANTILES
+            },
+            "peak_utilization": {
+                quantile: float(peak_utilization[quantile])
+                for quantile in QUANTILES
+            },
+            "peak_batch_size": {
+                quantile: int(peak_batch[quantile]) for quantile in QUANTILES
+            },
+            "time_to_below_utilization_ms": _recovery_times_ms(
+                utilization_series, iter_interval_ms
+            ),
+        },
+    }
