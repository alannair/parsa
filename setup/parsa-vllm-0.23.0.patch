new file mode 100644
index 0000000000000000000000000000000000000000..002282649d45efa60ec9bd344c29b43a053ed910
--- /dev/null
+++ b/tests/parsa/test_kv_projection.py
@@ -0,0 +1,141 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import unittest
+from types import SimpleNamespace
+
+from vllm.config import CacheConfig
+from vllm.config.parsa import ParsaConfig
+from vllm.parsa.kv_projection import (
+    QUANTILES,
+    SCHEMA_VERSION,
+    blocks_for_tokens,
+    build_kv_projection_snapshot,
+)
+from vllm.parsa.metadata import extract_parsa_metadata, merge_parsa_metadata
+from vllm.sampling_params import SamplingParams
+
+
+class FakeRequest:
+    def __init__(
+        self,
+        request_id: str,
+        prompt_tokens: int,
+        output_tokens: int,
+        max_tokens: int,
+        parsa_metadata=None,
+    ):
+        self.request_id = request_id
+        self.num_prompt_tokens = prompt_tokens
+        self.num_output_tokens = output_tokens
+        self.max_tokens = max_tokens
+        self.sampling_params = SamplingParams(max_tokens=max_tokens)
+        self.parsa_metadata = parsa_metadata
+
+
+class FakeKVCacheManager:
+    def __init__(
+        self, num_gpu_blocks: int, num_free_blocks: int, blocks_per_request: int
+    ):
+        self.block_pool = SimpleNamespace(
+            num_gpu_blocks=num_gpu_blocks,
+            get_num_free_blocks=lambda: num_free_blocks,
+        )
+        self._blocks_per_request = blocks_per_request
+
+    def get_block_ids(self, request_id: str):
+        return ([1] * self._blocks_per_request,)
+
+
+class ParsaKVProjectionTests(unittest.TestCase):
+    def test_extract_parsa_metadata(self):
+        metadata = extract_parsa_metadata({
+            "X-Energy-Aware-Request-Id": "req-1",
+            "X-Energy-Aware-L-In": "128",
+            "X-Energy-Aware-Predicted-Output-Tokens-P95": "64",
+        })
+        self.assertEqual(metadata["request_id"], "req-1")
+        self.assertEqual(metadata["l_in"], "128")
+        self.assertEqual(metadata["predicted_output_tokens_p95"], "64")
+
+    def test_merge_parsa_metadata(self):
+        params = SamplingParams(max_tokens=16)
+        merge_parsa_metadata(params, {"request_id": "req-2"})
+        self.assertEqual(params.extra_args["parsa_metadata"]["request_id"], "req-2")
+
+    def test_blocks_for_tokens(self):
+        self.assertEqual(blocks_for_tokens(0, 16), 0)
+        self.assertEqual(blocks_for_tokens(1, 16), 1)
+        self.assertEqual(blocks_for_tokens(16, 16), 1)
+        self.assertEqual(blocks_for_tokens(17, 16), 2)
+
+    def test_build_snapshot_matches_contract(self):
+        scheduler = SimpleNamespace(
+            running=[
+                FakeRequest(
+                    "r1",
+                    prompt_tokens=32,
+                    output_tokens=4,
+                    max_tokens=64,
+                    parsa_metadata={
+                        "predicted_output_tokens_p50": "32",
+                        "predicted_output_tokens_p90": "48",
+                        "predicted_output_tokens_p95": "64",
+                    },
+                ),
+            ],
+            block_size=16,
+        )
+        kv_cache_manager = FakeKVCacheManager(
+            num_gpu_blocks=101,
+            num_free_blocks=40,
+            blocks_per_request=3,
+        )
+        cache_config = CacheConfig()
+        cache_config.num_cpu_blocks = 0
+        parsa_config = ParsaConfig(
+            enable_kv_projection=True, engine_id="lane_hot", horizon_iters=4
+        )
+
+        snapshot = build_kv_projection_snapshot(
+            scheduler=scheduler,
+            kv_cache_manager=kv_cache_manager,
+            cache_config=cache_config,
+            parsa_config=parsa_config,
+        )
+
+        self.assertEqual(snapshot["schema_version"], SCHEMA_VERSION)
+        self.assertEqual(snapshot["engine_id"], "lane_hot")
+        self.assertEqual(snapshot["block_size_tokens"], 16)
+        self.assertEqual(snapshot["capacity"]["npu_blocks"], 100)
+        self.assertEqual(snapshot["current"]["npu_used_blocks"], 60)
+        self.assertEqual(snapshot["current"]["npu_free_blocks"], 40)
+        self.assertEqual(snapshot["current"]["active_requests"], 1)
+        self.assertEqual(
+            snapshot["projection_basis"]["mode"], "router_hints_plus_runtime"
+        )
+        self.assertEqual(snapshot["projection_basis"]["horizon_iters"], 4)
+
+        for quantile in QUANTILES:
+            self.assertEqual(len(snapshot["projection"][quantile]), 4)
+            first = snapshot["projection"][quantile][0]
+            self.assertEqual(
+                set(first.keys()), {"iter_offset", "batch_size", "npu_kv_blocks"}
+            )
+            self.assertGreaterEqual(
+                snapshot["summary"]["peak_npu_blocks"][quantile],
+                snapshot["current"]["npu_used_blocks"],
+            )
+
+        self.assertLessEqual(
+            snapshot["summary"]["peak_utilization"]["p50"],
+            snapshot["summary"]["peak_utilization"]["p90"],
+        )
+        self.assertLessEqual(
+            snapshot["summary"]["peak_utilization"]["p90"],
+            snapshot["summary"]["peak_utilization"]["p95"],
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
