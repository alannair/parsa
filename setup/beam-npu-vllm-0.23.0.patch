+class AscendEnergyLogger:
+    """Sample only during profiling; synchronize each recorded end only at stop.
+
+    Args:
+        rank: Global model-parallel worker rank for NPU CSV filenames.
+        controller: Worker-owned physical-device DSMI controller.
+        device: Assigned Torch NPU device for current-stream selection.
+        interval_s: Positive finite power-sampling interval in seconds.
+
+    A sampling error, invalid event, or gap exceeding three sampling intervals
+    rejects the window instead of yielding a misleading energy estimate. Failed
+    data remains resident. A valid final window is frozen before CSV writes so
+    retrying an I/O failure never extends the energy integration interval.
+    """
+
+    def __init__(self, rank, controller, device, interval_s: float = 0.05):
+        if type(rank) is not int or rank < 0:
+            raise ValueError("BEAM NPU profiler rank must be a nonnegative integer")
+        if (
+            isinstance(interval_s, bool)
+            or not isinstance(interval_s, (int, float))
+            or not math.isfinite(interval_s)
+            or interval_s <= 0
+        ):
+            raise ValueError("BEAM NPU sampling interval must be finite positive seconds")
+        self.rank = rank
+        self.controller = controller
+        self.device = device
+        self.interval_s = float(interval_s)
+        self.do_log = False
+        self.output_dir = None
+        self._unflushed = False
+        self._finished = False
+        self._frozen = None
+        self._failure = None
+        self._thread_error = None
+        self._stop_event = Event()
+        self._sampler_gate = Lock()
+        self._sampler_entered = Event()
+        self._sampler_exited = Event()
+        self._sampler_exited.set()  # No sampler has been launched.
+        self._sampler_stop_error = None
+        self._thread = None
+        # ponytail: O(forwards + samples) until stop; chunk long profile windows.
+        self._pending = []
+        self.power_log = []
+        self.dvfs_log = []
+        self.connector_log = []
+
+    def _fail(self, error) -> None:
+        if self._failure is None:
+            self._failure = error
+
+    def _sample(self) -> None:
+        before = time.monotonic()
+        power = float(self.controller.get_power_w())
+        clock = self.controller.get_clock_mhz()
+        after = time.monotonic()
+        monotonic_s = (before + after) / 2.0
+        if (
+            not all(math.isfinite(value) for value in (before, after, power))
+            or before < 0
+            or after < before
+            or power < 0
+            or type(clock) is not int
+            or clock <= 0
+            or (self.power_log and monotonic_s <= self.power_log[-1][1])
+        ):
+            raise RuntimeError("BEAM NPU received invalid or nonmonotonic power data")
+        self.power_log.append(
+            (
+                datetime.now().isoformat(sep=" "), monotonic_s, power, clock,
+                self.controller.device_id,
+            )
+        )
+
+    def _sample_loop(self, stop_event, entered, exited) -> None:
+        try:
+            with self._sampler_gate:
+                if stop_event.is_set():
+                    return
+                entered.set()
+            while not stop_event.wait(self.interval_s):
+                self._sample()
+        except BaseException as error:
+            self._thread_error = error
+            stop_event.set()
+        finally:
+            # Only this sampler confirms exit after its last possible DSMI call.
+            exited.set()
+
+    @property
+    def sampler_quiescent(self) -> bool:
+        """Confirm exit, or cancellation before entry, without Thread.is_alive()."""
+        with self._sampler_gate:
+            return self._sampler_exited.is_set() or (
+                self._stop_event.is_set() and not self._sampler_entered.is_set()
+            )
+
+    def _stop_sampler(self, primary=None) -> None:
+        if self._sampler_stop_error is None:
+            self._sampler_stop_error = primary
+        deadline = time.monotonic() + _SAMPLER_EXIT_TIMEOUT_S
+        while True:
+            try:
+                # Serialize cancellation with entry, including interrupted start().
+                with self._sampler_gate:
+                    self._stop_event.set()
+                if self._sampler_entered.is_set() and not self._sampler_exited.is_set():
+                    remaining = deadline - time.monotonic()
+                    if remaining <= 0:
+                        break
+                    self._sampler_exited.wait(remaining)
+                    if not self._sampler_exited.is_set():
+                        break
+                if self._thread is not None and self._thread.ident is not None:
+                    self._thread.join(max(0.0, deadline - time.monotonic()))
+                self._thread = None
+                break
+            except BaseException as error:
+                if self._sampler_stop_error is None:
+                    self._sampler_stop_error = error
+                # Retry signal/control-flow interruptions, not failed APIs.
+                if isinstance(error, Exception) or time.monotonic() >= deadline:
+                    break
+        if not self.sampler_quiescent:
+            # A timeout is containment, NEVER evidence permitting teardown.
+            raise RuntimeError(
+                "BEAM NPU sampler exit is unconfirmed; controller restoration and "
+                "native teardown are blocked; sampler/data/first stop error retained"
+            ) from self._sampler_stop_error
+        if self._sampler_stop_error is not None:
+            raise self._sampler_stop_error
+
+    def start(self, output_dir: str | None = None) -> None:
+        if self.do_log or self._unflushed:
+            raise RuntimeError("BEAM NPU profiler is active or has unflushed data")
+        if output_dir is None or not str(output_dir).strip():
+            raise ValueError("BEAM NPU profiler requires an output directory")
+        directory = Path(output_dir)
+        directory.mkdir(parents=True, exist_ok=True)
+        self.output_dir = directory
+        self._pending.clear()
+        self.power_log.clear()
+        self.dvfs_log.clear()
+        self.connector_log.clear()
+        self._failure = self._thread_error = None
+        self._frozen = None
+        self._finished = False
+        self._unflushed = True
+        self._sampler_stop_error = None
+        # Fresh per-launch events keep a cancelled, late bootstrap from observing
+        # a later profile's cleared stop flag or signalling its completion.
+        self._stop_event = Event()
+        self._sampler_entered = Event()
+        self._sampler_exited = Event()
+        try:
+            # Keep lazy discovery/library loading outside the first observation.
+            self.controller.initialize()
+            # A real, valid sample exists before the caller may enqueue forwards.
+            self._sample()
+            self._thread = Thread(
+                target=self._sample_loop,
+                args=(
+                    self._stop_event, self._sampler_entered, self._sampler_exited,
+                ),
+                name=f"beam-npu-power-{self.rank}",
+                daemon=True,
+            )
+            self._thread.start()
+            if self._thread_error is not None:
+                raise RuntimeError("BEAM NPU power sampler failed at start") from (
+                    self._thread_error
+                )
+            self.do_log = True
+        except BaseException as error:
+            self.do_log = False
+            self._fail(error)
+            self._stop_sampler(error)
+            raise
+
+    @contextmanager
+    def forward_context(self, scheduler_output, batch_size: int, num_reqs: int):
+        if not self.do_log:
+            yield
+            return
+        entry = None
+        try:
+            import torch
+            import torch_npu
+
+            stream = torch.npu.current_stream(self.device)
+            start = torch_npu.npu.Event(enable_timing=True)
+            end = torch_npu.npu.Event(enable_timing=True)
+            clock = self.controller.current_clock_mhz
+            if type(clock) is not int or clock <= 0:
+                raise RuntimeError("BEAM NPU forward has no observed clock sample")
+            entry = {
+                "start": start,
+                "end": end,
+                "end_recorded": False,
+                "metadata": (
+                    getattr(scheduler_output, "beam_step", 0),
+                    getattr(scheduler_output, "beam_phase", 0),
+                    batch_size, clock, num_reqs,
+                    datetime.now().isoformat(sep=" "),
+                    scheduler_output.total_num_scheduled_tokens,
+                    getattr(scheduler_output, "beam_clock_mhz", None),
+                ),
+            }
+            start.record(stream)
+            self._pending.append(entry)
+        except Exception as error:
+            # Instrumentation must not replace the native call or its exception.
+            self._fail(error)
+            entry = None
+        try:
+            yield
+        except BaseException as error:
+            self._fail(error)
+            raise
+        finally:
+            if entry is not None:
+                try:
+                    end.record(stream)
+                    entry["end_recorded"] = True
+                    entry["current_time"] = datetime.now().isoformat(sep=" ")
+                except Exception as error:
+                    self._fail(error)
+
+    def log_dvfs(
+        self,
+        clock_mhz,
+        num_scheduled_tokens,
+        expected_tbt,
+        *,
+        requested_clock_mhz=None,
+        step=0,
+        phase=0,
+    ) -> None:
+        if self.do_log:
+            self.dvfs_log.append(
+                (
+                    datetime.now().isoformat(sep=" "), clock_mhz,
+                    num_scheduled_tokens, expected_tbt, requested_clock_mhz,
+                    step, phase, self.controller.device_id,
+                )
+            )
+
+    @contextmanager
+    def connector_context(self, operation: str, layer: str | None = None):
+        if not self.do_log:
+            yield
+            return
+        if operation not in ("start_load_kv", "wait_for_layer_load"):
+            raise ValueError(f"Unknown BEAM NPU connector operation: {operation}")
+        wall_time = datetime.now().isoformat(sep=" ")
+        start = time.monotonic()
+        try:
+            yield
+        except BaseException as error:
+            self._fail(error)
+            raise
+        finally:
+            self.connector_log.append(
+                (
+                    operation, layer, wall_time, time.monotonic() - start,
+                    self.controller.device_id,
+                )
+            )
+
+    def _freeze_window(self) -> None:
+        samples = tuple(self.power_log)
+        if len(samples) < 2:
+            raise RuntimeError("BEAM NPU energy window has fewer than two valid samples")
+        energy_j = 0.0
+        for previous, current in zip(samples, samples[1:]):
+            delta_s = current[1] - previous[1]
+            if not 0 < delta_s <= 3 * self.interval_s:
+                raise RuntimeError(
+                    f"Incomplete BEAM NPU power series: sample gap {delta_s!r} s "
+                    f"exceeds three intervals ({3 * self.interval_s} s) or is invalid"
+                )
+            energy_j += (previous[2] + current[2]) * 0.5 * delta_s
+        energy_mj = energy_j * 1000.0
+        if not math.isfinite(energy_mj) or energy_mj < 0:
+            raise RuntimeError("Invalid BEAM NPU sampled energy estimate")
+        batches = []
+        for entry in self._pending:
+            elapsed = float(entry["start"].elapsed_time(entry["end"]))
+            if not math.isfinite(elapsed) or elapsed < 0:
+                raise RuntimeError("Invalid BEAM NPU runner-call event milliseconds")
+            step, phase, padded, clock, reqs, wall_start, tokens, requested = (
+                entry["metadata"]
+            )
+            batches.append(
+                (
+                    step, phase, elapsed, padded, clock, reqs, wall_start,
+                    entry["current_time"], tokens, requested, TIMING_DOMAIN,
+                    ENERGY_DOMAIN, self.controller.device_id,
+                )
+            )
+        window = (
+            samples[0][1], samples[-1][1], energy_mj, len(samples),
+            "trapezoidal_power_w", ENERGY_DOMAIN, self.controller.device_id,
+        )
+        self._frozen = (tuple(batches), samples, window)
+
+    def _write(self, name, header, rows) -> None:
+        with (self.output_dir / f"{name}_NPU_{self.rank}.csv").open(
+            "w", newline="", encoding="utf-8"
+        ) as output:
+            writer = csv.writer(output)
+            writer.writerow(header.split(","))
+            writer.writerows(rows)
+
+    def stop(self) -> None:
+        if not self._unflushed:
+            return
+        self.do_log = False
+        if self._finished:
+            # An interrupted join remains retryable even for an invalid window.
+            self._stop_sampler()
+        if not self._finished:
+            self._finished = True
+            primary = None
+            try:
+                try:
+                    # Every recorded end can belong to a different native stream.
+                    for entry in self._pending:
+                        if not entry["end_recorded"]:
+                            self._fail(RuntimeError("Incomplete BEAM NPU event pair"))
+                            continue
+                        try:
+                            entry["end"].synchronize()
+                        except BaseException as error:
+                            self._fail(error)
+                            if primary is None:
+                                primary = error
+                finally:
+                    self._stop_sampler(primary)
+                if self._thread_error is not None:
+                    self._fail(self._thread_error)
+                if self._failure is not None:
+                    raise RuntimeError(
+                        "BEAM NPU profile is incomplete; retained data cannot be exported"
+                    ) from self._failure
+                # This observation is after ALL recorded ends have synchronized.
+                self._sample()
+                self._freeze_window()
+            except BaseException as error:
+                self._fail(error)
+                raise
+        if self._failure is not None:
+            raise RuntimeError("BEAM NPU profile remains incomplete; data retained") from (
+                self._failure
+            )
+        batches, samples, window = self._frozen
+        # CSV errors leave this exact valid window and all source data retryable.
+        self._write("batch_log", BATCH_HEADER, batches)
+        self._write("power_log", POWER_HEADER, samples)
+        self._write("energy_window", ENERGY_WINDOW_HEADER, (window,))
+        self._write(
+            "dvfs_log",
+            "current_time,clock_mhz,num_scheduled_tokens,expected_tbt,"
+            "requested_clock_mhz,step,phase,device_id",
+            self.dvfs_log,
+        )
+        self._write(
+            "connector_log", "operation,layer,start_time,elapsed_time_s,device_id",
+            self.connector_log,
+        )
+        self._pending.clear()
+        self._unflushed = False
