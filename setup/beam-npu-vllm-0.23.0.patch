+"""Lazy, physical-device-bound DSMI control, without Torch or CANN imports.
+
+DSMI structures and operations originate in parsa/code/src/freq.py (GPL-3.0-or-
+later, same copyright) and setup/beam-vllm.patch's benchmarks/energy/ascend_freq.py.
+Unlike that implementation, restoration reads the assigned device's rated MHz.
+The catalog below is historical policy data, not a hardware capability probe.
+"""
+
+import ctypes
+import logging
+import os
+from threading import RLock
+
+ASCEND_FREQUENCIES = (900, 1000, 1100, 1200, 1300, 1400, 1500, 1650)
+_DSMI_LIBRARY = "/usr/local/Ascend/driver/lib64/driver/libdrvdsmi_host.so"
+logger = logging.getLogger(__name__)
+
+
+def resolve_ascend_device_id(
+    device_index: int, rank: int, device_map: dict[int, int] | None = None
+) -> int:
+    """Resolve the assigned logical index using explicit, agreeing metadata only."""
+    if any(type(value) is not int or value < 0 for value in (device_index, rank)):
+        raise ValueError("BEAM NPU device_index and global rank must be nonnegative ints")
+    mapped = None
+    if device_map is not None:
+        if not isinstance(device_map, dict) or any(
+            type(key) is not int
+            or key < 0
+            or type(value) is not int
+            or not 0 <= value <= 0x7FFFFFFF
+            for key, value in device_map.items()
+        ):
+            raise ValueError("beam_npu_device_map must map integer ranks to physical IDs")
+        if len(set(device_map.values())) != len(device_map):
+            raise ValueError("beam_npu_device_map physical device IDs must be unique")
+        if rank not in device_map:
+            raise ValueError(f"beam_npu_device_map has no entry for global rank {rank}")
+        mapped = device_map[rank]
+
+    visible = os.environ.get("ASCEND_RT_VISIBLE_DEVICES")
+    if visible is not None:
+        parts = [part.strip() for part in visible.split(",")]
+        if any(not part or not part.isascii() or not part.isdecimal() for part in parts):
+            raise ValueError("ASCEND_RT_VISIBLE_DEVICES must be a nonempty numeric list")
+        devices = [int(part) for part in parts]
+        if len(set(devices)) != len(devices) or any(
+            device > 0x7FFFFFFF for device in devices
+        ):
+            raise ValueError("ASCEND_RT_VISIBLE_DEVICES must contain unique physical IDs")
+        if device_index >= len(devices):
+            raise ValueError(
+                f"Assigned NPU index {device_index} is outside ASCEND_RT_VISIBLE_DEVICES"
+            )
+        physical = devices[device_index]
+        if mapped is not None and mapped != physical:
+            raise ValueError(
+                f"NPU mapping disagreement for rank {rank}: map={mapped}, "
+                f"visible[{device_index}]={physical}"
+            )
+        return physical
+    if mapped is None:
+        raise ValueError(
+            "BEAM requires beam_npu_device_map or nonempty ASCEND_RT_VISIBLE_DEVICES"
+        )
+    return mapped
+
+
+class _AicoreInfo(ctypes.Structure):
+    _fields_ = [("freq", ctypes.c_uint), ("curfreq", ctypes.c_uint)]
+
+
+class _PowerInfo(ctypes.Structure):
+    _fields_ = [("power", ctypes.c_ushort)]  # DSMI units: 0.1 W.
+
+
+class _SocStressCfg(ctypes.Structure):
+    _fields_ = [
+        ("type", ctypes.c_char),
+        ("set_restore", ctypes.c_char),
+        ("value", ctypes.c_uint16),
+    ]
+
+
+class _StressPayload(ctypes.Structure):
+    _fields_ = [("soc_stress_cfg", _SocStressCfg), ("resv", ctypes.c_char * 32)]
+
+
+class AscendClockController:
+    """Own synchronous clock changes on one exclusively assigned physical NPU.
+
+    Args:
+        device_id: Physical DSMI ID, not a rank or an unqualified logical index.
+        dsmi_library: Explicit library path; otherwise environment/default path.
+        backend: Optional DSMI C-ABI-shaped backend for source audits. Native
+            ctypes signatures are installed only on a lazily loaded CDLL.
+
+    Construction performs no discovery or hardware work. close() restores this
+    device's rated frequency, not an undiscoverable previous lock/automatic mode.
+    A loaded library remains referenced; it is never manually dlclosed.
+    """
+
+    def __init__(
+        self, device_id: int, dsmi_library: str | None = None, backend=None
+    ):
+        if type(device_id) is not int or not 0 <= device_id <= 0x7FFFFFFF:
+            raise ValueError("BEAM DSMI device_id must be a nonnegative physical ID")
+        if dsmi_library is not None and (
+            not isinstance(dsmi_library, str) or not dsmi_library.strip()
+        ):
+            raise ValueError("BEAM DSMI library path must be nonempty")
+        self.device_id = device_id
+        self.device_identity = f"NPU-{device_id}"
+        self.current_clock_mhz: int | None = None
+        self._library_path = dsmi_library
+        self._backend = backend
+        self._initialized = False
+        self._dirty = False
+        self._rated_clock_mhz: int | None = None
+        self._requested_clock_mhz: int | None = None
+        self._lock = RLock()
+
+    def _invalidate(self) -> None:
+        self._requested_clock_mhz = None
+        self.current_clock_mhz = None
+
+    def _call(self, name, *args) -> None:
+        try:
+            result = getattr(self._backend, name)(*args)
+            if type(result) is not int or result != 0:
+                raise RuntimeError(f"unexpected DSMI return code {result!r}")
+        except Exception as error:
+            self._invalidate()
+            raise RuntimeError(
+                f"BEAM DSMI {name} failed on {self.device_identity}: {error}"
+            ) from error
+
+    def initialize(self) -> None:
+        """Load lazily, enumerate host devices, and read this device's rated MHz."""
+        with self._lock:
+            if self._initialized:
+                return
+            if self._backend is None:
+                path = self._library_path
+                if path is None:
+                    path = os.environ.get("BEAM_ASCEND_DSMI_LIBRARY", _DSMI_LIBRARY)
+                try:
+                    if not path.strip():
+                        raise ValueError("BEAM_ASCEND_DSMI_LIBRARY must be nonempty")
+                    library = ctypes.CDLL(path)
+                    signatures = {
+                        "dsmi_get_device_count": [ctypes.POINTER(ctypes.c_int)],
+                        "dsmi_list_device": [ctypes.POINTER(ctypes.c_int), ctypes.c_int],
+                        "dsmi_get_device_frequency": [
+                            ctypes.c_int, ctypes.c_int, ctypes.POINTER(ctypes.c_uint)
+                        ],
+                        "dsmi_get_aicore_info": [
+                            ctypes.c_int, ctypes.POINTER(_AicoreInfo)
+                        ],
+                        "dsmi_get_device_power_info": [
+                            ctypes.c_int, ctypes.POINTER(_PowerInfo)
+                        ],
+                        "dsmi_set_device_info": [
+                            ctypes.c_uint, ctypes.c_uint, ctypes.c_uint,
+                            ctypes.c_void_p, ctypes.c_uint,
+                        ],
+                    }
+                    for name, arguments in signatures.items():
+                        function = getattr(library, name)
+                        function.argtypes = arguments
+                        function.restype = ctypes.c_int
+                    self._backend = library
+                except Exception as error:
+                    raise RuntimeError(
+                        f"Cannot load BEAM DSMI {path!r} for {self.device_identity}"
+                    ) from error
+            count = ctypes.c_int()
+            self._call("dsmi_get_device_count", ctypes.byref(count))
+            if count.value <= 0:
+                raise RuntimeError(f"DSMI enumerated no devices for {self.device_identity}")
+            devices = (ctypes.c_int * count.value)()
+            self._call("dsmi_list_device", devices, count.value)
+            if (
+                self.device_id not in devices
+                or any(device < 0 for device in devices)
+                or len(set(devices)) != count.value
+            ):
+                raise RuntimeError(
+                    f"DSMI enumeration {list(devices)} does not establish "
+                    f"assigned device {self.device_identity}"
+                )
+            rated = ctypes.c_uint()
+            self._call(
+                "dsmi_get_device_frequency", self.device_id, 9, ctypes.byref(rated)
+            )
+            if not 0 < rated.value <= 0xFFFF:
+                raise RuntimeError(
+                    f"Invalid rated MHz {rated.value} for {self.device_identity}"
+                )
+            self._rated_clock_mhz = rated.value
+            self._initialized = True
+
+    def get_clock_mhz(self) -> int:
+        """Read positive observed curfreq MHz, without assuming requested equality."""
+        with self._lock:
+            self.initialize()
+            info = _AicoreInfo()
+            self._call("dsmi_get_aicore_info", self.device_id, ctypes.byref(info))
+            if info.curfreq <= 0:
+                self._invalidate()
+                raise RuntimeError(f"Invalid observed MHz on {self.device_identity}")
+            self.current_clock_mhz = int(info.curfreq)
+            return self.current_clock_mhz
+
+    def get_power_w(self) -> float:
+        """Read instantaneous device power in watts; this is not an energy counter."""
+        with self._lock:
+            self.initialize()
+            info = _PowerInfo()
+            self._call("dsmi_get_device_power_info", self.device_id, ctypes.byref(info))
+            return info.power / 10.0
+
+    def _write_clock(self, clock_mhz: int) -> None:
+        payload = _StressPayload()
+        payload.soc_stress_cfg.type = b"\x00"
+        payload.soc_stress_cfg.set_restore = b"\x02"
+        payload.soc_stress_cfg.value = clock_mhz
+        self._call(
+            "dsmi_set_device_info", self.device_id, 8, 12,
+            ctypes.byref(payload), ctypes.sizeof(payload),
+        )
+
+    def set_clock(self, clock_mhz: int | None) -> int | None:
+        """Apply a checked catalog request; None performs no initialization or I/O."""
+        if clock_mhz is None:
+            return None
+        with self._lock:
+            try:
+                if type(clock_mhz) is not int or clock_mhz not in ASCEND_FREQUENCIES:
+                    raise ValueError(
+                        f"BEAM requested MHz {clock_mhz!r} is outside the historical "
+                        f"Ascend catalog {ASCEND_FREQUENCIES}; no capability probe"
+                    )
+                self.initialize()
+                if clock_mhz != self._requested_clock_mhz:
+                    self._invalidate()
+                    # A failing write can still have partially changed the device.
+                    self._dirty = True
+                    self._write_clock(clock_mhz)
+                observed = self.get_clock_mhz()
+                self._requested_clock_mhz = clock_mhz
+                return observed
+            except BaseException:
+                self._invalidate()
+                try:
+                    self.reset()
+                except Exception:
+                    logger.exception(
+                        "BEAM rated-frequency restoration also failed on %s",
+                        self.device_identity,
+                    )
+                raise
+
+    def reset(self) -> None:
+        """Restore the same device's rated MHz; retain dirty state on any failure."""
+        with self._lock:
+            self._invalidate()
+            if not self._dirty:
+                return
+            if self._rated_clock_mhz is None:
+                raise RuntimeError(f"Missing rated frequency for {self.device_identity}")
+            self._write_clock(self._rated_clock_mhz)
+            self.get_clock_mhz()
+            self._dirty = False
+
+    def close(self) -> None:
+        """Restore synchronously, keeping the library alive and failures retryable."""
+        with self._lock:
+            self.reset()
+            self._initialized = False
