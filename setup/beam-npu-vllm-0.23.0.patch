+"""Narrow BEAM extension of the released, regular Ascend NPUWorker.
+
+Native worker/runner source: vllm-ascend v0.23.0,
+5cb98caaadeff42b5b62b996e34bb2aaa29d20fd (Apache-2.0, Huawei/vLLM contributors).
+Clock ABI origins: parsa/code/src/freq.py (GPL-3.0-or-later, same copyright).
+The native worker owns model loading, PP metadata, execution, and sampling.
+"""
+
+import logging
+from contextlib import nullcontext
+from functools import wraps
+from importlib.metadata import PackageNotFoundError, version
+from pathlib import Path
+
+from vllm.v1.worker.beam_ascend import (
+    AscendClockController,
+    resolve_ascend_device_id,
+)
+from vllm.v1.worker.beam_ascend_profiler import AscendEnergyLogger
+from vllm.v1.worker.beam_dvfs import cleanup_on_beam_failure
+
+logger = logging.getLogger(__name__)
+_WORKER_CLASS = "vllm.v1.worker.beam_ascend_worker.BeamNPUWorker"
+
+
+def _check_versions() -> None:
+    for distribution, expected in (
+        ("vllm-ascend", "0.23.0"),
+        ("torch", "2.10.0"),
+        ("torch-npu", "2.10.0.post4"),
+    ):
+        try:
+            installed = version(distribution)
+        except PackageNotFoundError as error:
+            raise RuntimeError(
+                f"BEAM Ascend requires installed {distribution}=={expected}"
+            ) from error
+        if installed.split("+", 1)[0] != expected:
+            raise RuntimeError(
+                f"BEAM Ascend requires {distribution}=={expected} "
+                f"(local build metadata allowed); found {installed!r}"
+            )
+
+
+# Fail explicitly before importing a potentially incompatible native worker.
+# Distribution metadata checks do not initialize Torch, CANN, or DSMI.
+_check_versions()
+from vllm_ascend.worker.worker import NPUWorker  # noqa: E402
+
+
+class BeamNPUWorker(NPUWorker):
+    """Use native synchronous V1 execution with worker-local clocks/profiling."""
+
+    @cleanup_on_beam_failure
+    def __init__(
+        self,
+        vllm_config,
+        local_rank: int,
+        rank: int,
+        distributed_init_method: str,
+        is_driver_worker: bool = False,
+        **kwargs,
+    ):
+        self.beam_clock_controller: AscendClockController | None = None
+        self.beam_profiler: AscendEnergyLogger | None = None
+        self._beam_active_output = None
+        self._beam_native_model_forward = None
+        self._check_config(vllm_config, rank)
+        super().__init__(
+            vllm_config, local_rank, rank, distributed_init_method,
+            is_driver_worker=is_driver_worker, **kwargs,
+        )
+        # This pinned parent itself selects V1 on core 0.23.0. Check the actual
+        # selection; BEAM never rewrites runner flags or assumes V2 compatibility.
+        if self.use_v2_model_runner:
+            raise RuntimeError("BEAM Ascend requires the native V1 NPU model runner")
+        self._beam_dvfs_enabled = any(
+            getattr(self.parallel_config, flag, False)
+            for flag in (
+                "use_s1", "use_s1_dvfs_only", "use_s2", "use_window_based_dvfs_only"
+            )
+        )
+
+    @staticmethod
+    def _check_config(config, rank: int) -> None:
+        from vllm.config import CompilationMode, CUDAGraphMode
+        from vllm.v1.core.sched.scheduler import Scheduler
+
+        parallel = config.parallel_config
+        scheduler = config.scheduler_config
+        if not parallel.beam_enabled:
+            raise ValueError("BeamNPUWorker must only be selected for Ascend BEAM")
+        if (
+            parallel.distributed_executor_backend not in ("uni", "mp")
+            or parallel.nnodes != 1
+            or parallel.data_parallel_size != 1
+            or parallel.prefill_context_parallel_size != 1
+            or parallel.decode_context_parallel_size != 1
+        ):
+            raise ValueError(
+                "BEAM Ascend requires single-host uni/mp, DP1 and no context parallelism"
+            )
+        if parallel.distributed_executor_backend == "uni" and (
+            parallel.tensor_parallel_size * parallel.pipeline_parallel_size != 1
+        ):
+            raise ValueError(
+                "BEAM Ascend uni requires TP*PP=1; use mp for multiple workers"
+            )
+        if parallel.worker_cls not in ("auto", _WORKER_CLASS):
+            raise ValueError("BEAM Ascend does not admit alternate worker classes")
+        if parallel.worker_extension_cls not in (
+            None, "", "benchmarks.energy.worker_tools.BeamToolWorker",
+        ):
+            raise ValueError("BEAM Ascend admits only the BEAM tooling RPC extension")
+        if (
+            scheduler.async_scheduling is not False
+            or scheduler.get_scheduler_cls() is not Scheduler
+        ):
+            raise ValueError("BEAM Ascend requires the native synchronous Scheduler")
+        if (
+            not config.model_config.enforce_eager
+            or config.compilation_config.mode != CompilationMode.NONE
+            or config.compilation_config.cudagraph_mode != CUDAGraphMode.NONE
+        ):
+            raise ValueError("BEAM Ascend requires eager execution without graph capture")
+        world_size = parallel.tensor_parallel_size * parallel.pipeline_parallel_size
+        if type(rank) is not int or not 0 <= rank < world_size:
+            raise ValueError("BEAM Ascend rank must be a global TP/PP rank in DP1")
+        device_map = getattr(parallel, "beam_npu_device_map", None)
+        if device_map is not None:
+            if not isinstance(device_map, dict) or any(
+                type(key) is not int
+                or type(value) is not int
+                or not 0 <= value <= 0x7FFFFFFF
+                for key, value in device_map.items()
+            ):
+                raise ValueError("beam_npu_device_map must contain integer ranks and IDs")
+            if set(device_map) != set(range(world_size)):
+                raise ValueError("beam_npu_device_map must cover every global TP/PP rank")
+            if len(set(device_map.values())) != world_size:
+                raise ValueError("beam_npu_device_map physical IDs must be unique")
+
+    def _get_beam_clock_controller(self) -> AscendClockController:
+        if self.beam_clock_controller is None:
+            if self.device is None or self.device.type != "npu":
+                raise RuntimeError("BEAM Ascend requires an assigned native NPU device")
+            device_id = resolve_ascend_device_id(
+                self.device.index, self.rank,
+                getattr(self.parallel_config, "beam_npu_device_map", None),
+            )
+            self.beam_clock_controller = AscendClockController(
+                device_id,
+                dsmi_library=getattr(
+                    self.parallel_config, "beam_npu_dsmi_library", None
+                ),
+            )
+        return self.beam_clock_controller
+
+    @cleanup_on_beam_failure
+    def init_device(self):
+        result = super().init_device()
+        if getattr(self.parallel_config, "custom_profiler", False):
+            self._install_beam_forward_wrapper()
+        return result
+
+    def _install_beam_forward_wrapper(self) -> None:
+        if self._beam_native_model_forward is not None:
+            return
+        from vllm_ascend.worker.model_runner_v1 import NPUModelRunner
+
+        runner = self.model_runner
+        if type(runner) is not NPUModelRunner:
+            raise RuntimeError("BEAM profiler requires the released regular NPUModelRunner")
+        native_forward = runner._model_forward
+        self._beam_native_model_forward = native_forward
+
+        @wraps(native_forward)
+        def model_forward(
+            num_tokens_padded,
+            input_ids=None,
+            positions=None,
+            intermediate_tensors=None,
+            inputs_embeds=None,
+            **model_kwargs,
+        ):
+            profiler = self.beam_profiler
+            output = self._beam_active_output
+            context = nullcontext()
+            if (
+                output is not None
+                and output.total_num_scheduled_tokens > 0
+                and profiler is not None
+                and profiler.do_log
+            ):
+                context = profiler.forward_context(
+                    output, num_tokens_padded, runner.input_batch.num_reqs
+                )
+            with context:
+                return native_forward(
+                    num_tokens_padded,
+                    input_ids=input_ids,
+                    positions=positions,
+                    intermediate_tensors=intermediate_tensors,
+                    inputs_embeds=inputs_embeds,
+                    **model_kwargs,
+                )
+
+        # Instance-only closure over the original bound method. Do not populate
+        # GPUModelRunner.beam_profiler: that inherited hook uses CUDA events.
+        runner._model_forward = model_forward
+
+    @cleanup_on_beam_failure
+    def load_model(self):
+        return super().load_model()
+
+    @cleanup_on_beam_failure
+    def execute_model(self, scheduler_output):
+        # Match native ownership: previous PP sends finish BEFORE a clock change.
+        if self._pp_send_work:
+            for handle in self._pp_send_work:
+                handle.wait()
+            self._pp_send_work = []
+        total = scheduler_output.total_num_scheduled_tokens
+        requested = getattr(scheduler_output, "beam_clock_mhz", None)
+        if total > 0 and requested is not None:
+            if not self._beam_dvfs_enabled:
+                raise RuntimeError("Received BEAM NPU clock intent while DVFS is disabled")
+            observed = self._get_beam_clock_controller().set_clock(requested)
+            if self.beam_profiler is not None:
+                self.beam_profiler.log_dvfs(
+                    observed, total, getattr(scheduler_output, "expected_tbt", None),
+                    requested_clock_mhz=requested,
+                    step=getattr(scheduler_output, "beam_step", 0),
+                    phase=getattr(scheduler_output, "beam_phase", 0),
+                )
+        previous = self._beam_active_output
+        self._beam_active_output = scheduler_output if total > 0 else None
+        try:
+            # Empty invocations must still reach native request/KV maintenance.
+            return super().execute_model(scheduler_output)
+        finally:
+            self._beam_active_output = previous
+
+    @cleanup_on_beam_failure
+    def sample_tokens(self, grammar_output):
+        return super().sample_tokens(grammar_output)
+
+    @cleanup_on_beam_failure
