+@router.get("/admin/parsa/kv-projection")
+async def get_parsa_kv_projection(raw_request: Request):
+    vllm_config: VllmConfig = raw_request.app.state.vllm_config
+    parsa_config = vllm_config.parsa_config
+    if parsa_config is None or not parsa_config.enable_kv_projection:
+        raise HTTPException(status_code=HTTPStatus.NOT_FOUND.value,
+                            detail="PARSA KV projection is not enabled")
+    snapshot = await engine_client(raw_request).get_parsa_kv_projection_snapshot()
+    if snapshot is None:
+        raise HTTPException(
+            status_code=HTTPStatus.SERVICE_UNAVAILABLE.value,
+            detail="PARSA KV projection snapshot is unavailable",
+        )
+    return JSONResponse(content=snapshot)
