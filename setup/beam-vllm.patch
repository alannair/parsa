+                        "timestamp": time.time(),
+                        "devices": list(self._selected_devs),
+                        "power": {str(i): 0.0 for i in self._selected_devs},
+                    }
+                )
+            case PowerMonState.PAUSED if unpause:
+                if hasattr(self, "_pause_ts"):
+                    logger.info(
+                        "paused for %.2fms", (time.time() - self._pause_ts) * 1000
+                    )
+                self.power_mon_state = PowerMonState.RUNNING
+            case _:
+                pass
+
+    def start_power_monitor(
+        self,
+        interval_ms: float = 10.0,
+        pause_on_startup: bool = False,
+    ) -> None:
+        if self.power_mon_state != PowerMonState.STOPPED:
+            logger.warning("Power monitor is already running")
+            return
+
+        self._pause_ts = time.time()
+
+        self.power_mon_state = (
+            PowerMonState.PAUSED if pause_on_startup else PowerMonState.RUNNING
+        )
+        self._power_monitor_thread = Thread(
+            target=self._run_power_monitor,
+            args=(interval_ms,),
+            daemon=True,
+        )
+        self._power_monitor_thread.start()
+
