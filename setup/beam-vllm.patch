+    has_kv_usage = any(
+        exp.get('kv_usage', {}).get('timestamps', [])
+        for exp in experiments_data
+    )
+    has_s1_exec = any(
+        exp.get('s1_exec_time', {}).get('timestamps', [])
+        for exp in experiments_data
+    )
+    has_s2_exec = any(
