+        num_plots += 1
+    if has_s2:
+        num_plots += 1
+    
+    fig_height = 16 + (3 * (num_plots - 5))  # Base 16 inches + 3 inches per additional plot
+    fig, axes = plt.subplots(num_plots, 1, figsize=(14, fig_height), sharex=True)
