+if [ -z "$DATASET_PATH" ]; then
+    echo "Error: --dataset-path argument is required"
+    echo "Usage: $0 --dataset-path <path_to_dataset.csv>"
+    exit 1
+fi
+
+if [ ! -f "$DATASET_PATH" ]; then
