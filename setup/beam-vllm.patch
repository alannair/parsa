+
+        # Process request_rates for non-traced datasets
+        request_rates = args.request_rates
+        if request_rates is None:
+            request_rates = [args.request_rate]
+
+        request_rates = [float(x) for x in request_rates]
+        n = len(input_requests)
+
+        # Split input_requests into groups for stair-step request rates
+        total_weight = sum(request_rates)
+        # Calculate number of requests for each phase
+        base_counts = [n * w / total_weight for w in request_rates]
+        # Round and adjust to ensure sum is n
+        counts = [int(round(x)) for x in base_counts]
+        diff = n - sum(counts)
+        # Adjust the largest group(s) if rounding error
+        if diff != 0:
+            for _ in range(abs(diff)):
+                if diff > 0:
+                    idx = counts.index(min(counts))
+                    counts[idx] += 1
+                else:
+                    idx = counts.index(max(counts))
