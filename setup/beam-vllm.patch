+def compute_metrics_dataframe(traces_dict):
+    """
+    Compute all key metrics for traces and return as a pandas DataFrame.
+    
+    Args:
+        traces_dict: Dictionary mapping trace names to TraceData objects
+        
+    Returns:
+        DataFrame with metrics for all traces
+    """
+    trace_names = sorted(traces_dict.keys())
+    trace_aliases = [get_trace_alias(name) for name in trace_names]
+    
+    metrics_data = []
+    
+    for trace_name in trace_names:
+        trace_data = traces_dict[trace_name]
+        trace_alias = get_trace_alias(trace_name)
+        
+        # Prepare data
+        ttfts = np.array(trace_data.ttfts)
+        tpots = np.array(trace_data.tpots)
+        
+        # Flatten tbts
+        tbts_flat = []
+        for tbt_list in trace_data.tbts:
+            tbts_flat.extend(tbt_list)
+        tbts = np.array(tbts_flat)
+        
+        # Get SLO values
+        ttft_slo = float(trace_data.ttft_slo)
+        tbt_slo = float(trace_data.tbt_slo)
+        tpot_slo = tbt_slo
+        
+        # Calculate power
+        power_watts = trace_data.energy_consumption / trace_data.total_duration
+        
+        # Calculate percentages under SLO
+        pct_ttft_under_slo = (ttfts <= ttft_slo).sum() / len(ttfts) * 100 if len(ttfts) > 0 else 0
+        pct_tbt_under_slo = (tbts <= tbt_slo).sum() / len(tbts) * 100 if len(tbts) > 0 else 0
+        pct_tpot_under_slo = (tpots <= tpot_slo).sum() / len(tpots) * 100 if len(tpots) > 0 else 0
+        
+        # Compute metrics (convert time from seconds to milliseconds)
+        metrics = {
+            'experiment': trace_alias,
+            'trace_name': trace_name,
+            'mean_ttft_ms': (np.mean(ttfts) * 1000) if len(ttfts) > 0 else 0,
+            'p90_ttft_ms': (np.percentile(ttfts, 90) * 1000) if len(ttfts) > 0 else 0,
+            'p99_ttft_ms': (np.percentile(ttfts, 99) * 1000) if len(ttfts) > 0 else 0,
+            'mean_tbt_ms': (np.mean(tbts) * 1000) if len(tbts) > 0 else 0,
+            'p90_tbt_ms': (np.percentile(tbts, 90) * 1000) if len(tbts) > 0 else 0,
+            'p99_tbt_ms': (np.percentile(tbts, 99) * 1000) if len(tbts) > 0 else 0,
+            'mean_tpot_ms': (np.mean(tpots) * 1000) if len(tpots) > 0 else 0,
+            'p90_tpot_ms': (np.percentile(tpots, 90) * 1000) if len(tpots) > 0 else 0,
+            'p99_tpot_ms': (np.percentile(tpots, 99) * 1000) if len(tpots) > 0 else 0,
+            'pct_ttft_under_slo': pct_ttft_under_slo,
+            'pct_tbt_under_slo': pct_tbt_under_slo,
+            'pct_tpot_under_slo': pct_tpot_under_slo,
+            'total_energy_joules': trace_data.energy_consumption,
+            'total_duration_s': trace_data.total_duration,
+            'avg_power_w': power_watts,
+            'num_gpus': trace_data.num_gpus,
+            'per_gpu_power_w': power_watts / trace_data.num_gpus,
+            'num_requests': len(ttfts),
+            'ttft_slo_ms': ttft_slo * 1000,
+            'tbt_slo_ms': tbt_slo * 1000,
+            'tpot_slo_ms': tpot_slo * 1000,
+        }
+        
+        metrics_data.append(metrics)
+    
+    df = pd.DataFrame(metrics_data)
+    return df
