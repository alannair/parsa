+            print(
+                f"{tps}\t{choice.freq_mhz}\t\t\t{choice.energy_per_req_j:.1f}\t\t{choice.ttft_ms:.1f}\t\t{choice.tbt_ms:.1f}\t\t{choice.feasible}\t\t{prediction_time_ms:.2f}\t{measured_status}"
