+
+import argparse
+import importlib.util
+import logging
+import os
+import sys
+from typing import Iterable, List, Optional
+
+ASCEND_FREQ_IMPL_ENV = "ASCEND_FREQ_IMPL"
+ASCEND_RUNTIME_DIR = os.path.join(os.path.dirname(__file__), "ascend_runtime")
+DEFAULT_ASCEND_FREQ_IMPL = os.path.join(ASCEND_RUNTIME_DIR, "freq.py")
+ASCEND_FREQS = [900, 1000, 1100, 1200, 1300, 1400, 1500, 1650]
+
+logger = logging.getLogger(__name__)
+logger.setLevel(logging.INFO)
+handler = logging.StreamHandler(sys.stderr)
+handler.setFormatter(logging.Formatter("[ascend-freq] %(levelname)s: %(message)s"))
+logger.addHandler(handler)
+
+
+def _load_ascend_impl() -> Optional[object]:
+    path = os.environ.get(ASCEND_FREQ_IMPL_ENV, DEFAULT_ASCEND_FREQ_IMPL)
+    if not os.path.exists(path):
+        logger.warning("Ascend freq implementation not found at %s", path)
+        return None
+
+    spec = importlib.util.spec_from_file_location("ascend_freq_impl", path)
+    if spec is None or spec.loader is None:  # pragma: no cover - defensive
+        logger.warning("Unable to load Ascend freq implementation from %s", path)
+        return None
+
+    module = importlib.util.module_from_spec(spec)
+    try:
+        spec.loader.exec_module(module)
+        return module
+    except Exception as exc:  # pragma: no cover - best effort
+        logger.warning("Error importing Ascend freq implementation: %s", exc)
+        return None
+
+
+class AscendFrequencyManager:
+    def __init__(self) -> None:
+        self._module = _load_ascend_impl()
+        self._dsmi = getattr(self._module, "dsmi", None)
+        self._logged_devices = []
+        self._original_freqs = {}
+        if self._dsmi is not None:
+            try:
+                self._logged_devices = list(getattr(self._dsmi, "device_ids", []))
+            except Exception:
+                self._logged_devices = []
+
+        for device in self._logged_devices:
+            try:
+                rated = self._dsmi.get_aicore_rated_frequency(device)
+                self._original_freqs[device] = rated
+            except Exception:
+                self._original_freqs[device] = None
+
+    def device_name(self) -> str:
+        return 'ascend_npu'
+
+    def available_devices(self) -> List[int]:
+        return list(self._logged_devices)
+
+    def supported_frequencies(self) -> List[int]:
+        return list(ASCEND_FREQS)
+
+    def set_frequency(self, freq: int) -> bool:
+        if self._dsmi is None:
+            logger.warning("No Ascend DSMI interface available to lock frequency")
+            return False
+        if freq not in ASCEND_FREQS:
+            logger.warning("Requested frequency %s is not in the Ascend frequency set", freq)
+            return False
+
+        success = True
+        for device in self._logged_devices:
+            try:
+                self._dsmi.set_aic_freq(device, freq)
+            except Exception as exc:
+                logger.warning("Failed to set freq %s MHz on device %s (%s)", freq, device, exc)
+                success = False
+        return success
+
+    def reset_frequencies(self) -> bool:
+        if self._dsmi is None:
+            logger.info("Nothing to reset, Ascend DSMI interface missing")
+            return True
+
+        success = True
+        for device in self._logged_devices:
+            try:
+                self._dsmi.restore_aic_freq(device)
+            except Exception as exc:
+                logger.warning("Failed to reset freq on device %s (%s)", device, exc)
+                success = False
+        return success
+
+    def default_frequency(self, device: int) -> Optional[int]:
+        return self._original_freqs.get(device)
+
+
+_CONTROLLER = AscendFrequencyManager()
+
+
+def list_supported_frequencies() -> List[int]:
+    return _CONTROLLER.supported_frequencies()
+
+
+def lock_frequency(freq: int) -> bool:
+    return _CONTROLLER.set_frequency(freq)
+
+
+def reset_frequencies() -> bool:
+    return _CONTROLLER.reset_frequencies()
+
+
+def device_count() -> int:
+    return len(_CONTROLLER.available_devices())
+
+
+def devices() -> Iterable[int]:
+    return _CONTROLLER.available_devices()
+
+
+def _cli() -> None:
+    parser = argparse.ArgumentParser()
+    subparsers = parser.add_subparsers(dest="command", required=True)
+
+    subparsers.add_parser("list", help="show Ascend-supported frequencies")
+    subparsers.add_parser("devices", help="list Ascend device IDs")
+    subparsers.add_parser("count", help="print number of Ascend devices")
+
+    lock_parser = subparsers.add_parser("lock", help="lock Ascend NPUs to a frequency")
+    lock_parser.add_argument("--freq", type=int, required=True, help="frequency in MHz")
+
+    subparsers.add_parser("reset", help="restore Ascend device frequencies")
+
+    args = parser.parse_args()
+    if args.command == "list":
+        print(" ".join(str(f) for f in list_supported_frequencies()))
+    elif args.command == "devices":
+        print(" ".join(str(d) for d in devices()))
+    elif args.command == "count":
+        print(device_count())
+    elif args.command == "lock":
+        if not lock_frequency(args.freq):
+            parser.error("failed to lock Ascend NPUs to %s MHz" % args.freq)
+    elif args.command == "reset":
+        if not reset_frequencies():
+            parser.error("failed to reset Ascend NPUs")
+
+
+if __name__ == "__main__":
+    _cli()
