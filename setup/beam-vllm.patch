+    handle = pynvml.nvmlDeviceGetHandleByIndex(0)
+    try:
+        # Get the maximum memory clock to query graphics clocks
+        mem_clocks = pynvml.nvmlDeviceGetSupportedMemoryClocks(handle)
+        max_mem_clock = max(mem_clocks)
