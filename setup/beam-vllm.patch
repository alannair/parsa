+        async with semaphore:
+            return await request_func(request_func_input=request_func_input,
+                                      pbar=pbar)
+
+    benchmark_start_time = time.perf_counter()
+    tasks: list[asyncio.Task] = []
+    entry_times: list[float] = []  # Track entry time for each request
+    
+    # Track phase information for CSV output
+    phase_info_list = []  # List of (phase_rate, start_time) tuples
+    phase_rates = []  # Rates for each phase
