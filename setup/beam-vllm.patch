+        for phase_idx, (group, rate) in enumerate(zip(groups, rates)):
+            if len(group) == 0:
+                continue
+            print(f"Phase {phase_idx+1}: rate={rate}, requests={len(group)}")
+            generators.append(get_request(group, rate, burstiness))
+        gen = chain_async_generators(generators)
+
+    request_idx = 0
+    
+    async for request in gen:
+        prompt, prompt_len, output_len, mm_content = request.prompt, \
+            request.prompt_len, request.expected_output_len, \
