+            
+            print(f"    {model.split('/')[-1]} (TP={tp}, PP={pp})")
+            # print(f"      Frequencies: {len(frequencies)} values from {min(frequencies)} to {max(frequencies)} MHz")
+            # print(f"      Chunk sizes: {chunk_sizes}")
