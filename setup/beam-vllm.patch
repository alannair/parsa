+
+    def pause_monitor(self, unpause: bool = True):
+        match self.power_mon_state:
+            case PowerMonState.RUNNING:
+                self._pause_ts = time.time()
+                # yeah this is a race condition, bite me
+                self.power_mon_state = PowerMonState.PAUSED
+                # insert zero measurement for the duration of the pause
+                assert self._power_monitor_log is not None
+                self._power_monitor_log.append(
