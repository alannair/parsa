+def calc_avg_energy_used(power_log: list[dict]) -> dict:
+    """
+    Calculate average energy used per NPU from power log.
+
+    Args:
+        power_log: List of snapshots, each snapshot is a dict like:
+            {
+                "timestamp": float,
+                "devices": list[int],
+                "powers_watts": { # keys are [str(device_id) for device_id in devices] 
+                    "0": float,  # NPU 0
+                    "1": float,  # NPU 1
+                    ...
+                }
+                ...
+            }
+    Returns:
+        Dictionary mapping device IDs to their total energy usage in joules.
+    """
+    if not power_log:
+        return {}
+    
+    # Sum power over time for each NPU
+    energy_sums = {}
+    for snapshot in power_log:
+        # ignore last snapshot
+        if power_log.index(snapshot) == len(power_log) - 1:
+            continue
+
+        start_ts = snapshot.get("timestamp", 0.0)
+        next_snapshot = power_log[power_log.index(snapshot) + 1]
+        end_ts = next_snapshot.get("timestamp", 0.0)
+        time_interval = end_ts - start_ts  # in seconds
+
+        powers = snapshot.get("powers_watts", {})
+        for device_id_str, power in powers.items():
+            device_id = int(device_id_str)
+            energy_used = power * time_interval  # Energy in joules
+            energy_sums[device_id] = energy_sums.get(device_id, 0.0) + energy_used
+    
+    return energy_sums
+
