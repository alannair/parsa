ARG VLLM_BASE_IMAGE=quay.io/ascend/vllm-ascend:v0.23.0
FROM ${VLLM_BASE_IMAGE}

ARG VLLM_BASE_IMAGE
ARG VLLM_VERSION=0.23.0
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
USER root
WORKDIR /workspace

ENV HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" FTP_PROXY="" NO_PROXY="*" \
    http_proxy="" https_proxy="" all_proxy="" ftp_proxy="" no_proxy="*"

RUN apt-get update -y && \
  apt-get install -y --no-install-recommends \
  build-essential vim git curl wget jq ca-certificates python3-dev python3-pip && \
  rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --upgrade \
  pip uv

RUN python3 -m pip config set global.index-url https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple

RUN uv pip install --system --python "$(command -v python3)" \
  --index-url https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple \
  'cmake>=3.26.1' ninja 'packaging>=24.2' 'setuptools>=77.0.3,<81' \
  'setuptools-scm>=8' wheel 'jinja2>=3.1.6' pybind11 'setuptools-rust>=1.9'

RUN uv pip install --system --python "$(command -v python3)" \
  --index-url https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple \
  'fastapi>=0.115,<0.124' 'aiohttp>=3.9' 'uvicorn>=0.29' \
  'numpy>=2.0,<3.0' 'pandas>=2.0' 'scipy>=1.10' 'scikit-learn>=1.3' \
  'matplotlib>=3.7' 'seaborn>=0.13' 'tensorflow>=2.15' 'torch==2.10.0' \
  'transformers==5.5.4' 'sentencepiece>=0.1.99' 'protobuf>=3.20' \
  'datasets>=2.16' huggingface_hub 'accelerate>=0.26' 'evaluate>=0.4' \
  'tqdm>=4.65' 'tensorboard>=2.15' 'torchmetrics>=1.3' 'pyarrow==24.0.0'

RUN git config --global --add safe.directory /vllm-workspace/vllm

ARG VLLM_DIR
ARG VLLM_ASCEND_DIR
COPY ${VLLM_DIR} /vllm-workspace/vllm
RUN source /usr/local/Ascend/ascend-toolkit/set_env.sh && \
  source /usr/local/Ascend/nnal/atb/set_env.sh && \
  export LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:/usr/local/Ascend/ascend-toolkit/latest/$(uname -i)-linux/devlib" && \
  unset VLLM_USE_PRECOMPILED VLLM_PRECOMPILED_WHEEL_LOCATION VLLM_USE_PRECOMPILED_RUST && \
  SETUPTOOLS_SCM_PRETEND_VERSION="${VLLM_VERSION}" VLLM_TARGET_DEVICE=empty \
    VLLM_REQUIRE_RUST_FRONTEND=0 TORCH_DEVICE_BACKEND_AUTOLOAD=0 \
    uv pip install --system --python "$(command -v python3)" --no-build-isolation \
      --index-url https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple \
      --no-deps -e /vllm-workspace/vllm

COPY ${VLLM_ASCEND_DIR} /vllm-workspace/vllm-ascend
RUN source /usr/local/Ascend/ascend-toolkit/set_env.sh && \
  source /usr/local/Ascend/nnal/atb/set_env.sh && \
  export LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:/usr/local/Ascend/ascend-toolkit/latest/$(uname -i)-linux/devlib" && \
  SETUPTOOLS_SCM_PRETEND_VERSION="${VLLM_VERSION}" \
  uv pip install --system --python "$(command -v python3)" --no-build-isolation \
    --index-url https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple \
    --extra-index-url https://mirrors.huaweicloud.com/ascend/repos/pypi \
    -v --no-deps -e /vllm-workspace/vllm-ascend/ && python3 -m pip cache purge

CMD ["/bin/bash"]
