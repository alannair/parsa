+        def get_output(self):
+            calls.append("convert")
+            raise error
+
+    def cleanup():
+        calls.append("close_beam")
+        if cleanup_fails:
+            raise RuntimeError("secondary restore failure")
+
+    executor = object.__new__(UniProcExecutor)
+    executor.parallel_config = SimpleNamespace(custom_profiler=True)
+    executor.driver_worker = SimpleNamespace(
