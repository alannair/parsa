+class FakeNVML:
+    NVML_CLOCK_MEM = 2
+    NVML_CLOCK_SM = 1
+    NVMLError_NotSupported = NotSupported
+    NVMLError_FunctionNotFound = NotSupported
+
+    def __init__(self):
+        self.calls = []
+        self.locked = (900, 1200)
+        self.actual = 1200
+        self.energy = 1000
+        self.mig = (0, 0)
+        self.fail_set = False
+        self.fail_reset = False
+
+    def nvmlInit(self):
+        self.calls.append("init")
+
+    def nvmlShutdown(self):
+        self.calls.append("shutdown")
+
+    def nvmlDeviceGetHandleByUUID(self, uuid):
+        assert uuid == GPU_UUID
+        self.calls.append(("uuid", uuid))
+        return "assigned-device"
+
+    def nvmlDeviceGetUUID(self, handle):
+        assert handle == "assigned-device"
+        return GPU_UUID.encode()
+
+    def nvmlDeviceGetMigMode(self, handle):
+        return self.mig
+
+    def nvmlDeviceGetGpuLockedClocks(self, handle):
+        return self.locked
+
+    def nvmlDeviceGetClockInfo(self, handle, domain):
+        return 5000 if domain == self.NVML_CLOCK_MEM else self.actual
+
+    def nvmlDeviceGetSupportedMemoryClocks(self, handle):
+        self.calls.append("validate-memory")
+        return [5000, 6000]
+
+    def nvmlDeviceGetSupportedGraphicsClocks(self, handle, memory):
+        self.calls.append("validate-sm")
+        assert memory == 5000  # Catch validation in the wrong memory domain.
+        return [900, 1200, 1500]
+
+    def nvmlDeviceSetGpuLockedClocks(self, handle, minimum, maximum):
+        self.calls.append(("set", minimum, maximum))
+        if self.fail_set:
+            raise PermissionError("clock privilege denied")
+        self.locked = (minimum, maximum)
+        self.actual = minimum
+
+    def nvmlDeviceResetGpuLockedClocks(self, handle):
+        self.calls.append("reset")
+        if self.fail_reset:
+            raise PermissionError("restore privilege denied")
+        self.locked = None
+
+    def nvmlDeviceGetTotalEnergyConsumption(self, handle):
+        return self.energy
+
