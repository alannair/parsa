+"""Worker-local adaptation of BEAM's GPU clock actuation.
+
+Original logic: BEAM-artifact, commit 0febb08e7446c9826bff5fce93e0e8a2deab5e5f,
+vllm/v1/core/sched/scheduler.py (apply_dvfs/lock_gpu_clock/reset_gpu_clock),
+SPDX-License-Identifier: Apache-2.0, copyright contributors to the vLLM project.
+This port uses synchronous, UUID-bound control with no module-level NVML work.
+"""
+
+import logging
+from functools import wraps
+from uuid import UUID
+
+logger = logging.getLogger(__name__)
+
+
+def beam_runtime_enabled(parallel_config) -> bool:
+    """Whether this process can own BEAM clocks or custom profiling resources."""
+    return any(
+        getattr(parallel_config, flag, False)
+        for flag in (
+            "custom_profiler",
+            "use_s1",
+            "use_s2",
+            "use_window_based_dvfs_only",
+        )
+    )
+
+
+class GPUClockController:
+    """Own one NVML session and the GPU locks changed by one worker.
+
+    Application and memory clocks are never changed. If a backend exposes
+    nvmlDeviceGetGpuLockedClocks, restore that interval. Standard NVML does not
+    expose that getter: in that case reset GPU locks to defaults, explicitly
+    warning that a pre-existing, unobservable GPU lock cannot be reconstructed.
+    Exclusive clock ownership of this physical GPU is required.
+
+    Args:
+        device_uuid: Assigned CUDA device UUID, with or without the GPU- prefix.
+        nvml: Optional injected NVML backend. No NVML calls occur in __init__.
+    """
+
+    def __init__(self, device_uuid: str, nvml=None):
+        if isinstance(device_uuid, bytes):
+            device_uuid = device_uuid.decode("ascii")
+        if str(device_uuid).upper().startswith("MIG-"):
+            raise RuntimeError("BEAM DVFS/profiling does not support MIG devices")
+        try:
+            self.device_uuid = "GPU-" + str(UUID(str(device_uuid).removeprefix("GPU-")))
+        except (ValueError, TypeError, AttributeError) as error:
+            raise RuntimeError(f"Invalid assigned GPU UUID: {device_uuid!r}") from error
+        self._nvml = nvml
+        self._active = False
+        self._initialized = False
+        self._handle = None
+        self._dirty = False
+        self._snapshot_taken = False
+        self._previous_locks = None
+        self._last_energy_mj = None
+        self._applied_clock_mhz: int | None = None
+        self.current_clock_mhz: int | None = None
+
+    def _invalidate_clock_cache(self) -> None:
+        self._applied_clock_mhz = None
+        self.current_clock_mhz = None
+
+    def _call(self, name, *args):
+        try:
+            return getattr(self._nvml, name)(*args)
+        except Exception as error:
+            self._invalidate_clock_cache()
+            raise RuntimeError(
+                f"BEAM NVML {name} failed on {self.device_uuid}: {error}"
+            ) from error
+
+    def _optional(self, name, *args):
+        """Only missing/unsupported discovery is optional, never permission errors."""
+        function = getattr(self._nvml, name, None)
+        if function is None:
+            return None
+        try:
+            return function(*args)
+        except Exception as error:
+            unsupported = tuple(
+                error_type
+                for error_type in (
+                    getattr(self._nvml, "NVMLError_NotSupported", None),
+                    getattr(self._nvml, "NVMLError_FunctionNotFound", None),
+                )
+                if isinstance(error_type, type)
+            )
+            if isinstance(error, unsupported):
+                logger.warning("BEAM %s unavailable: %s", name, error)
+                return None
+            self._invalidate_clock_cache()
+            raise RuntimeError(
+                f"BEAM NVML {name} failed on {self.device_uuid}: {error}"
+            ) from error
+
+    def initialize(self) -> None:
+        """Initialize lazily, verifying the exact assigned physical device."""
+        if self._initialized:
+            return
+        try:
+            if self._nvml is None:
+                from vllm.utils.import_utils import import_pynvml
+
+                self._nvml = import_pynvml()
+            if not self._active:
+                self._call("nvmlInit")
+                self._active = True
+            self._handle = self._call("nvmlDeviceGetHandleByUUID", self.device_uuid)
+            actual_uuid = self._call("nvmlDeviceGetUUID", self._handle)
+            if isinstance(actual_uuid, bytes):
+                actual_uuid = actual_uuid.decode("ascii")
+            if str(actual_uuid).lower() != self.device_uuid.lower():
+                raise RuntimeError("NVML returned a different GPU than the assigned UUID")
+            mig_mode = self._optional("nvmlDeviceGetMigMode", self._handle)
+            if mig_mode is not None and any(mig_mode):
+                raise RuntimeError("BEAM DVFS/profiling does not support MIG-enabled GPUs")
+            self._initialized = True
+        except Exception as error:
+            try:
+                self.close()
+            except Exception:
+                logger.exception("BEAM NVML initialization cleanup also failed")
+            if isinstance(error, RuntimeError):
+                raise
+            raise RuntimeError(f"Cannot initialize BEAM NVML: {error}") from error
+
+    def get_clock_mhz(self) -> int:
+        """Return observed SM MHz, which can differ from a successful lock request."""
+        self.initialize()
+        clock = int(
+            self._call("nvmlDeviceGetClockInfo", self._handle, self._nvml.NVML_CLOCK_SM)
+        )
+        if clock <= 0:
+            self._invalidate_clock_cache()
+            raise RuntimeError(f"NVML returned an invalid SM clock: {clock}")
+        return clock
+
+    def set_clock(self, clock_mhz: int | None) -> int | None:
+        """Validate in the memory domain, lock synchronously, then read actual MHz.
+
+        None is no actuation, including no initialization or reset. Setter or
+        readback errors invalidate the applied-intent cache. Repeated successful
+        intents only read observed MHz, without revalidating or setting locks.
+        A lock is not a promise of effective frequency (idle/power/throttling).
+        """
+        if clock_mhz is None:
+            return None
+        try:
+            if type(clock_mhz) is not int or clock_mhz <= 0:
+                raise RuntimeError("BEAM SM clock must be a positive integer MHz")
+            self.initialize()
+            if clock_mhz == self._applied_clock_mhz:
+                observed = self.get_clock_mhz()
+                self.current_clock_mhz = observed
+                return observed
+            self._invalidate_clock_cache()
+            memory_clock = self._optional(
+                "nvmlDeviceGetApplicationsClock",
+                self._handle,
+                self._nvml.NVML_CLOCK_MEM,
+            )
+            if memory_clock is None:
+                memory_clock = self._call(
+                    "nvmlDeviceGetClockInfo", self._handle, self._nvml.NVML_CLOCK_MEM
+                )
+            memory_clocks = self._call(
+                "nvmlDeviceGetSupportedMemoryClocks", self._handle
+            )
+            if memory_clock not in memory_clocks:
+                raise RuntimeError(
+                    f"GPU memory clock {memory_clock} MHz is not supported"
+                )
+            supported = self._call(
+                "nvmlDeviceGetSupportedGraphicsClocks", self._handle, memory_clock
+            )
+            if clock_mhz not in supported:
+                raise RuntimeError(
+                    f"SM clock {clock_mhz} MHz is not supported on {self.device_uuid} "
+                    f"at memory clock {memory_clock} MHz; supported: {sorted(supported)}"
+                )
+            if not self._snapshot_taken:
+                previous = self._optional("nvmlDeviceGetGpuLockedClocks", self._handle)
+                self._previous_locks = tuple(previous) if previous is not None else None
+                if self._previous_locks is not None and (
+                    len(self._previous_locks) != 2
+                    or any(type(clock) is not int for clock in self._previous_locks)
+                    or not 0 < self._previous_locks[0] <= self._previous_locks[1]
+                ):
+                    raise RuntimeError(
+                        "NVML returned an invalid previous GPU-lock interval"
+                    )
+                if self._previous_locks is None:
+                    logger.warning(
+                        "BEAM %s: prior GPU locks are not discoverable; restoration is "
+                        "reset-to-default GPU locks. Application/memory clocks are "
+                        "untouched.",
+                        self.device_uuid,
+                    )
+                self._snapshot_taken = True
+            # Even a failing setter might have partially changed hardware state.
+            self._dirty = True
+            self._call(
+                "nvmlDeviceSetGpuLockedClocks", self._handle, clock_mhz, clock_mhz
+            )
+            locks = self._optional("nvmlDeviceGetGpuLockedClocks", self._handle)
+            if locks is not None and tuple(locks) != (clock_mhz, clock_mhz):
+                raise RuntimeError(
+                    f"GPU lock readback differs from requested {clock_mhz} MHz"
+                )
+            observed = self.get_clock_mhz()
+            self._applied_clock_mhz = clock_mhz
+            self.current_clock_mhz = observed
+            return observed
+        except Exception:
+            self._invalidate_clock_cache()
+            raise
+
+    def get_total_energy_mj(self) -> int:
+        """Read the monotonic device cumulative mJ counter, not forward energy."""
+        self.initialize()
+        energy = int(self._call("nvmlDeviceGetTotalEnergyConsumption", self._handle))
+        if energy < 0 or (
+            self._last_energy_mj is not None and energy < self._last_energy_mj
+        ):
+            self._invalidate_clock_cache()
+            raise RuntimeError("GPU cumulative energy counter decreased or became invalid")
+        self._last_energy_mj = energy
+        return energy
+
+    def reset(self) -> None:
+        """Restore this worker's clock changes; do nothing for energy-only sessions."""
+        self._invalidate_clock_cache()
+        if not self._dirty:
+            return
+        if self._previous_locks is None:
+            self._call("nvmlDeviceResetGpuLockedClocks", self._handle)
+        else:
+            self._call(
+                "nvmlDeviceSetGpuLockedClocks", self._handle, *self._previous_locks
+            )
+            restored = self._optional("nvmlDeviceGetGpuLockedClocks", self._handle)
+            if restored is not None and tuple(restored) != self._previous_locks:
+                raise RuntimeError("NVML GPU-lock restoration readback failed")
+        self._dirty = False
+        self._snapshot_taken = False
+
+    def close(self) -> None:
+        """Restore then release NVML. Failures propagate and leave cleanup retryable."""
+        self.reset()
+        if self._active:
+            self._call("nvmlShutdown")
+            self._active = False
+        self._initialized = False
+        self._handle = None
+
+
+def cleanup_on_beam_failure(method):
+    """Preserve execution errors; report secondary cleanup errors with tracebacks."""
+
+    @wraps(method)
+    def wrapped(self, *args, **kwargs):
+        try:
+            return method(self, *args, **kwargs)
+        except BaseException:
+            try:
+                self.close_beam()
+            except Exception:
+                logger.exception("BEAM cleanup failed while preserving the original error")
+            raise
+
+    return wrapped
+
+
+def close_beam_on_shutdown(method):
+    """Flush before CUDA teardown, always run upstream shutdown, propagate errors."""
+
+    @wraps(method)
+    def wrapped(self, *args, **kwargs):
+        cleanup_error = None
+        try:
+            self.close_beam()
+        except Exception as error:
+            cleanup_error = error
+            logger.exception("BEAM shutdown cleanup failed; continuing upstream cleanup")
+        result = method(self, *args, **kwargs)
+        if cleanup_error is not None:
+            raise cleanup_error
+        return result
+
+    return wrapped
