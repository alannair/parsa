+@pytest.mark.parametrize('v2,asynchronous', [(False, False), (True, False), (True, True)])
+def test_gpu_s2_manual_m_drain_refill(gpu_engine, policy_profile, v2, asynchronous):
+    start, _, pp, token = gpu_engine
+    with start(v2, asynchronous, use_s2=True, **policy_profile) as llm:
+        golden = _generate(llm, token)
+        for m in (1, pp, 1):  # PP1 is the degenerate case; PP2/4 must remap.
+            ack = llm.update_microbatch_size(m)
+            assert ack['microbatch_size']['requested'] == m
+            assert _generate(llm, token) == golden
+            status = _settled_status(llm)
+            control = status['microbatch_size']
+            assert status['physical_pp'] == pp and status['flush_remaining'] == 0
+            assert control['requested'] == control['effective'] == m
+            assert control['manual'] and not control['pending']
+            assert not control['prefill_superseded']
+        llm.update_microbatch_size(clear=True)
+        assert _generate(llm, token) == golden
+        control = _settled_status(llm)['microbatch_size']
+        assert control['requested'] is None and not control['manual']
+        assert control['effective'] == pp and not control['pending']
+
