+class _PoolLock:
+    def __init__(self, state):
+        self.depth = 0
+        self.state = state
+
+    def __enter__(self):
+        self.depth += 1
+        return self
+
+    def __exit__(self, *args):
+        # A raw pool view may not outlive the lock while DMA still uses it.
+        assert not self.state.get("raw_copy_pending", False)
+        self.depth -= 1
+
+
+class _InterleavedReceiveCondition:
+    """Run a competing cleanup as soon as the real reader releases its CV."""
+
+    def __init__(self):
+        self.depth = 0
+        self.deferred = []
+
+    def __enter__(self):
+        self.depth += 1
+        return self
+
+    def __exit__(self, *args):
+        self.depth -= 1
+        if self.depth == 0 and self.deferred:
+            cleanup = self.deferred.pop()
+            cleanup()
+
+    def _is_owned(self):
+        return self.depth > 0
+
+    def cleanup_when_unlocked(self, cleanup):
+        if self.depth:
+            self.deferred.append(cleanup)
+        else:
+            cleanup()
+
+    def notify(self):
+        assert self._is_owned()
+
+    def notify_all(self):
+        assert self._is_owned()
+
+    def wait(self):
+        raise AssertionError("The fake PUT already published its tensor")
+
