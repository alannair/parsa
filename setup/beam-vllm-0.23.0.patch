+def test_request_timing_is_per_nonempty_accepted_frame(monkeypatch):
+    from vllm.sampling_params import SamplingParams
+    from vllm.v1.request import Request
+
+    request = Request("r", [1], SamplingParams(), None, arrival_time=0)
+    ticks = iter([10.0, 10.4, 10.9])
+    monkeypatch.setattr(
+        "vllm.v1.request.time", SimpleNamespace(monotonic=lambda: next(ticks))
+    )
+    request.record_output_token_batch()  # Empty prefill/flush: no clock read.
+    request.append_output_token_ids([])
+    request.record_output_token_batch()
+    request.append_output_token_ids(2)
+    request.record_output_token_batch()
+    request.num_output_placeholders = 3
+    request.record_output_token_batch()  # Async placeholders are not real tokens.
+    for token in [3, 4, 5]:
+        request.append_output_token_ids(token)
+    request.record_output_token_batch()  # One speculative batch, one interval.
+    request.record_output_token_batch()  # Duplicate call cannot manufacture timing.
+    request.append_output_token_ids([6, 7])
+    request.record_output_token_batch()
+    assert request._output_token_tbts == pytest.approx([0.4, 0.5])
+    assert request._estimated_ttft is None
+    assert request._output_token_estimated_tbts == []
+
