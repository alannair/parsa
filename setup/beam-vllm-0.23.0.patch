+"""Owned-request profile trials; authored without execution or collection."""
+
+from collections import deque
+from concurrent.futures import Future
+
+import pytest
+
+pytestmark = pytest.mark.cpu_test
+
+
+def ready(value):
+    result = Future()
+    result.set_result(value)
+    return result
