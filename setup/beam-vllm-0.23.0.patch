+
+def positive(value, name):
+    if isinstance(value, bool):
+        raise ValueError(f"{name} must be positive and finite")
+    value = float(value)
+    if not math.isfinite(value) or value <= 0:
+        raise ValueError(f"{name} must be positive and finite")
+    return value
+
+
+def positive_integer(value, name="value"):
+    number = positive(value, name)
+    if not number.is_integer():
+        raise ValueError(f"{name} must be a positive integer")
+    return int(number)
+
+
+def rank_device_map(mapping, count):
+    expected = {str(rank) for rank in range(count)}
+    if not isinstance(mapping, dict) or set(mapping) != expected:
+        raise ValueError("rank_devices must cover all ranks with unique physical UUIDs")
+    normalized = {}
+    for rank, device in mapping.items():
+        if not isinstance(device, str) or not device.upper().startswith("GPU-"):
+            raise ValueError("rank_devices requires physical GPU- UUIDs, not MIG/indexes")
+        normalized[rank] = "GPU-" + str(UUID(device[4:]))
+    if len(set(normalized.values())) != count:
+        raise ValueError("rank_devices must contain unique physical UUIDs")
+    return normalized
+
+
+def artifact_path(root, relative):
+    root = Path(root).resolve(strict=True)
+    path = (root / relative).resolve()
+    if not path.is_relative_to(root):
+        raise ValueError("path escapes --artifact-root")
+    if not path.is_file():
+        raise ValueError(f"missing artifact file: {relative}")
+    return path
+
+
+def git_value(root, *args):
+    return subprocess.check_output(
+        ["git", "-C", str(root), *args], text=True,
+        env={**os.environ, "GIT_NO_LAZY_FETCH": "1"},
+    ).rstrip("\n")
+
+
+def git_ancestor(root, ancestor, descendant):
+    result = subprocess.run(
+        ["git", "-C", str(root), "merge-base", "--is-ancestor", ancestor, descendant],
+        capture_output=True, text=True,
+        env={**os.environ, "GIT_NO_LAZY_FETCH": "1"},
+    )
+    if result.returncode not in (0, 1):
+        raise RuntimeError("cannot inspect target ancestry")
+    return result.returncode == 0
+
+
+def check_target(artifact_root):
+    """Future runtime gate: pin both trees and the package imported by this Python."""
+    if git_value(ROOT, "rev-parse", "v0.23.0^{commit}") != TARGET:
+        raise ValueError("target tag v0.23.0 must resolve to the exact upstream base")
+    if not git_ancestor(ROOT, TARGET, "HEAD"):
+        raise ValueError("port HEAD must descend from the exact v0.23.0 base")
+    port_commit = git_value(ROOT, "rev-parse", "HEAD")
+    if git_value(ROOT, "branch", "--show-current") != "beam-port-v0.23":
+        raise ValueError("target branch must be beam-port-v0.23")
+    if git_value(artifact_root, "rev-parse", "HEAD") != ARTIFACT:
+        raise ValueError("--artifact-root must be the pinned separate BEAM checkout")
+    version = importlib.metadata.version("vllm")
+    if version.split("+", 1)[0] != "0.23.0":
+        raise ValueError(f"expected vllm 0.23.0, found {version}")
+    import vllm
+
+    if Path(vllm.__file__).resolve().parent != ROOT / "vllm":
+        raise ValueError("this interpreter must import vllm from the port checkout")
+    warnings.warn(CALIBRATION, stacklevel=2)
+    status = git_value(ROOT, "status", "--porcelain=v1", "--untracked-files=all")
+    return {"target": TARGET, "port_commit": port_commit,
+            "dirty": bool(status), "dirty_paths": status.splitlines(),
+            "artifact": ARTIFACT, "version": version,
+            "python": sys.executable, "calibration": CALIBRATION}
+
+
+def input_reference(path):
+    path = Path(path).resolve(strict=True)
+    digest = hashlib.sha256()
+    with path.open("rb") as source:
+        for block in iter(lambda: source.read(1024 * 1024), b""):
+            digest.update(block)
+    return {"path": str(path), "sha256": digest.hexdigest()}
+
+
+def source_stamp():
+    """Conservative resume identity, including staged/unstaged and new port code."""
+    digest = hashlib.sha256(git_value(ROOT, "rev-parse", "HEAD").encode())
+    digest.update(git_value(ROOT, "diff", "--no-ext-diff", "--no-textconv", "HEAD",
+                            "--", "vllm", "benchmarks/energy").encode())
+    names = git_value(ROOT, "ls-files", "--others", "--exclude-standard", "--",
+                      "vllm", "benchmarks/energy").splitlines()
+    for name in sorted(names):
+        if name.endswith(".py"):
+            digest.update(name.encode())
+            digest.update(input_reference(ROOT / name)["sha256"].encode())
+    return digest.hexdigest()
+
+
+def artifact_stamp(root):
+    """Fingerprint the pinned artifact and its visible working-tree contents."""
+    digest = hashlib.sha256(git_value(root, "rev-parse", "HEAD").encode())
+    digest.update(git_value(root, "diff", "--no-ext-diff", "--no-textconv",
+                            "--binary", "HEAD").encode())
+    for name in sorted(git_value(root, "ls-files", "--others", "--exclude-standard", "-z").split("\0")):
+        if name:
+            digest.update(name.encode())
+            digest.update(input_reference(Path(root) / name)["sha256"].encode())
+    return digest.hexdigest()
