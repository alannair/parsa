+        for rid in output.beam_sampling_req_ids:
+            assert seen.setdefault(rid, output.beam_phase) == output.beam_phase
+        # No second sampling invocation while the first is unretired.
+        if output.beam_sampling_req_ids:
+            following = scheduler.schedule()
+            assert set(output.beam_sampling_req_ids).isdisjoint(
+                following.num_scheduled_tokens
+            )
+            for rid in following.beam_sampling_req_ids:
+                assert (
+                    seen.setdefault(rid, following.beam_phase) == following.beam_phase
+                )
+            retire(scheduler, following)
+        retire(scheduler, output)
+        if len(seen) == len(requests):
+            break
+    assert len(seen) == 2 * pp
+    assert sorted(beam.cohort_sizes()) == [2] * pp
+    # Removing an earlier running entry cannot shift the remaining owners.
+    scheduler.finish_requests(requests[0].request_id, RequestStatus.FINISHED_ABORTED)
+    for _ in range(pp):
+        output = scheduler.schedule()
+        for rid, owner in output.beam_request_phases:
+            assert owner == seen[rid]
+            assert output.beam_phase == owner
+        retire(scheduler, output)
+
