+def _manual_control_frontend(monkeypatch, *, dp=False, enabled=True, s2=True):
+    from tests.v1.core.test_beam_scheduler import enable_beam
+    from tests.v1.core.utils import create_scheduler
+    from tests.v1.engine.test_beam_pipeline import core_for
+    from vllm.v1.engine import UtilityOutput, UtilityResult
+    from vllm.v1.engine.async_llm import AsyncLLM
+    from vllm.v1.engine.core_client import (
+        AsyncMPClient, DPLBAsyncMPClient, _process_utility_output,
+    )
+
+    cores = {}
+    for rank in range(2 if dp else 1):
+        scheduler = create_scheduler(
+            pipeline_parallel_size=2, max_num_batched_tokens=512,
+        )
+        if enabled:
+            enable_beam(scheduler, monkeypatch, custom_profiler=True, use_s2=s2)
+        scheduler.parallel_config.data_parallel_rank = rank
+        cores[f"rank{rank}"] = core_for(scheduler)
+
+    async def transport(self, method, *args, engine):
+        future = Future()
+        try:
+            result = getattr(cores[engine], method)(*args)
+            reply = UtilityOutput(call_id=7, result=UtilityResult(result))
+        except ValueError as exc:
+            reply = UtilityOutput(
+                call_id=7, failure_message=f"Call to {method} method failed: {exc}"
+            )
+        _process_utility_output(reply, {7: future})
+        return future.result()
+
+    client = SimpleNamespace(
+        vllm_config=cores["rank0"].vllm_config,
+        core_engine="rank0", core_engines=list(cores),
+    )
+    client._call_utility_async = MethodType(transport, client)
+    client.call_utility_async = MethodType(
+        DPLBAsyncMPClient.call_utility_async if dp else AsyncMPClient.call_utility_async,
+        client,
+    )
+    frontend = SimpleNamespace(engine_core=client)
+    for method in ("update_chunk_size", "update_microbatch_size", "get_beam_status"):
+        setattr(client, method + "_async", MethodType(
+            getattr(AsyncMPClient, method + "_async"), client,
+        ))
+        setattr(frontend, method, MethodType(getattr(AsyncLLM, method), frontend))
+    return frontend, cores
+
