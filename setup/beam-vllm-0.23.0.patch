+def dynamo_sweep(args):
+    """Explicit clock/layout/TPS/length sweep with worker-local monitoring and merge."""
+    positive(args.duration, "duration")
+    positive(args.power_seconds, "power_seconds")
+    args.clocks = [positive_integer(value, "clock") for value in args.clocks]
+    args.tps = [positive_integer(value, "tps") for value in args.tps]
+    if any(value < 1 for value in args.input_lens + args.output_lens + args.clocks):
+        raise ValueError("sweep lengths/clocks must be positive")
+    for values in (args.layouts, args.clocks, args.tps, args.input_lens, args.output_lens):
+        if not values or len(set(values)) != len(values):
+            raise ValueError("sweep dimensions must be nonempty and unique")
+    device_maps = json.loads(Path(args.devices).read_text())
+    root = Path(args.output).resolve()
+    root.mkdir(parents=True, exist_ok=False)
+    row_paths = []
+    for layout in args.layouts:
+        tp, pp = map(int, layout.split(":"))
+        tp, pp = positive_integer(tp, "tp"), positive_integer(pp, "pp")
+        specified = device_maps if "0" in device_maps and len(args.layouts) == 1 else device_maps[layout]
+        mapping = rank_device_map(specified, tp * pp)
+        for clock in args.clocks:
+            for tps in args.tps:
+                for input_len in args.input_lens:
+                    for output_len in args.output_lens:
+                        # Preserve the historical nominal TPS / maximum input-length rule.
+                        rate = math.floor(positive(tps, "tps") * 100 / input_len) / 100
+                        if rate <= 0:
+                            raise ValueError("nominal TPS rounds to zero request rate")
+                        name = (f"tp{tp}_pp{pp}_f{clock}_tps{tps:g}"
+                                f"_in{input_len}_out{output_len}")
+                        case = parser().parse_args([
+                            "run", "--artifact-root", args.artifact_root,
+                            "--vllm-bin", args.vllm_bin, "--model", args.model,
+                            "--output", str(root / name), "--mode", "B",
+                            "--tp", str(tp), "--pp", str(pp), "--clock", str(clock),
+                            "--device-uuids", *[mapping[str(i)] for i in range(tp * pp)],
+                            "--rates", str(rate), "--num-prompts",
+                            str(max(5, math.floor(args.duration * rate))),
+                            "--input-len", str(input_len), "--output-len", str(output_len),
+                            "--range-ratio", str(args.range_ratio),
+                            "--monitor-seconds", str(args.power_seconds),
+                            "--port", str(args.port), "--seed", str(args.seed),
+                        ])
+                        directory = run_case(case)
+                        data = json.loads((directory / "result.json").read_text())
+                        evaluation = json.loads((directory / "evaluation.json").read_text())
+                        row = dynamo_row(data, evaluation["profile"], clock=clock, tp=tp,
+                                         pp=pp, tps=tps, time_limit=args.duration,
+                                         power_seconds=args.power_seconds,
+                                         power_mode=args.power_mode)
+                        path = directory / "dynamo-row.csv"
+                        write_dynamo(path, [row])
+                        row_paths.append(path)
+    merge_dynamo(row_paths, root / "dynamo-profile.csv", duplicates=args.duplicates)
+    write_json(root / "sweep.json", {"configuration": vars(args),
+               "cases": [str(path.parent) for path in row_paths],
+               "power_mode": args.power_mode, "power_seconds": args.power_seconds,
+               "nominal_tps_note": "tps / maximum input length; variable actual lengths retained"})
+
