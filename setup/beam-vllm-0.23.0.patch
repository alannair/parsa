+def resolved(value):
+    future = Future()
+    future.set_result(value)
+    return future
+
+
+class CPUExecutor:
+    def __init__(self):
+        self.executed = []
+        self.sampled = []
+
+    def execute_model(self, output, non_block=True):
+        assert non_block
+        self.executed.append(output)
+        self.latest = output
+        return resolved(
+            runner_output(output) if not output.total_num_scheduled_tokens else None
+        )
+
+    def sample_tokens(self, grammar_output, non_block=False):
+        self.sampled.append(self.latest)
+        result = runner_output(self.latest)
+        return resolved(result) if non_block else result
+
