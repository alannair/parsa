+def test_public_aggregation_keeps_choice_metadata_independent():
+    from vllm.outputs import CompletionOutput, RequestOutput
+
+    def output(index, estimates):
+        return CompletionOutput(
+            index=index, text="", token_ids=[10], cumulative_logprob=None,
+            logprobs=None, estimated_ttft=1.0 + index, estimated_tbts=estimates,
+        )
+
+    first = RequestOutput("r", "prompt", [1], None,
+                          [output(0, []), output(1, [0.1])], False)
+    following = RequestOutput("r", "prompt", [1], None,
+                              [output(1, [0.1, 0.2])], False)
+    first.add(following, aggregate=True)
+    assert first.outputs[0].estimated_ttft == 1.0
+    assert first.outputs[0].estimated_tbts == []
+    assert first.outputs[1].estimated_ttft == 2.0
+    assert first.outputs[1].estimated_tbts == [0.1, 0.2]
+    following.outputs[0].estimated_tbts.append(99.0)
+    assert first.outputs[1].estimated_tbts == [0.1, 0.2]
