+    with patch.object(backend, "get_beam_status", side_effect=[
+        envelope, {"status": "applied", "engines": [applied, applied]},
+    ]), patch.object(backend.time, "sleep"):
+        result = backend.wait_for_beam_control("http://localhost:8000", "microbatch_size", 2,
+                                               timeout=1, initial_status=pending)
+    assert result["status"] == "applied"
+    with patch.object(backend.time, "monotonic", side_effect=[0, 2]):
+        with pytest.raises(TimeoutError, match="microbatch_size"):
+            backend.wait_for_beam_control("http://localhost:8000", "microbatch_size", 2,
+                                           timeout=1, initial_status=pending)
+
