+def test_pool_store_load_and_free_share_lock_through_raw_copy_completion(monkeypatch):
+    import torch
+
+    local = _metadata([2, 4], [6], 1, tp_rank=1, producer=False)
+    peer = _metadata([6], [2, 4], 0, tp_rank=1)
+    engine = _engine(local)
+    engine.device = torch.device("cuda:3")
+    engine._beam_peers["p:10001"] = peer
+    engine.buffer_size_threshold = 0
+    engine.recv_store_cv = _InterleavedReceiveCondition()
+    state, events, responses = {}, [], []
+    lock = engine._beam_pool_lock = _PoolLock(state)
+
+    class Tensor:
+        shape = (1, 2, 16, 2, 64)
+        dtype = torch.float16
+        is_cuda = True
+        device = engine.device
+
+        def data_ptr(self):
+            return 0  # Only the fake NCCL boundary receives this pointer.
+
+        def numel(self):
+            return 4096
+
+        def element_size(self):
+            return 2
+
+    tensor = Tensor()
+    loaded = Tensor()
+
+    def store(value, *, on_reserve=None):
+        assert value is tensor and lock.depth == 1
+        assert on_reserve is not None
+        on_reserve(123)
+        state["raw_copy_pending"] = True
+        events.append("store raw view/copy")
+        return 123
+
+    def load(address, dtype, shape, device):
+        assert lock.depth == 1 and engine.recv_store_cv._is_owned()
+        assert address == 123 and device == engine.device
+        state["raw_copy_pending"] = True
+        events.append("load raw view/copy")
+        events.append("cleanup requested during raw read")
+        engine.recv_store_cv.cleanup_when_unlocked(
+            lambda: engine.get_finished({"r"}, {name: object()})
+        )
+        return loaded
+
+    def copy_complete():
+        assert lock.depth == 1
+        assert state["raw_copy_pending"]
+        state["raw_copy_pending"] = False
+        events.append("pool copy complete")
+
+    def free(address):
+        assert address == 123 and lock.depth == 1
+        assert not state["raw_copy_pending"]
+        events.append("free/reuse allocation")
+
+    def current_stream(device):
+        assert device == engine.device
+        return SimpleNamespace(synchronize=copy_complete)
+
+    engine.pool = SimpleNamespace(store_tensor=store, load_tensor=load, free=free)
+    name = "model.layers.4.self_attn.attn"
+    tensor_id = "r#" + name
+    _put_listener(engine, [{
+        "cmd": "PUT", "tensor_id": tensor_id, "shape": list(tensor.shape),
+        "dtype": "float16",
+    }], responses, monkeypatch, events)
+    monkeypatch.setattr(torch, "empty", lambda *args, **kwargs: tensor)
+    monkeypatch.setattr(torch.cuda, "current_stream", current_stream)
+    with pytest.raises(StopIteration):
+        engine.listen_for_requests()
+    assert responses == [[b"p:10001", b"0"]]
+    assert engine.recv_tensor(tensor_id) is loaded
+    assert engine.buffer_size == 0  # A spilled tensor was never resident-accounted.
+    assert events == [
+        ("ack", b"0"), "NCCL receive", "NCCL receive complete",
+        "store raw view/copy", "pool copy complete",
+        "load raw view/copy", "cleanup requested during raw read",
+        "pool copy complete", "free/reuse allocation",
+    ]
+    assert lock.depth == 0 and engine.recv_store == {}
+
