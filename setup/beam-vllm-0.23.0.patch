+def profile_grids(path, *, topology=None):
+    rows = csv_rows(path)
+    if topology is not None:
+        if rows and not {"tp", "pp"} <= set(rows[0]):
+            raise ValueError("topology selection applies to Dynamo profiles with TP/PP columns")
+        tp, pp = topology
+        rows = [row for row in rows if (int(row["tp"]), int(row["pp"])) == (tp, pp)]
+    if not rows:
+        raise ValueError("empty profile heatmap input")
+    if "batch_size" in rows[0]:
+        x = "batch_size"
+        metrics = {"latency_ms": ("time_taken", 1000),
+                   "energy_j": ("energy_consumption", .001)}
+    elif "tps" in rows[0]:
+        x = "tps"
+        # TP/PP MUST be selected first: these are distinct calibration domains.
+        if len({(row["tp"], row["pp"]) for row in rows}) != 1:
+            raise ValueError("select one TP/PP topology before creating a Dynamo heatmap")
+        metrics = {"power_w": ("gpu_power", 1),
+                   "ttft_mean_ms": ("ttft_mean", 1), "tbt_mean_ms": ("tbt_mean", 1)}
+    else:
+        raise ValueError("heatmap needs system or Dynamo profile schema")
+    grids = {}
+    for name, (column, scale) in metrics.items():
+        cells = {}
+        for row in rows:
+            if row.get("valid", "1") not in ("1", "1.0"):
+                continue
+            key = (number(row["clock"]), number(row[x]))
+            cells[key] = max(cells.get(key, 0), number(row[column]) * scale)
+        grids[name] = {"x": x, "y": "clock_mhz", "cells": cells,
+                       "aggregation": "maximum across contexts/duplicate observations"}
+    return grids
+
+
+def heatmap_svg(grid, path, title):
+    cells = grid["cells"]
+    if not cells:
+        raise ValueError("no measured heatmap cells")
+    xs = sorted({x for _, x in cells})
+    ys = sorted({y for y, _ in cells})
+    maximum = max(cells.values()) or 1
+    body = [f'<text x="15" y="25">{escape(title)}; '
+            f'{escape(grid["x"])} columns, SM MHz rows; gray = unmeasured</text>']
+    for j, y in enumerate(ys):
+        body.append(f'<text x="10" y="{80 + j * 50}">{y:g}</text>')
+        for i, x in enumerate(xs):
+            value = cells.get((y, x))
+            shade = "#ddd" if value is None else f"rgb(80,{int(240 - value / maximum * 170)},240)"
+            body.append(f'<rect x="{85 + i * 95}" y="{55 + j * 50}" '
+                        f'width="90" height="45" fill="{shade}"/>')
+            if value is not None:
+                body.append(f'<text x="{90 + i * 95}" y="{80 + j * 50}">{value:.4g}</text>')
+    body += [f'<text x="{90 + i * 95}" y="48">{x:g}</text>'
+             for i, x in enumerate(xs)]
+    with Path(path).open("x", encoding="utf-8") as output:
+        output.write(f'<svg xmlns="http://www.w3.org/2000/svg" '
+                     f'width="{max(1000, len(xs) * 95 + 100)}" '
+                     f'height="{len(ys) * 50 + 70}">' + "".join(body) + '</svg>')
+
