+@pytest.mark.parametrize("enabled", [False, True])
+def test_inproc_dp_consensus_keeps_stepping_until_beam_work_drains(
+    monkeypatch, enabled
+):
+    from vllm.config import ParallelConfig
+    from vllm.v1.engine.core import EngineCore
+    from vllm.v1.engine.core_client import InprocClient
+    from vllm.v1.engine.llm_engine import LLMEngine
+    from vllm.v1.engine.output_processor import OutputProcessor
+
+    groups = [object(), object()]
+    steps = []
+    engines = []
+    cores = []
+    for rank in range(2):
+        scheduler = SimpleNamespace(
+            _beam=SimpleNamespace(has_work=False), pending=False
+        )
+        scheduler.has_requests = lambda scheduler=scheduler: scheduler.pending
+        core = SimpleNamespace(scheduler=scheduler, batch_queue=[])
+        core.beam_has_work = MethodType(EngineCore.beam_has_work, core)
+
+        def step(rank=rank):
+            steps.append((rank, "real"))
+            return {}, False
+
+        core.step_fn = step
+        core.post_step = lambda **kwargs: None
+        core.execute_dummy_batch = lambda rank=rank: steps.append((rank, "dummy"))
+        client = InprocClient.__new__(InprocClient)
+        client.vllm_config = SimpleNamespace(
+            parallel_config=SimpleNamespace(beam_enabled=enabled)
+        )
+        client.engine_core = core
+        engine = SimpleNamespace(
+            engine_core=client, dp_group=groups[rank],
+            output_processor=OutputProcessor(None, log_stats=False),
+            should_execute_dummy_batch=False, log_stats=False, logger_manager=None,
+        )
+        engine.has_unfinished_requests_dp = MethodType(
+            LLMEngine.has_unfinished_requests_dp, engine
+        )
+        engines.append(engine)
+        cores.append(core)
+
+    votes = []
+    # Fake only the collective result; assert every real caller's local vote.
+    results = iter(
+        [enabled, enabled, enabled, enabled, enabled, enabled, False, False]
+    )
+
+    def consensus(group, local_work):
+        votes.append((group, local_work))
+        return next(results)
+
+    monkeypatch.setattr(ParallelConfig, "has_unfinished_dp", staticmethod(consensus))
+    for phase in ("flush", "queue", "scheduler", "idle"):
+        cores[0].scheduler._beam.has_work = phase == "flush"
+        cores[0].batch_queue = [object()] if phase == "queue" else []
+        cores[0].scheduler.pending = phase == "scheduler"
+        # Both frontends have lost their last public request. Only rank 0 has
+        # local maintenance/FIFO/scheduler work; rank 1 must remain in consensus.
+        assert not any(e.output_processor.has_unfinished_requests() for e in engines)
+        active = [LLMEngine.has_unfinished_requests(e) for e in engines]
+        expected_active = enabled and phase != "idle"
+        assert active == [expected_active, expected_active]
+        assert [e.should_execute_dummy_batch for e in engines] == [
+            False, expected_active
+        ]
+        if expected_active:
+            for engine in engines:
+                assert LLMEngine.step(engine) == []
+            assert not any(e.should_execute_dummy_batch for e in engines)
+
+    assert votes == [
+        (groups[0], enabled), (groups[1], False),
+        (groups[0], enabled), (groups[1], False),
+        (groups[0], enabled), (groups[1], False),
+        (groups[0], False), (groups[1], False),
+    ]
+    assert steps == ([(0, "real"), (1, "dummy")] * 3 if enabled else [])
+
