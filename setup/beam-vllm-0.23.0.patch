+class FakeEvent:
+    def __init__(self, calls):
+        self.calls = calls
+        self.ready = False
+
+    def record(self):
+        self.calls.append("record")
+
+    def synchronize(self):
+        self.ready = True
+        self.calls.append("synchronize")
+
+    def elapsed_time(self, end):
+        assert end.ready
+        self.calls.append("elapsed_time")
+        return 2.5
+
+
+def batch():
+    return SimpleNamespace(
+        beam_step=7,
+        beam_phase=2,
+        beam_clock_mhz=1500,
+        total_num_scheduled_tokens=13,
+    )
