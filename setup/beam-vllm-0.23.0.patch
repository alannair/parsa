+def comparison_cohort(manifest, data, name):
+    cohort = manifest.get("comparison_cohort")
+    required = {"schema_id", "model", "endpoint", "tokenizer", "monitor",
+                "profile_window_policy", "control_wait_policy", "output_sampling"}
+    if (not isinstance(cohort, dict) or not required <= set(cohort)
+            or cohort["schema_id"] != "beam_comparison_cohort_v1"
+            or data.get("comparison_cohort") != cohort):
+        raise ValueError(f"{name}: missing/inconsistent manifest/result comparison cohort")
+    case = manifest.get("case", {})
+    if not {"model", "chat", "tokenizer", "monitor_seconds", "monitor_interval"} <= set(case):
+        raise ValueError(f"{name}: manifest lacks model/endpoint/monitor identity")
+    endpoint = "/v1/chat/completions" if case["chat"] else "/v1/completions"
+    expected = {"model": case["model"], "endpoint": endpoint,
+                "tokenizer": case["tokenizer"] or case["model"],
+                "monitor": {"minimum_seconds": case["monitor_seconds"],
+                            "interval_seconds": case["monitor_interval"]}}
+    for field, value in expected.items():
+        if cohort[field] != value:
+            raise ValueError(f"{name}: manifest/cohort {field} differs")
+    expected_backend = "openai-chat" if case["chat"] else "vllm"
+    if data.get("backend") != expected_backend:
+        raise ValueError(f"{name}: recorded endpoint/backend differs from manifest")
+    if (not isinstance(cohort["output_sampling"], dict) or not cohort["output_sampling"]
+            or not cohort["profile_window_policy"] or not cohort["control_wait_policy"]):
+        raise ValueError(f"{name}: missing output-sampling/energy-window policy identity")
+    return cohort
+
