+def test_gpu_worker_uuid_clock_reset_and_energy(gpu_engine, record_property):
+    start, tp, pp, token = gpu_engine
+    clock = os.environ.get('BEAM_TEST_CLOCK_MHZ')
+    if clock is None:
+        pytest.skip('Set BEAM_TEST_CLOCK_MHZ to exercise actual clock locks')
+    clock = int(clock)
+    assert clock > 0, 'BEAM_TEST_CLOCK_MHZ must be positive and GPU-supported'
+    with start(custom_profiler=True) as llm:
+        try:
+            before = llm.collective_rpc(_worker_snapshot)
+            assert {row['rank'] for row in before} == set(range(tp * pp))
+            assert len({row['uuid'] for row in before}) == tp * pp
+            assert all(row['uuid'].startswith('GPU-') for row in before)
+            observed = llm.collective_rpc(_worker_clock, args=(clock,))
+            assert len(observed) == tp * pp and all(mhz > 0 for mhz in observed)
+            record_property('requested_clock_mhz', clock)
+            record_property('observed_clock_mhz', repr(observed))
+            _generate(llm, token)
+            after = llm.collective_rpc(_worker_snapshot)
+            record_property('worker_energy_before_after', repr((before, after)))
+            previous = {row['rank']: row for row in before}
+            assert {row['rank'] for row in after} == set(previous)
+            for row in after:
+                assert row['uuid'] == previous[row['rank']]['uuid']
+                assert row['energy_mj'] >= previous[row['rank']]['energy_mj'] >= 0
+        finally:
+            llm.collective_rpc('reset_beam_clock')
+            reset = llm.collective_rpc(_worker_snapshot)
+            record_property('previous_or_default_reset_state', repr(reset))
+            assert len(reset) == tp * pp
+            assert all(row['current_clock_mhz'] is None for row in reset)
+
