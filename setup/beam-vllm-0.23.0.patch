+def control_status(value, *, effective=None, pending=False, state="ACTIVE", superseded=False):
+    return {
+        "status": "queued" if pending else "applied", "physical_pp": 4,
+        "state": state, "data_parallel_rank": 0,
+        "chunk_size": {"requested": None, "effective": 1024, "manual": False,
+                       "pending": False, "hard_ceiling": 1024},
+        "microbatch_size": {"requested": value, "effective": value if effective is None else effective,
+                            "manual": value is not None, "pending": pending,
+                            "supported": True, "prefill_superseded": superseded},
+    }
