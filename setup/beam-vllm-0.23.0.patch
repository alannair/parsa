+def test_fifo_retirement_ignores_out_of_order_future_readiness(monkeypatch):
+    scheduler = create_scheduler(pipeline_parallel_size=2)
+    beam = enable_beam(scheduler, monkeypatch, use_s2=True)
+    core = core_for(scheduler, capacity=3)
+    first, second = SchedulerOutput.make_empty(), SchedulerOutput.make_empty()
+    first.beam_step, second.beam_step = 1, 2
+    order = []
+
+    class TracedFuture(Future):
+        def __init__(self, number):
+            super().__init__()
+            self.number = number
+
+        def result(self, timeout=None):
+            order.append(self.number)
+            return super().result(timeout)
+
+    early, late = TracedFuture(1), TracedFuture(2)
+    late.set_result(runner_output(second))  # newer worker result arrives first
+    early.set_result(runner_output(first))
+    core.batch_queue.appendleft((early, first, resolved(None)))
+    core.batch_queue.appendleft((late, second, resolved(None)))
+    beam.state = "RETIRE_ONLY"
+    core.step_with_batch_queue()
+    assert order == [1]
+    assert beam.state == "RETIRE_ONLY"
+    core.step_with_batch_queue()
+    assert order == [1, 2]
+    assert beam.state == "ACTIVE"
+    assert core.model_executor.executed == []
