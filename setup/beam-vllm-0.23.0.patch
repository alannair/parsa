+def phase_step_points(phases):
+    points = []
+    previous_end = None
+    for phase in phases:
+        start, end, rate = (number(phase[key]) for key in ("start_time", "end_time", "rate"))
+        if end < start or (previous_end is not None and start != previous_end):
+            raise ValueError("phase intervals must be ordered and contiguous")
+        points.extend(((start, rate), (end, rate)))
+        previous_end = end
+    return points
+
