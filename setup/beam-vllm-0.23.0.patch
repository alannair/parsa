+def core_for(scheduler, capacity=None):
+    core = EngineCore.__new__(EngineCore)
+    core.scheduler = scheduler
+    core.vllm_config = scheduler.vllm_config
+    core.model_executor = CPUExecutor()
+    core.batch_queue_size = capacity or 1
+    core.batch_queue = deque(maxlen=capacity) if capacity else None
+    core.is_ec_consumer = True
+    core.is_pooling_model = False
+    core.use_spec_decode = False
+    core.async_scheduling = scheduler.scheduler_config.async_scheduling
+    core.aborts_queue = queue.Queue()
+    core.log_error_detail = lambda output: nullcontext()
+    core.log_iteration_details = lambda output: nullcontext()
+    return core
+
+
+def offline_for(core, request=None):
+    """Keep the actual offline loop, frontend, client, and output processor."""
+    client = InprocClient.__new__(InprocClient)
+    client.vllm_config = core.vllm_config
+    client.engine_core = core
+    core.step_fn = (
+        core.step_with_batch_queue if core.batch_queue is not None else core.step
+    )
+    engine = LLMEngine.__new__(LLMEngine)
+    engine.engine_core = client
+    engine.output_processor = OutputProcessor(tokenizer=None, log_stats=False)
+    engine.dp_group = None
+    engine.log_stats = False
+    engine.logger_manager = None
+    engine.should_execute_dummy_batch = False
+    if request is not None:
+        request.sampling_params.detokenize = False
+        request.sampling_params.output_kind = RequestOutputKind.FINAL_ONLY
+        engine.output_processor.add_request(
+            EngineCoreRequest(
+                request_id=request.request_id,
+                external_req_id=request.request_id,
+                prompt_token_ids=request.prompt_token_ids,
+                mm_features=None,
+                sampling_params=request.sampling_params,
+                pooling_params=None,
+                arrival_time=request.arrival_time,
+                lora_request=None,
+                cache_salt=None,
+                data_parallel_rank=None,
+            ),
+            prompt=None,
+        )
+    offline = OfflineInferenceMixin()
+    offline.llm_engine = engine
+    return offline
