+def test_retire_only_does_not_gate_existing_deferred_sampling():
+    # Deferred sampling belongs to an already dispatched invocation. Changing
+    # the gate during schedule() must not drop it or prevent FIFO retirement.
+    old = SchedulerOutput.make_empty()
+    pending = SchedulerOutput.make_empty()
+    pending.num_scheduled_tokens = {"structured": 1}
+    pending.total_num_scheduled_tokens = 1
+    pending.pending_structured_output_tokens = True
+    pending.beam_sampling_req_ids = ("structured",)
+    events = []
+    beam = SimpleNamespace(should_dispatch=True, has_work=True)
+
+    def commit(*, queue_empty):
+        events.append(("commit", queue_empty))
+        return False
+
+    beam.maybe_commit_transition = commit
+
+    def schedule():
+        beam.should_dispatch = False
+        events.append(("dispatch", "structured"))
+        return pending
+
+    scheduler = SimpleNamespace(
+        _beam=beam,
+        vllm_config=SimpleNamespace(),
+        scheduler_config=SimpleNamespace(async_scheduling=True),
+        has_requests=lambda: True,
+        schedule=schedule,
+        get_grammar_bitmask=lambda output: None,
+        update_from_output=lambda output, result: events.append(("retire", output)),
+    )
+    core = core_for(scheduler, capacity=3)
+    core.batch_queue.appendleft((resolved(runner_output(old)), old, resolved(None)))
+    core.step_with_batch_queue()
+    assert core.model_executor.sampled == [pending]
+    assert len(core.batch_queue) == 1
+    core.step_with_batch_queue()
+    assert [event[1] for event in events if event[0] == "retire"] == [old, pending]
+    assert core.model_executor.executed == [pending]
