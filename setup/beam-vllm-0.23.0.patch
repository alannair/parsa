+def monitor_server(base_url, output, *, seconds=30, interval=.2):
+    """Later-only standalone authenticated RPC monitor; no driver NVML imports."""
+    from benchmarks.energy.backend_request_func import collective_rpc
+
+    if number(seconds) == 0 or number(interval) == 0:
+        raise ValueError("monitor seconds/interval must be positive")
+    start, records, cycle, deadline = time.monotonic(), [], 0, None
+    while True:
+        samples = collective_rpc(base_url, "beam_tools_sample")
+        elapsed = time.monotonic() - start
+        records.extend({**row, "cycle": cycle, "client_elapsed_s": elapsed}
+                       for row in samples)
+        cycle += 1
+        if deadline is None:
+            deadline = time.monotonic() + seconds
+        if time.monotonic() >= deadline:
+            break
+        time.sleep(interval)
+    write_json(output, records)
+    legacy_monitor_csv(records, str(output) + ".csv")
+
+
+def clock_overhead(base_url, output, devices, clocks, *, trials=200, settle=.1):
+    """Measure both worker actuation and transport costs, with actual initial states."""
+    from benchmarks.energy.backend_request_func import collective_rpc
+
+    number(settle)
+    if (trials < 1 or not clocks or len(set(clocks)) != len(clocks)
+            or any(type(clock) is not int or clock <= 0 for clock in clocks)):
+        raise ValueError("positive trials/clocks and nonnegative finite settle required")
+    identities = collective_rpc(base_url, "beam_tools_identity")
+    actual = rank_device_map({str(row["rank"]): row["uuid"] for row in identities}, len(devices))
+    if actual != rank_device_map(devices, len(devices)):
+        raise ValueError("clock-overhead intended UUID map differs from assigned workers")
+    low, high = min(clocks), max(clocks)
+    transitions = [("reset_to_low", None, low), ("low_to_high", low, high),
+                   ("high_to_low", high, low)]
+    if len(clocks) > 1:
+        ordered = sorted(set(clocks))
+        transitions += [("adjacent_low", ordered[0], ordered[1]),
+                        ("adjacent_high", ordered[-2], ordered[-1])]
+    directory = Path(output)
+    directory.mkdir(parents=True, exist_ok=False)
+    results = {}
+    try:
+        for name, before, after in transitions:
+            host, workers = [], {rank: [] for rank in actual}
+            for _ in range(trials):
+                collective_rpc(base_url, "beam_tools_clock", {"request": json.dumps({
+                    "devices": actual, "clock": before,
+                })})
+                time.sleep(settle)
+                started = time.perf_counter_ns()
+                observed = collective_rpc(base_url, "beam_tools_clock", {"request": json.dumps({
+                    "devices": actual, "clock": after,
+                })})
+                host.append((time.perf_counter_ns() - started) / 1_000_000)
+                for row in observed:
+                    workers[str(row["rank"])].append(number(row["actuation_ms"]))
+            results[name] = {"host_rpc": distribution(host),
+                             "workers": {rank: distribution(values)
+                                         for rank, values in workers.items()},
+                             "host_raw_ms": host, "worker_raw_ms": workers}
+    finally:
+        collective_rpc(base_url, "beam_tools_clock", {"request": json.dumps({
+            "devices": actual, "clock": None,
+        })})
+    write_json(directory / "clock-overhead.json", {"rank_devices": actual, "results": results,
+               "domain": "worker NVML lock/readback vs authenticated HTTP+collective RPC"})
+    svg_panels(directory / "clock-overhead.svg", [("Clock-control host RPC ms vs trial", [
+        {"name": name, "points": list(enumerate(result["host_raw_ms"]))}
+        for name, result in results.items()
+    ])])
