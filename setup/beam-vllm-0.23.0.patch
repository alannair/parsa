+        scheduler.parallel_config.beam_log_dir = str(tmp_path)
+        core.vllm_config.profiler_config = ProfilerConfig(profiler="cuda")
+    namespace = beam.log_namespace
+    start_error = OSError("scheduler CSV header failed")
+    stop_error = RuntimeError("worker profiler stop failed")
+    calls = []
+    opened = []
+    active = False
+    writer = beam_module.csv.writer
+
+    class FailedWriter:
+        def writerow(self, row):
+            raise start_error
+
+    def csv_writer(stream):
+        opened.append(stream)
+        return FailedWriter() if stream.name.endswith("s2_log.csv") else writer(stream)
+
+    def worker_profile(is_start=True, prefix=None, **kwargs):
+        nonlocal active
+        calls.append((is_start, prefix, kwargs))
+        if not is_start and stop_fails:
+            raise stop_error
+        active = is_start
+
+    monkeypatch.setattr(beam_module.csv, "writer", csv_writer)
+    core.model_executor.profile = worker_profile
+    with pytest.raises(OSError) as raised:
+        if custom:
+            core.profile(True, "capture", output_dir=str(tmp_path))
+        else:
+            core.profile(True, "capture")
+    assert raised.value is start_error
+    assert active is stop_fails
+    assert calls == [
+        (True, "capture", {"output_dir": str(tmp_path)} if custom else {}),
+        (False, "capture", {}),
+    ]
+    if stop_fails:
+        assert raised.value.__cause__ is stop_error
+    assert beam.log_namespace == namespace
+    assert opened and all(stream.closed for stream in opened)
+    assert not beam._log_files
+    assert not beam._writers
+    root = tmp_path / "capture" if custom else tmp_path
+    assert (root / namespace / "s1_log.csv").is_file()
