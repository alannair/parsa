+def test_p1_partial_collective_start_never_consumes_stale_replies(trial_core, tmp_path):
+    core = trial_core(pp=1)
+    executor = core.model_executor
+    replies = deque(["rank-1 start ack", "rank-2 start ack"])
+    primary = RuntimeError("first rank profile start failed")
+    calls = []
+
+    def profile(is_start=True, prefix=None, **kwargs):
+        calls.append((is_start, prefix, kwargs))
+        if is_start:
+            assert core._beam_profile_active  # uncertain BEFORE dispatch
+            executor.active = True
+            executor._beam_response_stream_failed = True
+            raise primary
+        replies.popleft()  # would incorrectly consume a start ack as a stop ack
+
+    executor.profile = profile
+    with pytest.raises(RuntimeError) as raised:
+        core.beam_profile_trial(3, 0, 0, str(tmp_path))
+    assert raised.value is primary
+    assert len(calls) == 1 and calls[0][0] is True
+    assert list(replies) == ["rank-1 start ack", "rank-2 start ack"]
+    assert executor.executed == []  # no maintenance RPC either
+    assert not core.scheduler.requests  # driver-only release is safe, not worker proof
+    assert core.scheduler.finished_req_ids  # deliberately not claimed as dispatched
+    assert core.scheduler.beam_profile_admission is None
+    assert core.scheduler.beam_profile_expected is None
+    assert core._beam_profile_active
+    assert core._beam_profile_unusable
+    report = core._beam_profile_cleanup_report
+    assert report["confirmed"] is False
+    assert report["restart_required"] is True
+    assert report["transport_failed"] is True
+    assert report["profile_stop_confirmed"] is False
+    assert report["worker_cleanup_steps"] == 0
+    assert "cleanup unconfirmed" in str(raised.value.__cause__)
+    with pytest.raises(RuntimeError, match="restart required"):
+        core.profile(False)
+    with pytest.raises(RuntimeError, match="restart required"):
+        core.step()
+    assert len(calls) == 1
+    assert len(replies) == 2
