+    assert work.total_num_scheduled_tokens == 8
+    monkeypatch.setattr(
+        beam_module, "choose_s2",
+        lambda model, **kwargs: S2Decision(1, 1050, 0.1, 1.0, True),
+    )
+    empties = [scheduler.schedule() for _ in range(pp)]
+    assert all(output.total_num_scheduled_tokens == 0 for output in empties)
+    assert beam.state == "RETIRE_ONLY"
+    assert not beam.should_dispatch
+    assert not beam.maybe_commit_transition(queue_empty=False)
+    assert not beam.maybe_commit_transition(queue_empty=True)  # work unretired
+    retire(scheduler, work)
+    for output in empties:
+        retire(scheduler, output)
+    absolute_step = scheduler.current_step
+    request.next_decode_eligible_step = absolute_step + 20
+    assert beam.maybe_commit_transition(queue_empty=True)
+    assert beam.num_microbatches == 1
+    assert scheduler.current_step == absolute_step
+    assert request.next_decode_eligible_step == absolute_step + 20
+    # A new prefill requires physical P before even its first token is admitted.
+    new_request, = create_requests(1, num_tokens=40, req_ids=["new"])
+    scheduler.add_request(new_request)
+    for _ in range(pp):
+        output = scheduler.schedule()
+        assert output.total_num_scheduled_tokens == 0
+        retire(scheduler, output)
+    assert beam.maybe_commit_transition(queue_empty=True)
+    assert beam.num_microbatches == pp
