+TARGET = "0fc695fc6d1d82e9a5ac6835ac8e4e1c83703665"
+ARTIFACT = "0febb08e7446c9826bff5fce93e0e8a2deab5e5f"
+ROOT = Path(__file__).resolve().parents[2]
+MODES = {"A": (), "B": (), "B2": ("use_window_based_dvfs_only",),
+         "B3": ("use_s1", "use_s1_dvfs_only"), "C": ("use_s1",),
+         "D": ("use_s1", "use_s2"), "S2": ("use_s2",)}
+CALIBRATION = (
+    "Artifact v0.11.2-era profiles are uncalibrated on v0.23.0. Match GPU, model, "
+    "TP/PP, dtype, attention backend, runner and clock domain before evaluation. "
+    "Real-generation windows are not controlled mixed-forward lookup tables."
+)
