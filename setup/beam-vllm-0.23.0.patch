+def test_worker_clock_validates_assigned_uuid_and_policy_before_actuation():
+    operations = []
+    uuid = "GPU-00000000-0000-0000-0000-000000000001"
+    controller = SimpleNamespace(
+        device_uuid=uuid,
+        set_clock=lambda clock: operations.append(clock) or clock,
+        reset=lambda: operations.append("reset"),
