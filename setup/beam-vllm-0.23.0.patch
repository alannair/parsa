+"""Worker-owned BEAM EnergyLogger with deferred CUDA-event forward timing.
+
+Adapted from BEAM-artifact commit 0febb08e7446c9826bff5fce93e0e8a2deab5e5f,
+vllm/v1/worker/gpu_worker.py: EnergyLogger and gpu_model_runner.py: forward timing.
+Original SPDX-License-Identifier: Apache-2.0; copyright vLLM contributors.
+
+elapsed_time is CUDA-event milliseconds around the actual model/graph invocation.
+batch_size is padded forward tokens; num_scheduled_tokens excludes padding.
+start_time/current_time are host enqueue wall times, not GPU completion times.
+curr_energy is a cumulative physical-device mJ snapshot at host enqueue end;
+it is NOT per-forward attribution. Energy start/stop snapshots cover the whole
+profile window, including other work on that GPU. Connector timing is host seconds.
+The DVFS CSV keeps its legacy column prefix: max_batch_size now records the
+finalized scheduled-token count, and expected_max_running_time carries the
+scheduler's expected_tbt unchanged (no unit conversion or local prediction).
+"""
+
+import csv
+import time
+from contextlib import contextmanager, nullcontext
+from datetime import datetime
+from pathlib import Path
+
+
+class EnergyLogger:
+    """Keep events locally until stop(), the only timing synchronization boundary.
+
+    Args:
+        rank: Global worker rank used in the legacy CSV filenames.
+        controller: Device-bound clock/energy reader, owned by the worker.
+        device: Assigned torch CUDA device for event stream selection.
+        event_factory: Optional event factory for CPU-only tests.
+    """
+
+    def __init__(self, rank: int, controller, device=None, event_factory=None):
+        self.rank = rank
+        self.controller = controller
+        self.device = device
+        self._event_factory = event_factory
+        self.do_log = False
+        self._unflushed = False
+        self.output_dir = None
+        # ponytail: O(forwards) events until stop; chunk windows for long profiles.
+        self._pending = []
+        self.dvfs_log = []
+        self.start_load_kv_log = []
+        self.wait_for_layer_load_log = []
+        self.energy_log = []
+
+    def _energy_snapshot(self):
+        energy = self.controller.get_total_energy_mj()
+        return (datetime.now().isoformat(sep=" "), time.monotonic(), energy)
+
+    def start(self, output_dir: str | None = None) -> None:
+        if self.do_log or self._unflushed:
+            raise RuntimeError("BEAM profiler already active or has unflushed events")
+        if output_dir is None or not str(output_dir).strip():
+            raise ValueError("BEAM profiler requires an output directory")
+        directory = Path(output_dir)
+        directory.mkdir(parents=True, exist_ok=True)
+        snapshot = self._energy_snapshot()
+        self.output_dir = directory
+        self.dvfs_log = []
+        self.start_load_kv_log = []
+        self.wait_for_layer_load_log = []
+        self.energy_log = [snapshot]
+        self._unflushed = True
+        self.do_log = True
+
+    def _record_event(self, event, stream=None):
+        if self.device is None:
+            event.record()
+        else:
+            import torch
+
+            if stream is None:
+                stream = torch.cuda.current_stream(self.device)
+            event.record(stream)
+        return stream
+
+    def _new_event(self):
+        if self._event_factory is not None:
+            return self._event_factory()
+        import torch
+
+        return torch.cuda.Event(enable_timing=True)
+
+    @contextmanager
+    def forward_context(self, scheduler_output, batch_size: int, num_reqs: int):
+        if not self.do_log:
+            yield
+            return
+        start, end = self._new_event(), self._new_event()
+        start_time = datetime.now().isoformat(sep=" ")
+        stream = self._record_event(start)
+        yield
+        self._record_event(end, stream)
+        current_time, monotonic_s, energy = self._energy_snapshot()
+        clock = self.controller.get_clock_mhz()
+        self._pending.append(
+            (
+                start,
+                end,
+                (
+                    getattr(scheduler_output, "beam_step", 0),
+                    getattr(scheduler_output, "beam_phase", 0),
+                    batch_size,
+                    clock,
+                    num_reqs,
+                    start_time,
+                    current_time,
+                    energy,
+                    scheduler_output.total_num_scheduled_tokens,
+                    getattr(scheduler_output, "beam_clock_mhz", None),
+                    monotonic_s,
+                    "cuda_event_model_forward_ms",
+                    "device_cumulative_mj_host_snapshot",
+                ),
+            )
+        )
+
+    def log_dvfs(
+        self,
+        gpu_clock,
+        max_batch_size,
+        expected_max_running_time,
+        *,
+        requested_clock_mhz=None,
+        step=0,
+        phase=0,
+    ) -> None:
+        if self.do_log:
+            self.dvfs_log.append(
+                (
+                    datetime.now().isoformat(sep=" "),
+                    gpu_clock,
+                    max_batch_size,
+                    expected_max_running_time,
+                    requested_clock_mhz,
+                    step,
+                    phase,
+                )
+            )
+
+    @contextmanager
+    def connector_context(self, operation: str, layer_name: str | None = None):
+        if not self.do_log:
+            yield
+            return
+        invoked = datetime.now().isoformat(sep=" ")
+        start = time.perf_counter()
+        yield
+        elapsed = time.perf_counter() - start
+        if operation == "start_load_kv":
+            self.start_load_kv_log.append((invoked, elapsed))
+        elif operation == "wait_for_layer_load":
+            self.wait_for_layer_load_log.append((invoked, layer_name, elapsed))
+        else:
+            raise ValueError(f"Unknown BEAM connector timing operation: {operation}")
+
+    def _write(self, name, header, rows):
+        with (self.output_dir / f"{name}_GPU_{self.rank}.csv").open(
+            "w", newline="", encoding="utf-8"
+        ) as output:
+            writer = csv.writer(output)
+            writer.writerow(header.split(","))
+            writer.writerows(rows)
+
+    def stop(self) -> None:
+        if not self._unflushed:
+            return
+        self.do_log = False
+        # Synchronize EACH end event: do not assume all forwards used one stream.
+        for _, end, _ in self._pending:
+            end.synchronize()
+        rows = []
+        for start, end, metadata in self._pending:
+            step, phase, *rest = metadata
+            rows.append((step, phase, start.elapsed_time(end), *rest))
+        snapshots = [*self.energy_log, self._energy_snapshot()]
+        self._write(
+            "batch_log",
+            "step,phase,elapsed_time,batch_size,gpu_clock,num_reqs,start_time,"
+            "current_time,curr_energy,num_scheduled_tokens,requested_clock_mhz,"
+            "energy_snapshot_monotonic_s,timing_domain,energy_domain",
+            rows,
+        )
+        self._write(
+            "dvfs_log",
+            "current_time,gpu_clock,max_batch_size,expected_max_running_time,"
+            "requested_clock_mhz,step,phase",
+            self.dvfs_log,
+        )
+        self._write(
+            "energy_log", "current_time,monotonic_s,total_energy_mj", snapshots
+        )
+        self._write(
+            "start_load_kv_log", "invoked_time,time_taken_seconds", self.start_load_kv_log
+        )
+        self._write(
+            "wait_for_layer_load_log",
+            "invoked_time,layer_name,time_taken_seconds",
+            self.wait_for_layer_load_log,
+        )
+        # Retain data if synchronization, counter reads or CSV writing failed.
+        self._pending.clear()
+        self.energy_log = snapshots
+        self._unflushed = False
+
+
+def beam_forward_context(
+    runner, scheduler_output, batch_size: int, num_reqs: int, *, enabled: bool = True
+):
+    """Return a minimal actual-forward wrapper, excluding dummy/capture runs."""
+    profiler = getattr(runner, "beam_profiler", None)
+    if profiler is None or not profiler.do_log or not enabled:
+        return nullcontext()
+    return profiler.forward_context(scheduler_output, batch_size, num_reqs)
