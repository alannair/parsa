+"""Stdlib BEAM evaluation, window monitoring, Pareto and SVG visualizations.
+
+Adapted semantics from BEAM-artifact 0febb08: energy/analyze_single_trace.py,
+dynamollm_profiles/collect.py, sensitivity_tests/visualize_pareto.py, energy/
+visualization/* and v1/core/sched/overhead_analysis.py. Original Apache-2.0,
+copyright contributors to the vLLM project. No original plotting module is
+imported: those modules mix old schemas, global NVML and plotting dependencies.
+"""
+
+import csv
+import importlib.util
+import json
+import math
+import statistics
+import sys
+import time
+from datetime import datetime
+from html import escape
+from pathlib import Path
+
+from benchmarks.energy.beam_tools import (
+    ROOT, input_reference, percentile, rank_device_map, write_json,
+)
+
+
+def number(value):
+    try:
+        value = float(value)
+    except (TypeError, ValueError, OverflowError) as error:
+        raise ValueError("expected finite nonnegative measurement") from error
+    if not math.isfinite(value) or value < 0:
+        raise ValueError("expected finite nonnegative measurement")
+    return value
+
+
+def power_window(samples, seconds=30, *, mode="historical"):
+    """Historical last-sample-at/before cutoff; linear interpolation is opt-in.
+
+    Counters are mJ despite the original monitor's misleading *_joules names.
+    Each rank's first sample starts its own monotonic window; no cross-host
+    monotonic timestamps are subtracted. Full cutoff coverage is required.
+    """
+    seconds = number(seconds)
+    if seconds == 0 or mode not in ("historical", "linear"):
+        raise ValueError("positive sample window and historical/linear mode required")
+    groups, devices = {}, {}
+    for row in samples:
+        rank = str(row["rank"])
+        if rank in devices and devices[rank] != row["uuid"]:
+            raise ValueError("monitor rank changed physical UUID")
+        devices[rank] = row["uuid"]
+        groups.setdefault(rank, []).append(row)
+    if not groups:
+        raise ValueError("monitor has no samples")
+    devices = rank_device_map(devices, len(groups))
+    result = {}
+    for rank, rows in groups.items():
+        times = [number(row["monotonic_s"]) for row in rows]
+        energies = [number(row["total_energy_mj"]) for row in rows]
+        if (len(rows) < 2 or any(b <= a for a, b in zip(times, times[1:]))
+                or any(b < a for a, b in zip(energies, energies[1:]))):
+            raise ValueError("invalid monitor counter/time series")
+        cutoff = times[0] + seconds
+        if times[-1] < cutoff:
+            raise ValueError(f"rank {rank} lacks complete {seconds}s sample coverage")
+        index = max(i for i, timestamp in enumerate(times) if timestamp <= cutoff)
+        end_time, end_energy = times[index], energies[index]
+        if mode == "linear" and end_time < cutoff:
+            weight = (cutoff - end_time) / (times[index + 1] - end_time)
+            end_energy += weight * (energies[index + 1] - end_energy)
+            end_time = cutoff
+        elapsed = end_time - times[0]
+        if elapsed <= 0:
+            raise ValueError("sample window contains fewer than two measured points")
+        energy_j = (end_energy - energies[0]) / 1000
+        result[rank] = {"seconds": elapsed, "energy_j": energy_j,
+                        "power_w": energy_j / elapsed}
+    return {"ranks": result, "rank_devices": devices, "window_requested_s": seconds,
+            "mode": mode, "total_power_w": sum(row["power_w"] for row in result.values()),
+            "domain": "sampled_physical_device_window_not_forward_attribution"}
+
+
+def legacy_monitor_csv(samples, path):
+    """Explicit old-schema export, preserving its mJ column misnomer in metadata."""
+    cycles = {}
+    ranks = sorted({int(row["rank"]) for row in samples})
+    for row in samples:
+        cycles.setdefault(row["cycle"], {})[int(row["rank"])] = row
+    fields = ["timestamp"]
+    for rank in ranks:
+        fields += [f"gpu_{rank}_joules", f"gpu_{rank}_freq_mhz"]
+    with Path(path).open("x", newline="") as output:
+        writer = csv.DictWriter(output, fieldnames=fields)
+        writer.writeheader()
+        for cycle in sorted(cycles):
+            rows = cycles[cycle]
+            if set(rows) != set(ranks):
+                raise ValueError("monitor cycle has incomplete rank coverage")
+            record = {"timestamp": rows[ranks[0]]["timestamp"]}
+            for rank, row in rows.items():
+                record[f"gpu_{rank}_joules"] = row["total_energy_mj"]
+                record[f"gpu_{rank}_freq_mhz"] = row["clock_mhz"]
+            writer.writerow(record)
+    write_json(str(path) + ".metadata.json", {
+        "counter_unit": "mJ", "legacy_column_misnomer": "*_joules",
+        "timestamp_scope": "first rank's wall timestamp; ranks sampled sequentially",
+        "rank_devices": {str(row["rank"]): row["uuid"] for row in samples},
+    })
+
+
+def pareto_frontier(rows, objectives):
+    if not objectives or any(value not in ("min", "max") for value in objectives.values()):
+        raise ValueError("Pareto objectives must name min/max directions")
+    vectors = [[number(row[name]) * (1 if direction == "min" else -1)
+                for name, direction in objectives.items()] for row in rows]
+    # ponytail: O(cases²); sweep sizes are small, use sorted skyline for large archives.
+    return [row for i, row in enumerate(rows) if not any(
+        all(a <= b for a, b in zip(other, vectors[i]))
+        and any(a < b for a, b in zip(other, vectors[i]))
+        for j, other in enumerate(vectors) if i != j
+    )]
+
+
+def svg_panels(path, panels):
+    """Simple numeric line/scatter panels; every axis title states its domain/unit."""
+    colors = ("#1565c0", "#c62828", "#2e7d32", "#6a1b9a", "#ef6c00")
+    width, panel_height = 1000, 230
+    body = []
+    for index, (title, series) in enumerate(panels):
+        top = 30 + index * panel_height
+        points = [(number(x), number(y)) for item in series for x, y in item["points"]]
+        if not points:
+            body.append(f'<text x="30" y="{top}">{escape(title)}: no observations</text>')
+            continue
+        xmax = max(x for x, _ in points) or 1
+        ymax = max(y for _, y in points) or 1
+        body.append(f'<text x="30" y="{top}">{escape(title)}</text>')
+        body.append(f'<path d="M55 {top + 15}V{top + 175}H955" '
+                    'fill="none" stroke="gray"/>')
+        body.append(f'<text x="55" y="{top + 195}">'
+                    f'x: 0–{xmax:.4g}; y: 0–{ymax:.4g}</text>')
+        for color_index, item in enumerate(series):
+            color = colors[color_index % len(colors)]
+            coordinates = [(55 + number(x) / xmax * 900,
+                            top + 175 - number(y) / ymax * 150)
+                           for x, y in item["points"]]
+            polyline = " ".join(f"{x:.2f},{y:.2f}" for x, y in coordinates)
+            body.append(f'<polyline points="{polyline}" fill="none" '
+                        f'stroke="{color}" stroke-width="1"/>')
+            body.extend(f'<circle cx="{x:.2f}" cy="{y:.2f}" r="2" fill="{color}"/>'
+                        for x, y in coordinates)
+            body.append(f'<text x="{280 + color_index * 130}" y="{top + 195}" '
+                        f'fill="{color}">{escape(item["name"])}</text>')
+    with Path(path).open("x", encoding="utf-8") as output:
+        output.write(f'<svg xmlns="http://www.w3.org/2000/svg" width="{width}" '
+                     f'height="{max(1, len(panels)) * panel_height + 20}">'
+                     '<rect width="100%" height="100%" fill="white"/>'
+                     + "".join(body) + '</svg>')
+
+
+def csv_rows(path):
+    with Path(path).open(newline="", encoding="utf-8") as source:
+        return list(csv.DictReader(source))
+
+
+def wall_seconds(value):
+    return datetime.fromisoformat(value).timestamp()
+
+
+def timeline_panels(worker_directory, samples):
+    worker = Path(worker_directory)
+    forward_series, all_batches = [], []
+    for path in sorted(worker.glob("batch_log_GPU_*.csv")):
+        rows = csv_rows(path)
+        if any(row.get("timing_domain") != "cuda_event_model_forward_ms" for row in rows):
+            raise ValueError("timeline requires target timing-domain metadata")
+        all_batches += rows
+        forward_series.append((path.stem, rows))
+    origin = min((wall_seconds(row["start_time"]) for row in all_batches), default=None)
+    panels = [("Forward ms vs host enqueue seconds (NOT GPU completion timeline)", [
+        {"name": name, "points": [(wall_seconds(row["start_time"]) - origin,
+                                    number(row["elapsed_time"])) for row in rows]}
+        for name, rows in forward_series
+    ])]
+    if samples:
+        grouped = {}
+        for sample in samples:
+            grouped.setdefault(str(sample["rank"]), []).append(sample)
+        energy, power, clocks = [], [], []
+        for rank, rows in grouped.items():
+            first_time = number(rows[0]["monotonic_s"])
+            first_energy = number(rows[0]["total_energy_mj"])
+            x = lambda row: number(row.get("client_elapsed_s",  # client is shared domain
+                                          number(row["monotonic_s"]) - first_time))
+            energy.append({"name": "rank " + rank, "points": [
+                (x(row), (number(row["total_energy_mj"]) - first_energy) / 1000)
+                for row in rows]})
+            clocks.append({"name": "rank " + rank, "points": [
+                (x(row), number(row["clock_mhz"])) for row in rows]})
+            watts = []
+            for a, b in zip(rows, rows[1:]):
+                elapsed = number(b["monotonic_s"]) - number(a["monotonic_s"])
+                delta = number(b["total_energy_mj"]) - number(a["total_energy_mj"])
+                if elapsed <= 0 or delta < 0:
+                    raise ValueError("invalid monitor timeline counter/interval")
+                watts.append((x(b), delta / 1000 / elapsed))
+            power.append({"name": "rank " + rank, "points": watts})
+        panels += [("Cumulative window Joules vs sampled elapsed seconds", energy),
+                   ("Physical device Watts vs sampled elapsed seconds", power),
+                   ("Observed SM MHz vs sampled elapsed seconds", clocks)]
+    schemas = {"s1_log": ("optimal_chunk_size", "S1 token ceiling"),
+               "s2_log": ("optimal_num_microbatches", "S2 selected owner phases"),
+               "kv_usage_log": ("usage", "KV cache fraction"),
+               "s1_exec_time_log": ("execution_time", "S1 algorithm milliseconds"),
+               "s2_exec_time_log": ("execution_time", "S2 algorithm milliseconds"),
+               "schedule_exec_time_log": ("execution_time", "Scheduler milliseconds")}
+    for filename, (column, title) in schemas.items():
+        series = []
+        for path in sorted(worker.rglob(filename + ".csv")):
+            rows = csv_rows(path)
+            anchor = origin if origin is not None else min(
+                (number(row["timestamp"]) for row in rows), default=0)
+            scale = 1000 if column == "execution_time" else 1
+            # Tiny origin skew is clipped for display only; raw CSVs are untouched.
+            series.append({"name": path.parent.name, "points": [
+                (max(0, number(row["timestamp"]) - anchor), number(row[column]) * scale)
+                for row in rows]})
+        panels.append((title + " vs host wall-offset seconds", series))
+    for filename in ("start_load_kv_log", "wait_for_layer_load_log"):
+        series = []
+        for path in sorted(worker.glob(filename + "_GPU_*.csv")):
+            rows = csv_rows(path)
+            anchor = origin if origin is not None else min(
+                (wall_seconds(row["invoked_time"]) for row in rows), default=0)
+            series.append({"name": path.stem, "points": [
+                (max(0, wall_seconds(row["invoked_time"]) - anchor),
+                 number(row["time_taken_seconds"]) * 1000) for row in rows]})
+        panels.append((filename + " host milliseconds vs invocation seconds", series))
+    return panels
+
