+@pytest.mark.parametrize("finish", ["complete", "abort"])
+def test_real_offline_loop_drains_beam_after_last_public_request(monkeypatch, finish):
+    scheduler = create_scheduler(pipeline_parallel_size=2)
+    beam = enable_beam(scheduler, monkeypatch, use_s2=True)
+    monkeypatch.setattr(
+        beam_module, "choose_s2",
+        lambda model, **kwargs: S2Decision(1, 1050, 0.1, 1.0, True),
+    )
+    core = core_for(scheduler, capacity=2)
+    request, = create_requests(1, num_tokens=8, max_tokens=3)
+    scheduler.add_request(request)
+    offline = offline_for(core, request)
+    actual_step = core.step_fn
+    steps = 0
+    maintenance_steps = []
+    aborted = False
+
+    def bounded_step():
+        nonlocal steps, aborted
+        steps += 1
+        assert steps < 64, "offline maintenance did not converge for this fixed fake"
+        if not offline.llm_engine.output_processor.has_unfinished_requests():
+            maintenance_steps.append(beam.state)
+        result = actual_step()
+        if (
+            finish == "abort" and not aborted
+            and beam.state == "ACTIVE" and beam.num_microbatches == 1
+        ):
+            offline.llm_engine.abort_request(["0"], internal=True)
+            aborted = True
+        return result
+
+    core.step_fn = bounded_step
+    outputs = offline._run_engine(RequestOutput, use_tqdm=False)
+    if finish == "complete":
+        assert len(outputs) == 1
+        assert outputs[0].finished
+        assert outputs[0].outputs[0].token_ids == [7, 7, 7]
+    else:
+        assert aborted
+        assert outputs == []
+    assert maintenance_steps  # the real outer predicate outlives public requests
+    assert not offline.llm_engine.has_unfinished_requests()
+    assert not scheduler.has_requests()
+    assert not core.batch_queue
+    assert not beam.has_work
+    assert beam.state == "ACTIVE"
+    assert beam.num_microbatches == 2
+
