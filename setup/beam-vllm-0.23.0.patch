+def _validate_beam_p2p_config(vllm_config: "VllmConfig") -> dict[str, Any] | None:
+    transfer = vllm_config.kv_transfer_config
+    parallel = vllm_config.parallel_config
+    enabled = transfer.get_from_extra_config("enable_asymmetric_p2p", False)
+    if type(enabled) is not bool:
+        raise ValueError("enable_asymmetric_p2p must be a boolean")
+    remote_tp = transfer.get_from_extra_config("remote_tp_size", None)
+    remote_pp = transfer.get_from_extra_config("remote_pp_size", None)
+    partition = transfer.get_from_extra_config("remote_pp_layer_partition", None)
+    for key, value in (("remote_tp_size", remote_tp), ("remote_pp_size", remote_pp)):
+        if value is not None and (type(value) is not int or value <= 0):
+            raise ValueError(f"{key} must be a positive integer")
+    if not enabled:
+        if (
+            remote_tp not in (None, parallel.tensor_parallel_size)
+            or remote_pp not in (None, parallel.pipeline_parallel_size)
+            or partition is not None
+        ):
+            raise ValueError("Asymmetric P2P controls require enable_asymmetric_p2p=true")
+        return None
+    if remote_tp is None or remote_pp is None:
+        raise ValueError("BEAM requires explicit remote_tp_size and remote_pp_size")
+    if remote_tp != parallel.tensor_parallel_size:
+        raise NotImplementedError("BEAM asymmetric TP is unsupported for PUT and GET")
+    if transfer.kv_role not in ("kv_producer", "kv_consumer"):
+        raise ValueError("BEAM requires a dedicated kv_producer or kv_consumer")
+    for key in (
+        "data_parallel_size",
+        "prefill_context_parallel_size",
+        "decode_context_parallel_size",
+        "nnodes",
+    ):
+        if getattr(parallel, key) != 1:
+            raise ValueError(f"BEAM asymmetric P2P requires {key}=1")
+    if parallel.distributed_executor_backend not in ("mp", "uni"):
+        raise ValueError("BEAM asymmetric P2P requires a single-host mp or uni executor")
+    if vllm_config.speculative_config is not None:
+        raise ValueError("BEAM asymmetric P2P does not support speculative layers")
+    if vllm_config.cache_config.cache_dtype != "auto":
+        raise ValueError("BEAM asymmetric P2P requires unquantized auto KV cache dtype")
+    send_type = transfer.get_from_extra_config("send_type", "PUT_ASYNC")
+    if send_type not in ("PUT", "PUT_ASYNC", "GET"):
+        raise ValueError("BEAM send_type must be PUT, PUT_ASYNC, or GET")
+    model = vllm_config.model_config
+    total = model.get_total_num_hidden_layers()
+    if (
