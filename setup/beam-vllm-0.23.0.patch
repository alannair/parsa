+def test_empty_terminal_token_ids_preserve_latency_itl_and_tpot(chat):
+    first = {"delta": {"content": "a"}} if chat else {"text": "a"}
+    last = {"delta": {"content": ""}} if chat else {"text": ""}
+    frames = []
+    if chat:
+        frames.append((.01, {"choices": [{"delta": {"role": "assistant", "content": ""},
+                                         "token_ids": []}]}))
+    frames += [(.1, {"choices": [{**first, "token_ids": [11], "finish_reason": None}]}),
+               (.8, {"choices": [{**last, "token_ids": [12], "finish_reason": "length"}]}),
+               (.9, {"choices": [], "usage": {"completion_tokens": 2}})]
+    output = consume_sse(frames, chat=chat)
+    assert output["ttft"] == .1 and output["latency"] == .8
+    assert output["itl"] == pytest.approx([.7])
+    assert output["tokens_per_chunk"] == [1, 1] and output["stream_token_count"] == 2
+    result = metrics({"successes": [True], "ttfts": [output["ttft"]],
+                      "itls": [output["itl"]], "e2el": [output["latency"]],
+                      "output_lens": [output["output_tokens"]], "duration": 1},
