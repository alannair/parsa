+# along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+"""Native v0.23 worker-extension and middleware for the local BEAM harness.
+
+Replaces BEAM-artifact 0febb08 energy/utils.sh and gpu_energy_monitor.py global
+GPU access with assigned-worker operations. Original algorithms: Apache-2.0,
+copyright contributors to the vLLM project. No imports initialize NVML/CUDA.
+"""
+
+import hmac
+import json
+import os
+import time
+from datetime import datetime, timezone
+from uuid import UUID
+
+
+class BeamToolWorker:
+    """Injected by --worker-extension-cls; methods run on the actual GPU worker."""
+
+    def beam_tools_identity(self):
+        controller = self._get_beam_clock_controller()
+        return {"rank": self.rank, "uuid": controller.device_uuid}
+
+    def beam_tools_clock(self, request: str):
+        specification = json.loads(request)
+        controller = self._get_beam_clock_controller()
+        expected = specification["devices"].get(str(self.rank))
+        try:
+            expected = "GPU-" + str(UUID(expected.removeprefix("GPU-")))
+        except (ValueError, TypeError, AttributeError) as error:
+            raise ValueError("expected physical UUID for every worker rank") from error
+        if expected != controller.device_uuid:
+            raise ValueError("worker UUID differs from the intended clock device")
+        clock = specification["clock"]
+        started = time.perf_counter_ns()
+        if clock is None:
+            controller.reset()
+            observed = None
+        else:
+            if any(getattr(self.parallel_config, name, False) for name in (
+                "use_s1", "use_s2", "use_window_based_dvfs_only",
+            )):
+                raise ValueError("fixed worker clocks conflict with an active DVFS policy")
+            if type(clock) is not int or clock <= 0:
+                raise ValueError("clock must be positive integer MHz")
+            observed = controller.set_clock(clock)
+        return {**self.beam_tools_identity(), "observed_clock_mhz": observed,
+                "actuation_ms": (time.perf_counter_ns() - started) / 1_000_000}
+
+    def beam_tools_sample(self):
+        controller = self._get_beam_clock_controller()
+        energy = controller.get_total_energy_mj()
+        return {**self.beam_tools_identity(), "monotonic_s": time.monotonic(),
+                "timestamp": datetime.now(timezone.utc).isoformat(),
+                "total_energy_mj": energy, "clock_mhz": controller.get_clock_mhz()}
+
+
+class BeamToolsAuthMiddleware:
+    """Guard the whole private server, including dev mutations and websockets."""
+
+    def __init__(self, app):
+        self.app = app
+        self.token = os.environ.get("BEAM_TOOLS_RPC_TOKEN")
+        if not self.token:
+            raise ValueError("BEAM tooling middleware requires a private runtime token")
+
+    async def __call__(self, scope, receive, send):
+        path = scope.get("path", "")
+        root = scope.get("root_path", "").rstrip("/")
+        if root and (path == root or path.startswith(root + "/")):
+            path = path[len(root):] or "/"
+        public = scope["type"] == "http" and (
+            scope.get("method") == "OPTIONS"
+            or (scope.get("method") == "GET" and path == "/health")
+        )
+        if scope["type"] in ("http", "websocket") and not public:
+            authorization = dict(scope.get("headers", [])).get(b"authorization", b"")
+            expected = ("Bearer " + self.token).encode()
+            if not hmac.compare_digest(authorization, expected):
+                if scope["type"] == "websocket":
+                    await send({"type": "websocket.close", "code": 1008})
+                else:
+                    body = b'{"error":"Unauthorized"}'
+                    await send({"type": "http.response.start", "status": 401,
+                                "headers": [(b"content-type", b"application/json")]})
+                    await send({"type": "http.response.body", "body": body})
+                return
+        await self.app(scope, receive, send)
