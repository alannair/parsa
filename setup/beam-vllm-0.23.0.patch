+@pytest.mark.parametrize("failure", [None, "timeout", "rejected", "wrong_port"])
+def test_handshake_precedes_nccl_and_rejects_incompatible_or_legacy_peer(
+    monkeypatch, failure,
+):
+    from contextlib import nullcontext
+
+    import torch
+
+    from vllm.distributed.kv_transfer.kv_connector.v1.p2p import p2p_nccl_engine as mod
+
+    local = _metadata([6], [2, 4], 0, tp_rank=1)
+    peer = _metadata([2, 4], [6], 1, tp_rank=1, producer=False)
+    engine = _engine(local)
+    response = {"ret": 0, "metadata": peer, "base_port": 20000}
+    if failure == "rejected":
+        response = {"ret": 1, "error": "incompatible partition"}
+    socket = _Socket(response, ready=failure != "timeout")
+    engine.context = SimpleNamespace(socket=lambda kind: socket)
+    allocations = []
+
+    def unique_id():
+        allocations.append("unique_id")
+        return SimpleNamespace(internal=b"nccl-id")
+
+    engine.nccl = SimpleNamespace(
+        ncclGetUniqueId=unique_id,
+        ncclCommInitRank=lambda *args: "comm",
+    )
+    monkeypatch.setattr(torch.accelerator, "device_index", lambda index: nullcontext())
+    monkeypatch.setattr(mod, "set_p2p_nccl_context", lambda channels: nullcontext())
+    address = "d:20001" if failure == "wrong_port" else "d:20003"
+    if failure:
+        with pytest.raises(ValueError):
+            engine.create_connect(address)
+        assert allocations == []
+        assert engine.socks == {} and engine.comms == {}
+        assert socket.closed
+        assert [item["cmd"] for item in socket.sent] == ["BEAM"]
+    else:
+        assert engine.create_connect(address) == (socket, ("comm", 0))
+        assert socket.sent == [
+            {"cmd": "BEAM", "metadata": local},
+            {"cmd": "NEW", "unique_id": b"nccl-id"},
+        ]
