+"""Later-only real NVIDIA tests; authored without execution or collection.
+
+Set BEAM_RUN_GPU_TESTS=1 on an exclusively owned NVIDIA deployment; also set
+BEAM_GPU_MODEL, BEAM_GPU_TP, BEAM_GPU_PP (comma-separated subset of 1,2,4).
+Optional: BEAM_GPU_REVISION, BEAM_GPU_DTYPE (auto), BEAM_GPU_TOKEN_ID (0).
+Policy tests also require BEAM_GPU_NAME and BEAM_GPU_PROFILE_TP{tp}_PP{pp}, or
+BEAM_GPU_PROFILE_TEMPLATE containing both literal {tp} and {pp} placeholders.
+Profiles must match the actual model/revision, GPU, TP/PP and runner; legacy
+CSVs do not certify topology/calibration. The clock test needs a supported
+BEAM_TEST_CLOCK_MHZ and NVML lock/energy permissions. Reset restores observable
+previous locks or defaults; a cleared cache does not prove exact restoration.
+These tests make no performance, energy-saving, SLO or calibration claims.
+
+Use a target-source v0.23.0 environment with CUDA/PyTorch/NCCL, model/tokenizer
+access, pytest and the parent test dependencies. tests/conftest.py imports
+torch/vLLM before this module's skip gate: collection is NOT hardware-free.
+Run this file serially with at least TP*PP physical non-MIG GPUs per topology.
+Later cancellation scenario (not covered): render inputs with the LLMEngine's
+renderer.render_cmpl, add_request(request_id, prompt, params), step until partial
+output, then abort_request([request_id]); check survivors and settled status.
+Blocking LLM.generate cannot interleave an abort.
+"""
+
+import os
+
+import pytest
+
+pytestmark = pytest.mark.skipif(
+    os.environ.get('BEAM_RUN_GPU_TESTS') != '1',
+    reason='GPU deployment only; never run in static port task',
+)
+
+
+@pytest.fixture(params=[1, 2, 4])
+def gpu_engine(request, monkeypatch):
+    from contextlib import contextmanager
+
+    model, tp, selected = (os.environ.get(key) for key in (
+        'BEAM_GPU_MODEL', 'BEAM_GPU_TP', 'BEAM_GPU_PP'))
+    if not all((model, tp, selected)):
+        pytest.skip('Set BEAM_GPU_MODEL, BEAM_GPU_TP and BEAM_GPU_PP')
+    tp, pp, selected = int(tp), request.param, {int(p) for p in selected.split(',')}
+    assert tp > 0 and selected <= {1, 2, 4}, 'Invalid TP/PP selection'
+    if pp not in selected:
+        pytest.skip(f'PP{pp} not selected in BEAM_GPU_PP')
+    token = int(os.environ.get('BEAM_GPU_TOKEN_ID', '0'))
+    assert token >= 0
+    import torch
+
+    if torch.version.cuda is None or not torch.cuda.is_available():
+        pytest.skip('An NVIDIA CUDA deployment is required')
+    if torch.cuda.device_count() < tp * pp:
+        pytest.skip(f'TP{tp}/PP{pp} needs {tp * pp} visible GPUs')
+    monkeypatch.setenv('VLLM_ENABLE_V1_MULTIPROCESSING', '1')
+    monkeypatch.setenv('VLLM_WORKER_MULTIPROC_METHOD', 'spawn')
+
+    @contextmanager
+    def start(v2=False, asynchronous=False, **options):
+        assert v2 or not asynchronous, 'V1 async is outside this test grid'
+        monkeypatch.setenv('VLLM_USE_V2_MODEL_RUNNER', '1' if v2 else '0')
+        from vllm import LLM
+
+        llm = LLM(
+            model=model, revision=os.environ.get('BEAM_GPU_REVISION'),
+            dtype=os.environ.get('BEAM_GPU_DTYPE', 'auto'), runner='generate',
+            tensor_parallel_size=tp, pipeline_parallel_size=pp,
+            distributed_executor_backend='mp', async_scheduling=asynchronous,
+            seed=0, enforce_eager=True, enable_prefix_caching=False,
+            enable_chunked_prefill=True, long_prefill_token_threshold=0,
+            max_num_batched_tokens=512, max_num_seqs=8, max_model_len=1024,
+            **options,
+        )
+        try:
+            config = llm.llm_engine.vllm_config
+            assert token < config.model_config.get_vocab_size()
+            assert config.use_v2_model_runner is v2
+            assert config.scheduler_config.async_scheduling is asynchronous
+            yield llm
+        finally:
+            llm.llm_engine.engine_core.shutdown()
+
+    return start, tp, pp, token
