+def test_profile_wraps_all_repeats_and_stops_on_generation_failure(tmp_path):
+    # Boundary double: no GPU/model import. Wrong RPC ordering loses all events.
+    calls = []
+
+    class LLM:
+        def collective_rpc(self, method, *, kwargs=None):
+            calls.append((method, kwargs))
+
+        def generate(self, *args, **kwargs):
+            calls.append("generate")
+            if calls.count("generate") == 4:
+                raise RuntimeError("generation failed")
+
+    with pytest.raises(RuntimeError, match="generation failed"):
+        tools.profile_generation(LLM(), [], None, tmp_path, warmup=2, repeats=3)
+    assert calls == [
+        "generate", "generate",
+        ("profile", {"is_start": True, "output_dir": str(tmp_path)}),
+        "generate", "generate", ("profile", {"is_start": False}),
+    ]
+
