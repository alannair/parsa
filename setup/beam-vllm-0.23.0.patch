+@pytest.mark.parametrize("failure", ["execute", "sample", "update"])
+def test_native_failure_releases_driver_requests_but_requires_restart(
+    trial_core, tmp_path, monkeypatch, failure,
+):
+    core = trial_core(pp=2, v2=True)
+    executor = core.model_executor
+    free = core.scheduler.kv_cache_manager.block_pool.get_num_free_blocks()
+    if failure == "execute":
+        executor.fail_measure = True
+    elif failure == "sample":
+        executor.fail_sample = True
+    else:
+        native_update = core.scheduler.update_from_output
+
+        def update(output, model_output):
+            if executor.active and output.total_num_scheduled_tokens:
+                raise RuntimeError("fake native update failed")
+            return native_update(output, model_output)
+
+        monkeypatch.setattr(core.scheduler, "update_from_output", update)
+    with pytest.raises(RuntimeError, match="fake native") as raised:
+        core.beam_profile_trial(3, 1, 5, str(tmp_path))
+    assert not executor.active
+    assert executor.profile_calls[-1][0] is False
+    assert not core.scheduler.requests
+    assert not core.scheduler.finished_req_ids
+    assert core.scheduler.kv_cache_manager.block_pool.get_num_free_blocks() == free
+    assert core.scheduler.beam_profile_admission is None
+    assert core.scheduler.beam_profile_expected is None
+    assert not core._beam_profile_trial_active
+    assert core._beam_profile_unusable
+    report = core._beam_profile_cleanup_report
+    assert report["confirmed"] is False
+    assert report["restart_required"] is True
+    assert report["native_step_failed"] is True
+    assert report["driver_requests_released"] is True
+    assert report["transport_failed"] is False
+    assert report["unresolved_invocations"]
+    assert set(report["unresolved_invocations"]) == set(core.scheduler._beam._invocations)
+    assert "cleanup unconfirmed" in str(raised.value.__cause__)
+    status = core.get_beam_status()["owned_profile"]
+    assert status["unusable"] is True
+    assert status["cleanup"] == report
+    calls = (len(executor.executed), len(executor.profile_calls))
+    with pytest.raises(ValueError, match="restart required"):
+        core.beam_profile_trial(3, 1, 5, str(tmp_path))
+    with pytest.raises(RuntimeError, match="restart required"):
+        core.step()
+    assert calls == (len(executor.executed), len(executor.profile_calls))
+    assert set(report["unresolved_invocations"]) == set(core.scheduler._beam._invocations)
