+@pytest.mark.parametrize("dp", [False, True])
+def test_manual_http_controls_return_real_queued_then_applied_status(monkeypatch, dp):
+    from fastapi.testclient import TestClient
+
+    frontend, cores = _manual_control_frontend(monkeypatch, dp=dp)
+    with TestClient(_app(frontend)) as client:
+        response = client.post("/update_chunk_size", json={"chunk_size": 64})
+        assert response.status_code == 200
+        assert response.json()["status"] == "queued"
+        snapshots = response.json()["engines"] if dp else [response.json()]
+        assert len(snapshots) == (2 if dp else 1)
+        assert all(s["chunk_size"]["requested"] == 64 for s in snapshots)
+        cores["rank0"].step()  # real empty execute/retire consumes the boundary
+        if dp:
+            partial = client.get("/beam_status").json()
+            assert partial["status"] == "queued"
+            assert partial["engines"][0]["chunk_size"]["effective"] == 64
+            assert partial["engines"][1]["chunk_size"]["pending"] is True
+            assert partial["engines"][1]["chunk_size"]["effective"] == 512
+            cores["rank1"].step()
+        applied = client.get("/beam_status").json()
+        snapshots = applied["engines"] if dp else [applied]
+        assert applied["status"] == "applied"
+        assert all(s["chunk_size"]["effective"] == 64 for s in snapshots)
+        clear = client.post("/update_chunk_size", json={"clear": True})
+        assert clear.status_code == 200
+        snapshots = clear.json()["engines"] if dp else [clear.json()]
+        assert all(s["chunk_size"]["manual"] is False for s in snapshots)
+        m = client.post("/update_microbatch_size", json={"microbatch_size": 1})
+        assert m.status_code == 200
+        assert m.json()["status"] == "queued"
+        assert all(core.scheduler._beam.manual_microbatch_size == 1
+                   for core in cores.values())
