+def run_case(args):
+    """Later-only local server lifecycle, used for each explicit campaign case."""
+    from contextlib import ExitStack
+    from benchmarks.energy.backend_request_func import collective_rpc
+    from benchmarks.energy.benchmark_script import benchmark_case, live_control_options
+
+    for name in ("tp", "pp", "max_num_seqs", "max_model_len"):
+        if getattr(args, name) < 1:
+            raise ValueError(f"{name} must be positive")
+    positive(args.ready_timeout, "ready_timeout")
+    provenance = check_target(args.artifact_root)
+    for name in ("profile", "dynamo_profile"):
+        value = getattr(args, name)
+        if value:
+            path = Path(value)
+            if not path.is_absolute():
+                path = artifact_path(args.artifact_root, value)
+            setattr(args, name, str(path.resolve(strict=True)))
+    references = [input_reference(path)
+                  for path in (args.profile, args.dynamo_profile) if path]
+    if args.trace:
+        references.append(input_reference(artifact_path(args.artifact_root, args.trace)))
+    if args.requests:
+        references.append(input_reference(args.requests))
+    directory = Path(args.output).resolve()
+    directory.mkdir(parents=True, exist_ok=False)
+    options = engine_options(args.mode, profile=args.profile,
+                             dynamo_profile=args.dynamo_profile, gpu_name=args.gpu_name,
+                             fidelity=args.fidelity, budget=args.budget,
+                             ttft=args.ttft, tbt=args.tbt, tpot=args.tpot,
+                              s1_policy=args.s1_policy)
+    live_control_options(args, options["max_num_batched_tokens"])
+    options.update(tensor_parallel_size=args.tp, pipeline_parallel_size=args.pp,
+                   custom_profiler=True, beam_log_dir=str(directory / "worker"),
+                   enable_prefix_caching=False, enable_chunked_prefill=True,
+                   max_num_seqs=args.max_num_seqs, max_model_len=args.max_model_len,
+                   port=args.port, host="127.0.0.1", async_scheduling=False,
+                   distributed_executor_backend="mp",
+                   worker_extension_cls="benchmarks.energy.worker_tools.BeamToolWorker",
+                   middleware=["benchmarks.energy.worker_tools.BeamToolsAuthMiddleware"])
+    command = serve_command(args.vllm_bin, args.model, options)
+    if args.mode == "B" and (not args.clock or len(args.device_uuids) != args.tp * args.pp
+                              or len(set(args.device_uuids)) != args.tp * args.pp):
+        raise ValueError("B needs --clock and one unique --device-uuids per TP/PP rank")
+    if args.mode == "B":
+        devices = rank_device_map(
+            {str(i): uuid for i, uuid in enumerate(args.device_uuids)}, args.tp * args.pp)
+        args.device_uuids = list(devices.values())
+    if args.mode != "B" and (args.clock or args.device_uuids):
+        raise ValueError("fixed clock/UUID options apply only to B")
+    base_url = f"http://127.0.0.1:{args.port}"
+    opener = build_opener(ProxyHandler({}))
+    # A live endpoint of ANY status means another process owns this port.
+    try:
+        with opener.open(base_url + "/health", timeout=1):
+            raise ValueError("port already serves an HTTP endpoint")
+    except HTTPError as error:
+        raise ValueError("port already serves an HTTP endpoint") from error
+    except URLError:
+        pass
+    write_json(directory / "manifest.json", {**provenance, "command": command,
+                "case": vars(args), "inputs": references,
+                "comparison_cohort": run_cohort(args),
+                "energy_scope": "each worker profile window"})
+    with ExitStack() as stack:
+        token = secrets.token_urlsafe(32)
+        stack.enter_context(client_auth(token))
+        environment = harness_environment(token)
+        log = stack.enter_context((directory / "server.log").open("x"))
+        process = subprocess.Popen(command, cwd=ROOT, env=environment,
+                                   stdout=log, stderr=log)
+        clock_attempted = False
+        actual_devices = None
+        try:
+            deadline = time.monotonic() + args.ready_timeout
+            while True:
+                if process.poll() is not None:
+                    raise RuntimeError("vllm server exited; inspect server.log")
+                try:
+                    with opener.open(base_url + "/health", timeout=1):
+                        break
+                except URLError:
+                    if time.monotonic() >= deadline:
+                        raise TimeoutError("server readiness timeout")
+                    time.sleep(1)
+            identities = collective_rpc(base_url, "beam_tools_identity")
+            actual_devices = rank_device_map(
+                {str(row["rank"]): row["uuid"] for row in identities}, args.tp * args.pp)
+            write_json(directory / "devices.json", actual_devices)
+            if args.mode == "B":
+                if actual_devices != devices:
+                    raise ValueError("assigned worker UUID map differs from --device-uuids")
+                clock_attempted = True
+                collective_rpc(base_url, "beam_tools_clock", {"request": json.dumps({
+                    "devices": devices, "clock": args.clock,
+                })})
+            benchmark_case(args, base_url, directory)
+            from benchmarks.energy.analysis import power_window, visualize_run
+
+            data = json.loads((directory / "result.json").read_text())
+            summary = summarize_profile(directory / "worker", expected_ranks=args.tp * args.pp,
+                                        rank_devices=actual_devices)
+            evaluation = {"profile": summary, "fidelity": fidelity_metrics(data)}
+            if args.monitor_seconds >= 30:
+                evaluation["first_30s"] = power_window(data["monitor_samples"])
+            write_json(directory / "evaluation.json", evaluation)
+            visualize_run(directory, directory / "plots")
+        finally:
+            try:
+                if clock_attempted and process.poll() is None:
+                    collective_rpc(base_url, "beam_tools_clock", {"request": json.dumps({
+                        "devices": actual_devices, "clock": None,
+                    })})
+            finally:
+                process.terminate()
+                try:
+                    process.wait(timeout=60)
+                except subprocess.TimeoutExpired:
+                    process.kill()
+                    process.wait()
+    return directory
+
