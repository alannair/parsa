+def main(argv=None):
+    args = parser().parse_args(argv)
+    if args.command == "offline-profile":
+        offline(args)
+    elif args.command == "run":
+        run_case(args)
+    elif args.command == "campaign":
+        campaign(args)
+    elif args.command == "pipeline":
+        pipeline(args)
+    elif args.command == "dynamo-sweep":
+        dynamo_sweep(args)
+    elif args.command == "dynamo-merge":
+        merge_dynamo(args.inputs, args.output, duplicates=args.duplicates)
+    elif args.command == "generation-grid":
+        generation_grid(args)
+    elif args.command == "mixed-profile":
+        from benchmarks.energy import mixed_profile
+
+        mixed_profile.run(args)
+    elif args.command in ("visualize", "compare", "heatmap", "overhead", "monitor", "clock-overhead"):
+        from benchmarks.energy import analysis
+
+        if args.command == "visualize":
+            analysis.visualize_run(args.run, args.output)
+        elif args.command == "compare":
+            analysis.compare_runs(args.runs, args.output,
+                dict(value.split(":") for value in args.objectives),
+                artifact_filters=args.artifact_filters)
+        elif args.command == "overhead":
+            analysis.algorithm_overhead(args.output, trials=args.trials,
+                warmup=args.warmup, pp=args.pp, profile=args.profile,
+                gpu_name=args.gpu_name, model_name=args.model_name)
+        elif args.command == "monitor":
+            analysis.monitor_server(args.base_url, args.output, seconds=args.seconds,
+                                     interval=args.interval)
+        elif args.command == "clock-overhead":
+            analysis.clock_overhead(args.base_url, args.output,
+                json.loads(Path(args.devices).read_text()), args.clocks,
+                trials=args.trials, settle=args.settle)
+        else:
+            directory = Path(args.output)
+            directory.mkdir(parents=True, exist_ok=False)
+            if (args.tp is None) != (args.pp is None):
+                raise ValueError("heatmap needs both --tp and --pp or neither")
+            topology = (args.tp, args.pp) if args.tp is not None else None
+            for name, grid in analysis.profile_grids(args.profile, topology=topology).items():
+                analysis.heatmap_svg(grid, directory / (name + ".svg"), name)
+    elif args.command == "evaluate":
+        data = json.loads(Path(args.result).read_text())
+        evaluation = {"fidelity": fidelity_metrics(data, alignment=args.alignment)}
+        if args.profile_dir:
+            mapping = (json.loads(Path(args.rank_devices).read_text())
+                       if args.rank_devices else None)
+            evaluation["profile"] = summarize_profile(
+                args.profile_dir, expected_ranks=args.ranks, rank_devices=mapping)
+        write_json(args.output, evaluation)
+        if args.svg:
+            fidelity_svg(data, args.svg)
+    elif args.command == "dynamo-collect":
+        summary = json.loads(Path(args.summary).read_text())
+        row = dynamo_row(json.loads(Path(args.result).read_text()),
+                         summary.get("profile", summary), clock=args.clock,
+                           tp=args.tp, pp=args.pp, tps=args.tps,
+                          time_limit=positive(args.time_limit, "time_limit"),
+                          power_mode=args.power_mode, power_seconds=args.power_seconds)
+        write_dynamo(args.output, [row])
+        write_json(str(args.output) + ".metadata.json", {
+            "power_mode": args.power_mode, "power_seconds": args.power_seconds,
+            "latency_seconds": args.time_limit,
+            "inputs": [input_reference(args.result), input_reference(args.summary)],
+        })
+
+
+if __name__ == "__main__":
+    main()
