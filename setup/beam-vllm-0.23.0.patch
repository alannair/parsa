+
+def _processor(kind="DELTA", queue=None, stream_interval=1):
+    from vllm.sampling_params import RequestOutputKind, SamplingParams
+    from vllm.v1.engine import EngineCoreRequest
+    from vllm.v1.engine.output_processor import OutputProcessor
+
+    request = EngineCoreRequest(
+        request_id="r", external_req_id="external", prompt_token_ids=[1, 2],
+        mm_features=None, sampling_params=SamplingParams(
+            detokenize=False, output_kind=getattr(RequestOutputKind, kind)
+        ),
+        pooling_params=None, arrival_time=0, lora_request=None,
+        cache_salt=None, data_parallel_rank=None,
+    )
+    processor = OutputProcessor(None, log_stats=False, stream_interval=stream_interval)
+    processor.add_request(request, prompt="prompt", queue=queue)
+    return processor
+
+
+@pytest.mark.parametrize("kind", ["DELTA", "CUMULATIVE", "FINAL_ONLY"])
+def test_engine_output_roundtrip_and_cumulative_estimates(kind):
+    import msgspec
+    from vllm.v1.engine import EngineCoreOutput, FinishReason
+
+    processor = _processor(kind)
+    first = EngineCoreOutput(
+        request_id="r", new_token_ids=[10], estimated_ttft=1.25, estimated_tbts=[]
+    )
+    first = msgspec.msgpack.decode(msgspec.msgpack.encode(first), type=EngineCoreOutput)
+    output = processor.process_outputs([first]).request_outputs
+    if kind == "FINAL_ONLY":
+        assert output == []
+    else:
+        assert output[0].outputs[0].estimated_ttft == 1.25
+        assert output[0].outputs[0].estimated_tbts == []
+    estimates = [0.2]
+    final = EngineCoreOutput(
+        request_id="r", new_token_ids=[11, 12], finish_reason=FinishReason.LENGTH,
+        estimated_tbts=estimates,
+    )
+    result = processor.process_outputs([final]).request_outputs[0]
+    completion = result.outputs[0]
+    assert result.finished and not processor.has_unfinished_requests()
+    assert completion.estimated_ttft == 1.25
+    assert completion.estimated_tbts == [0.2]
+    assert list(completion.token_ids) == ([11, 12] if kind == "DELTA" else [10, 11, 12])
+    estimates.append(99.0)
+    assert completion.estimated_tbts == [0.2]
+    if output:
+        assert output[0].outputs[0].estimated_tbts == []
+
+
+def test_delta_collector_replaces_snapshots_and_abort_keeps_metadata():
+    from vllm.sampling_params import RequestOutputKind
+    from vllm.v1.engine import EngineCoreOutput
+    from vllm.v1.engine.output_processor import RequestOutputCollector
+
+    queue = RequestOutputCollector(RequestOutputKind.DELTA, "r")
+    processor = _processor(queue=queue)
+    processor.process_outputs([EngineCoreOutput(
+        request_id="r", new_token_ids=[10], estimated_ttft=1.0, estimated_tbts=[]
+    )])
+    processor.process_outputs([EngineCoreOutput(
+        request_id="r", new_token_ids=[11], estimated_tbts=[0.2]
+    )])
+    processor.process_outputs([EngineCoreOutput(
+        request_id="r", new_token_ids=[12], estimated_tbts=[0.2, 0.3]
+    )])
+    merged = queue.get_nowait()
+    assert list(merged.outputs[0].token_ids) == [10, 11, 12]
+    assert merged.outputs[0].estimated_ttft == 1.0
+    assert merged.outputs[0].estimated_tbts == [0.2, 0.3]
+    processor.abort_requests(["external"], internal=False)
+    aborted = queue.get_nowait()
+    assert aborted.finished
+    assert aborted.outputs[0].estimated_tbts == [0.2, 0.3]
+    # Late scheduler results must not revive an aborted request.
+    assert not processor.process_outputs([EngineCoreOutput(
+        request_id="r", new_token_ids=[13], estimated_tbts=[99.0]
+    )]).request_outputs
+
+
+def test_stream_interval_does_not_drop_estimate_snapshots():
+    from vllm.v1.engine import EngineCoreOutput, FinishReason
+
+    processor = _processor(stream_interval=3)
+    processor.process_outputs([EngineCoreOutput(request_id="r", new_token_ids=[10])])
+    assert not processor.process_outputs([EngineCoreOutput(
+        request_id="r", new_token_ids=[11], estimated_ttft=1.0, estimated_tbts=[0.2]
+    )]).request_outputs
+    result = processor.process_outputs([EngineCoreOutput(
+        request_id="r", new_token_ids=[12], finish_reason=FinishReason.LENGTH,
+        estimated_tbts=[0.2, 0.3],
+    )]).request_outputs[0]
+    assert result.outputs[0].estimated_ttft == 1.0
+    assert result.outputs[0].estimated_tbts == [0.2, 0.3]
+
