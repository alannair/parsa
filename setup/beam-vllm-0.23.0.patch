+def test_http_adapter_handles_sse_comments_multiline_frames_and_truncation():
+    # Exercise wire framing/payload construction; only the network is replaced.
+    wire = (
+        b': ping\r\n\r\ndata: {"choices":\r\n'
+        b'data: [{"text":"a","finish_reason":null}]}\r\n\r\n'
+        b'data: {"choices":[],"usage":{"completion_tokens":1}}\r\n\r\n'
+        b'data: [DONE]\r\n\r\n'
+    )
+
+    class Opener:
+        def __init__(self, body):
+            self.body = body
+            self.payloads = []
+
+        def open(self, req, timeout):
+            self.payloads.append(json.loads(req.data))
+            response = io.BytesIO(self.body)
+            response.status = 200
+            return response
+
+    opener = Opener(wire)
+    with patch.object(backend, "build_opener", return_value=opener):
+        result = backend.request("http://localhost:8000", "model", [1, 2], 1)
+    assert result["success"] is True
+    assert result["output_tokens"] == 1
+    assert result["generated_text"] == "a"
+    assert opener.payloads[0]["prompt"] == [1, 2]
+    assert opener.payloads[0]["stream_options"] == {"include_usage": True}
+    assert opener.payloads[0]["return_token_ids"] is True
+    with patch.object(backend, "build_opener", return_value=Opener(wire[:-18])):
+        assert backend.request("http://localhost:8000", "model", [1], 1)["success"] is False
+
