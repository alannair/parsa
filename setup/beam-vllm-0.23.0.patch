+    )
+    assert (chosen.num_microbatches, chosen.clock, chosen.feasible) == (2, 1050, True)
+    fallback = choose_s2(
+        model, num_running=2, total_ctx_len=200, tbt_slo=0.001, fixed_m=1,
+    )
+    assert (fallback.num_microbatches, fallback.clock, fallback.feasible) == (
+        1, 1410, False,
+    )
+    for value in (0, 3):
+        with pytest.raises(ValueError):
+            choose_s2(model, num_running=2, total_ctx_len=200, tbt_slo=1, fixed_m=value)
