+@pytest.mark.parametrize('v2,asynchronous', [(False, False), (True, False), (True, True)])
+def test_gpu_greedy_tokens_match_vanilla(
+    gpu_engine, policy_profile, v2, asynchronous,
+):
+    start, _, _, token = gpu_engine
+    golden = None
+    for s1, s2 in ((False, False), (True, False), (False, True), (True, True)):
+        options = policy_profile if s1 or s2 else {}
+        with start(v2, asynchronous, use_s1=s1, use_s2=s2, **options) as llm:
+            actual = _generate(llm, token)
+        if golden is None:
+            golden = actual
+        else:
+            assert actual == golden, f'Greedy output changed: S1={s1}, S2={s2}'
