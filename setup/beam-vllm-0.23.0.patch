+class EnergyProfile:
+    """Deterministic profile boundary; allocation and scheduling stay real."""
+
+    available_chunk_sizes = [64, 128, 256, 512]
+    profiled_batch_sizes = [64, 128, 256, 512, 1024]
+    available_clocks = [1050, 1410]
+    default_clock = 1050
+    default_clock_high = 1410
+    default_chunk_size = 128
+    scheduling_overhead = 0.012
+
+    def __init__(self, path, num_pp, num_tp, **kwargs):
+        self.num_pp = num_pp
+        self.scheduling_overhead_decode_only = 0.003 * num_pp
+
+    def get_time_taken(self, batch_size, clock, total_ctx_len=None):
+        return batch_size / 10000 if batch_size else 0.0
+
+    def get_energy(self, batch_size, clock):
+        return batch_size * clock / 1050
