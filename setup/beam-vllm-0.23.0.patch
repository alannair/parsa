+def enable_beam(scheduler, monkeypatch, **flags):
+    # The shared fixture has no BEAM arguments. Attach after its real upstream
+    # initialization, the same seam used by Scheduler.__init__ in production.
+    parallel = scheduler.parallel_config
+    for name, value in flags.items():
+        setattr(parallel, name, value)
+    parallel.beam_profile_path = "unused.csv"
+    parallel.beam_gpu_name = "A100"
+    if parallel.use_window_based_dvfs_only and parallel.beam_dynamo_profile_path is None:
+        parallel.beam_dynamo_profile_path = "unused-dynamo.csv"
+    monkeypatch.setattr(beam_module, "EnergySimulator", EnergyProfile)
+    monkeypatch.setattr(
+        beam_module, "choose_s1",
+        lambda *args, **kwargs: S1Decision(128, 1410, 1.0, 0.12, 1.0, True),
+    )
+    monkeypatch.setattr(
+        beam_module, "choose_s2",
+        lambda model, **kwargs: S2Decision(
+            kwargs.get("fixed_m") or model.num_pp, 1050, 0.1, 1.0, True,
+        ),
+    )
+    scheduler._beam = beam_module.BeamScheduler(scheduler)
+    return scheduler._beam
+
+
+def runner_output(output, tokens=None):
+    ids = list(output.num_scheduled_tokens)
+    if tokens is None:
+        tokens = {rid: [7] for rid in output.beam_sampling_req_ids}
+    return ModelRunnerOutput(
+        req_ids=ids,
+        req_id_to_index={rid: i for i, rid in enumerate(ids)},
+        sampled_token_ids=[tokens.get(rid, []) for rid in ids],
+        logprobs=None,
+        prompt_logprobs_dict={},
+        pooler_output=[],
+    )
+
+
+def retire(scheduler, output, tokens=None):
+    return scheduler.update_from_output(output, runner_output(output, tokens))
+
