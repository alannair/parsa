+def distribution(values):
+    return {"trials": len(values), "mean_ms": statistics.mean(values),
+            "min_ms": min(values), "max_ms": max(values),
+            "std_ms": statistics.pstdev(values),
+            **{f"p{p}_ms": percentile(values, p / 100) for p in (50, 95, 99)}}
+
