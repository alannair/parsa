--- /dev/null
+++ b/vllm/v1/core/sched/beam_policy.py
@@ -0,0 +1,267 @@
+# Copyright (C) 2026 M.R. Siavash Katebzadeh <mr@katebzadeh.xyz>
+#
+# This program is free software: you can redistribute it and/or modify
+# it under the terms of the GNU General Public License as published by
+# the Free Software Foundation, either version 3 of the License, or
+# (at your option) any later version.
+#
+# This program is distributed in the hope that it will be useful,
+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License
+# along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+# Adapted formulas from BEAM-artifact/vllm/v1/core/sched/scheduler.py:611-831.
+# Original portions: SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+"""Pure BEAM candidate selectors; estimates are not runtime SLO guarantees."""
+
+from dataclasses import dataclass, replace
+
+from .energy_model import EnergySimulator, _integer, _number
+
+
+@dataclass
+class S1Decision:
+    chunk_size: int
+    clock: int
+    ttft: float
+    tbt: float
+    energy: float
+    feasible: bool
+
+
+@dataclass
+class S2Decision:
+    num_microbatches: int
+    clock: int
+    tbt: float
+    energy: float
+    feasible: bool
+
+
+def _chunks(
+    model: EnergySimulator, sizes: list[int] | None, cap: int | None, running: int = 0
+) -> list[int]:
+    sizes = model.available_chunk_sizes if sizes is None else sizes
+    chunks = sorted({_integer(size, "chunk_size", positive=True) for size in sizes})
+    chunks = [size for size in chunks
+              if (cap is None or size <= cap) and size > running // model.num_pp]
+    if not chunks:
+        raise ValueError("No eligible S1 chunk sizes within capacity/budget")
+    return chunks
+
+
+def _fallback_chunk(chunks: list[int], preferred: int) -> int:
+    # Retain the historical choice if eligible, otherwise respect the caller's
+    # budget/subset: largest <= preferred, or the smallest eligible larger size.
+    return max((size for size in chunks if size <= preferred), default=chunks[0])
+
+
+def _s1_estimate(
+    model: EnergySimulator, chunk: int, clock: int, prefill: int, running: int,
+    queue_time: float,
+) -> S1Decision:
+    pp = model.num_pp
+    if chunk >= prefill:
+        latency = model.get_time_taken(prefill, clock)
+        energy = model.get_energy(prefill, clock) * pp
+        tbt = (latency + model.scheduling_overhead) * pp
+        ttft = tbt + queue_time
+    else:
+        latency = model.get_time_taken(chunk, clock)
+        per_chunk_energy = model.get_energy(chunk, clock)
+        full_chunks = prefill // (chunk - running // pp)
+        # Deliberately retain the original remainder modulo chunk, not capacity.
+        remainder = prefill % chunk
+        tbt = (latency + model.scheduling_overhead) * pp
+        ttft = ((full_chunks + pp - 1) * (latency + model.scheduling_overhead)
+                + model.get_time_taken(remainder, clock) + queue_time)
+        energy = (per_chunk_energy * full_chunks * pp
+                  + model.get_energy(remainder, clock) * pp)
+    return S1Decision(chunk, clock, ttft, tbt, energy, False)
+
+
+def choose_s1(
+    model: EnergySimulator,
+    *,
+    prefill_tokens: int,
+    num_running: int,
+    tbt_slo: float,
+    ttft_slo: float,
+    queue_time: float = 0.0,
+    dvfs_only: bool = False,
+    disagg: bool = False,
+    max_chunk_size: int | None = None,
+    chunk_sizes: list[int] | None = None,
+) -> S1Decision:
+    """Minimize original S1 energy among jointly feasible chunk/clock pairs.
+
+    Times/SLOs are seconds and energy is joules. queue_time is supplied elapsed
+    time, never read from a wall clock. DVFS-only overrides chunk_sizes with
+    [256], still subject to capacity and max_chunk_size. Explicit chunk_sizes
+    can carry an orchestrator's adjacent-chunk restriction. Positive work with
+    no eligible chunks raises ValueError; no prefill returns chunk=0 and zero
+    metrics at default_clock (even with no candidate chunks).
+
+    Nonpositive chunk - num_running//PP is excluded before either formula.
+    Single/multi-chunk formulas otherwise retain artifact behavior. With no
+    joint choice, use 128/high if no TBT choice, 256/high if no TTFT choice
+    (TTFT takes precedence), and explicitly 256/high if separate choices pass
+    but none pass jointly. Map fallback chunks into the eligible set. Fallback
+    TTFT retains the original ceiling/full-chunk estimate, adding queue_time;
+    TBT/energy describe the selected pair. All fallbacks are infeasible.
+    """
+    prefill_tokens = _integer(prefill_tokens, "prefill_tokens")
+    num_running = _integer(num_running, "num_running")
+    tbt_slo = _number(tbt_slo, "tbt_slo", positive=True)
+    ttft_slo = _number(ttft_slo, "ttft_slo", positive=True)
+    queue_time = _number(queue_time, "queue_time")
+    if max_chunk_size is not None:
+        max_chunk_size = _integer(max_chunk_size, "max_chunk_size", positive=True)
+    if prefill_tokens == 0:
+        return S1Decision(0, model.default_clock, 0.0, 0.0, 0.0, True)
+    chunks = _chunks(model, [256] if dvfs_only else chunk_sizes,
+                     max_chunk_size, num_running)
+    best = None
+    has_tbt = has_ttft = False
+    for chunk in chunks:
+        for clock in model.available_clocks:
+            candidate = _s1_estimate(model, chunk, clock, prefill_tokens,
+                                     num_running, queue_time)
+            tbt_ok = disagg or candidate.tbt <= tbt_slo
+            ttft_ok = candidate.ttft <= ttft_slo
+            has_tbt |= tbt_ok
+            has_ttft |= ttft_ok
+            if (tbt_ok and ttft_ok
+                    and (best is None or candidate.energy < best.energy)):
+                best = replace(candidate, feasible=True)
+    if best is not None:
+        return best
+    preferred = 256 if not has_ttft or has_tbt else 128
+    chunk = _fallback_chunk(chunks, preferred)
+    clock = model.default_clock_high
+    candidate = _s1_estimate(model, chunk, clock, prefill_tokens, num_running, queue_time)
+    num_ttft_chunks = (prefill_tokens + chunk - 1) // chunk + model.num_pp - 1
+    ttft = num_ttft_chunks * (model.get_time_taken(chunk, clock)
+                              + model.scheduling_overhead) + queue_time
+    return replace(candidate, ttft=ttft, feasible=False)
+
+
+def choose_s2(
+    model: EnergySimulator, *, num_running: int, total_ctx_len: int, tbt_slo: float,
+    fixed_m: int | None = None,
+) -> S2Decision:
+    """Minimize m * energy(ceil(n/m)) for m=1..physical PP and each clock.
+
+    Context is total_ctx_len/m, without integer rounding. TBT in seconds is
+    (latency + .003*PP)*PP, independent of m's cadence. No feasible choice uses
+    physical PP/default_clock_high, marked infeasible. No running requests
+    returns m=0/default_clock with zero metrics; callers must treat m=0 as idle.
+    Equal energies retain the first candidate (ascending m, then clock).
+    fixed_m restricts only the m candidates, retaining the clock objective.
+    Its infeasible fallback retains that m at the high clock; idle retains m
+    with zero metrics. Without fixed_m the original automatic behavior remains.
+    """
+    num_running = _integer(num_running, "num_running")
+    total_ctx_len = _integer(total_ctx_len, "total_ctx_len")
+    tbt_slo = _number(tbt_slo, "tbt_slo", positive=True)
+    if fixed_m is not None:
+        fixed_m = _integer(fixed_m, "fixed_m", positive=True)
+        if fixed_m > model.num_pp:
+            raise ValueError("fixed_m must not exceed physical PP")
+    if num_running == 0:
+        return S2Decision(fixed_m or 0, model.default_clock, 0.0, 0.0, True)
+
+    def estimate(m: int, clock: int) -> S2Decision:
+        batch = (num_running + m - 1) // m
+        latency = model.get_time_taken(batch, clock, total_ctx_len / m)
+        tbt = (latency + model.scheduling_overhead_decode_only) * model.num_pp
+        energy = model.get_energy(batch, clock) * m
+        return S2Decision(m, clock, tbt, energy, tbt <= tbt_slo)
+
+    best = None
+    for m in ([fixed_m] if fixed_m is not None else range(1, model.num_pp + 1)):
+        for clock in model.available_clocks:
+            candidate = estimate(m, clock)
+            if candidate.feasible and (best is None or candidate.energy < best.energy):
+                best = candidate
+    if best is not None:
+        return best
+    return replace(estimate(fixed_m or model.num_pp, model.default_clock_high),
+                   feasible=False)
+
+
+def choose_s1_tpot(
+    model: EnergySimulator,
+    *,
+    histories: list[list[float]],
+    tpot_slo: float,
+    ttft_slo: float,
+    prefill_tokens: int,
+    max_chunk_size: int | None = None,
+    remaining_prefill_time: float = 0.0,
+) -> S1Decision:
+    """Preserve dormant S1-immediate TPOT selection with explicit time inputs.
+
+    Histories contain output-token TBT durations in seconds. Use the first
+    request with the largest positive sum and the original interrupt count
+    and denominator len(history)+interrupts-1. For this variant only, the
+    returned tbt field is projected TPOT, the metric constrained by tpot_slo.
+    remaining_prefill_time supplies max(0, previous TTFT - elapsed), preserving
+    the original overlap rule without consulting or modifying a clock/state.
+
+    No positive history uses the default chunk/clock with tbt=0 (unavailable
+    TPOT estimate), feasible=False. No joint choice also uses default chunk/
+    clock, marked infeasible. Fallback chunks respect max_chunk_size; no
+    eligible chunk for positive work raises ValueError. Fallback TTFT retains
+    the original ceiling/full-chunk formula without overlap moderation.
+    No prefill is idle.
+    """
+    prefill_tokens = _integer(prefill_tokens, "prefill_tokens")
+    tpot_slo = _number(tpot_slo, "tpot_slo", positive=True)
+    ttft_slo = _number(ttft_slo, "ttft_slo", positive=True)
+    remaining_prefill_time = _number(remaining_prefill_time, "remaining_prefill_time")
+    if max_chunk_size is not None:
+        max_chunk_size = _integer(max_chunk_size, "max_chunk_size", positive=True)
+    largest_sum = 0.0
+    history_length = 0
+    for history in histories:
+        total = _number(sum(_number(value, "history TBT") for value in history),
+                        "history TBT sum")
+        if total > largest_sum:
+            largest_sum, history_length = total, len(history)
+    if prefill_tokens == 0:
+        return S1Decision(0, model.default_clock, 0.0, 0.0, 0.0, True)
+    chunks = _chunks(model, None, max_chunk_size)
+
+    def estimate(chunk: int, clock: int, *, overlap: bool = True) -> S1Decision:
+        latency = model.get_time_taken(chunk, clock)
+        count = (prefill_tokens + chunk - 1) // chunk
+        ttft_chunks = count + model.num_pp - 1
+        interrupts = (ttft_chunks + model.num_pp - 1) // model.num_pp
+        denominator = history_length + interrupts - 1
+        tpot = ((largest_sum + interrupts * latency) / denominator
+                if history_length and denominator > 0 else 0.0)
+        ttft = ttft_chunks * (latency + model.scheduling_overhead)
+        if overlap and remaining_prefill_time > 0:
+            ttft = max(ttft, remaining_prefill_time + latency)
+        energy = model.get_energy(chunk, clock) * count * model.num_pp
+        feasible = history_length > 0 and tpot <= tpot_slo and ttft <= ttft_slo
+        return S1Decision(chunk, clock, ttft, tpot, energy, feasible)
+
+    best = None
+    if history_length:
+        for chunk in chunks:
+            for clock in model.available_clocks:
+                candidate = estimate(chunk, clock)
+                if (candidate.feasible
+                        and (best is None or candidate.energy < best.energy)):
+                    best = candidate
+    if best is not None:
+        return best
+    chunk = _fallback_chunk(chunks, model.default_chunk_size)
+    return replace(estimate(chunk, model.default_clock, overlap=False), feasible=False)
