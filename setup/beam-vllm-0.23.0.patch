diff --git a/benchmarks/energy/mixed_profile.py b/benchmarks/energy/mixed_profile.py
new file mode 100644
index 0000000000000000000000000000000000000000..7a7337cff2bfb53309364bdac422f86cf68c5958
--- /dev/null
+++ b/benchmarks/energy/mixed_profile.py
@@ -0,0 +1,245 @@
+# Copyright (C) 2026 M.R. Siavash Katebzadeh <mr@katebzadeh.xyz>
+#
+# This program is free software: you can redistribute it and/or modify
+# it under the terms of the GNU General Public License as published by
+# the Free Software Foundation, either version 3 of the License, or
+# (at your option) any later version.
+#
+# This program is distributed in the hope that it will be useful,
+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License
+# along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+"""Grid client for the target EngineCore.beam_profile_trial owned-request API.
+
+Replaces the BEAM-artifact 0febb08 offline_profile.py/test_offline_profile_new.py
+private dummy-run drivers (Apache-2.0, copyright vLLM contributors). Uses the
+current owned-native-request helper's explicit window-energy schema; never
+manufactures legacy EnergySimulator calibration rows from counter windows.
+"""
+
+import csv
+import json
+import statistics
+from itertools import product
+from pathlib import Path
+
+from benchmarks.energy.beam_tools import (
+    check_target,
+    rank_device_map,
+    summarize_profile,
+    worker_clock,
+    worker_identity,
+    write_json,
+)
+
+TRIAL_SCHEMA = "beam_owned_mixed_window_v1"
+ENERGY_LABEL = "window_amortized_not_legacy_per_forward"
+
+
+def call_owned_trial(client, prefill, decode, context, directory, token_id):
+    """Dispatch to the engine owner, NEVER to LLM.collective_rpc workers."""
+    arguments = (prefill, decode, context, str(directory), token_id)
+    if callable(getattr(client, "call_utility", None)):
+        return client.call_utility("beam_profile_trial", *arguments)
+    core = getattr(client, "engine_core", None)
+    if callable(getattr(core, "beam_profile_trial", None)):
+        return core.beam_profile_trial(*arguments)
+    raise TypeError("mixed profiling requires a synchronous core utility or InprocClient")
+
+
+def summarize_owned_result(result, requested, parent, *, expected_ranks, rank_devices):
+    if (result.get("schema_id") != TRIAL_SCHEMA
+            or result.get("energy_label") != ENERGY_LABEL
+            or result.get("legacy_lookup_compatible") is not False
+            or result.get("calibration_claim") is not False):
+        raise ValueError("owned trial returned an unknown measurement-domain contract")
+    record = {"schema_id": TRIAL_SCHEMA, "energy_label": ENERGY_LABEL,
+              "legacy_lookup_compatible": False, "calibration_claim": False,
+              "requested": requested, "observed": result.get("observed"),
+              "output_dir": result.get("output_dir"),
+              "logical_forward_count": result.get("actual_forward_count"),
+              "disposition": "skipped", "reasons": list(result.get("errors", []))}
+    if result.get("status") == "mismatch":
+        return record
+    if result.get("status") != "ok":
+        raise ValueError("owned trial status must be ok or mismatch")
+    actual = result.get("observed")
+    if (record["reasons"] or result.get("requested") != requested
+            or not isinstance(actual, dict)
+            or any(actual.get(key) != value for key, value in requested.items())
+            or type(result.get("actual_forward_count")) is not int
+            or result["actual_forward_count"] != 1):
+        record["reasons"].append("core result does not verify the requested logical forward")
+        return record
+    prefill, decode, context = (requested[key] for key in (
+        "prefill_tokens", "decode_tokens", "total_ctx_len"))
+    quotient, remainder = divmod(context, decode) if decode else (0, 0)
+    contexts = [quotient + 1] * remainder + [quotient] * (decode - remainder)
+    if (result.get("requested_decode_context_lengths") != contexts
+            or sorted(actual.get("decode_context_lengths", [])) != sorted(contexts)
+            or actual.get("total_num_scheduled_tokens") != prefill + decode):
+        record["reasons"].append("observed decode contexts/token coordinates differ")
+        return record
+    directory = Path(result["output_dir"]).resolve()
+    parent = Path(parent).resolve()
+    if directory == parent or not directory.is_relative_to(parent):
+        raise ValueError("owned trial output directory escapes its unique attempt directory")
+    profile = summarize_profile(directory, expected_ranks=expected_ranks,
+                                rank_devices=rank_devices)
+    for rank in profile["ranks"]:
+        with (directory / f"batch_log_GPU_{rank}.csv").open(newline="") as source:
+            rows = list(csv.DictReader(source))
+        if (len(rows) != 1
+                or int(rows[0]["num_scheduled_tokens"]) != prefill + decode
+                or int(rows[0]["num_reqs"]) != decode + int(prefill > 0)):
+            record["reasons"].append(f"rank {rank} worker CSV differs from exact coordinates")
+            return record
+        profile["ranks"][rank]["observed_clock_mhz"] = int(rows[0]["gpu_clock"])
+    record.update(disposition="accepted", profile=profile)
+    return record
+
+
+def coordinate_error(prefill, decode, context, *, budget, max_seqs, max_len):
+    if prefill + decode == 0 or prefill + decode > budget:
+        return "measurement work must be in 1..configured hard token budget"
+    if decode + int(prefill > 0) > max_seqs:
+        return "measurement requests exceed max_num_seqs"
+    if prefill > max_len - 1:
+        return "prefill prompt leaves no room for its sampled output"
+    if (decode == 0 and context != 0) or (
+        decode > 0 and not 2 * decode <= context <= decode * (max_len - 1)
+    ):
+        return "decode context sum must allow lengths in 2..max_model_len-1 (or zero without decode)"
+    return None
+
+
+def run(args):
+    for values, minimum in ((args.prefill_tokens, 0), (args.decode_tokens, 0),
+                            (args.total_ctx_lens, 0), (args.clocks, 1)):
+        if (not values or len(set(values)) != len(values)
+                or any(type(value) is not int or value < minimum for value in values)):
+            raise ValueError("mixed grid dimensions must be unique nonnegative integers; clocks positive")
+    if (min(args.tp, args.pp, args.repeats, args.budget, args.max_num_seqs) < 1
+            or args.max_model_len < 2 or args.token_id < 0):
+        raise ValueError("invalid mixed-profile capacity/repetition/token settings")
+    provenance = check_target(args.artifact_root)
+    from vllm import LLM
+    from vllm.engine.arg_utils import EngineArgs
+
+    directory = Path(args.output).resolve()
+    directory.mkdir(parents=True, exist_ok=False)
+    options = dict(
+        model=args.model, custom_profiler=True, beam_log_dir=str(directory),
+        tensor_parallel_size=args.tp, pipeline_parallel_size=args.pp,
+        distributed_executor_backend="mp", async_scheduling=False,
+        enable_prefix_caching=False, enable_chunked_prefill=True,
+        long_prefill_token_threshold=0, max_num_batched_tokens=args.budget,
+        max_num_seqs=args.max_num_seqs, max_model_len=args.max_model_len,
+    )
+    write_json(directory / "manifest.json", {
+        **provenance, "configuration": vars(args), "engine_args": options,
+        "schema_id": "beam_mixed_profile_grid_v1", "source_trial_schema": TRIAL_SCHEMA,
+        "energy_label": ENERGY_LABEL, "legacy_lookup_compatible": False,
+        "calibration_claim": False,
+    })
+    llm = LLM.from_engine_args(EngineArgs(**options))
+    client = llm.llm_engine.engine_core
+    records, measurements = [], []
+    try:
+        identities = llm.collective_rpc(worker_identity)
+        mapping = rank_device_map({str(row["rank"]): row["uuid"] for row in identities},
+                                  args.tp * args.pp)
+        write_json(directory / "devices.json", mapping)
+        with (directory / "trials.jsonl").open("x", encoding="utf-8") as journal:
+            for clock, prefill, decode, context in product(
+                args.clocks, args.prefill_tokens, args.decode_tokens, args.total_ctx_lens,
+            ):
+                requested = {"prefill_tokens": prefill, "decode_tokens": decode,
+                             "total_ctx_len": context}
+                point = directory / f"f{clock}_p{prefill}_d{decode}_ctx{context}"
+                point.mkdir()
+                reason = coordinate_error(prefill, decode, context, budget=args.budget,
+                                          max_seqs=args.max_num_seqs, max_len=args.max_model_len)
+                if reason is None:
+                    # Only clock/device control uses the worker collective RPC.
+                    llm.collective_rpc(worker_clock, args=(clock,))
+                for repeat in range(args.repeats):
+                    attempt = point / f"repeat_{repeat:04d}"
+                    attempt.mkdir()
+                    if reason is not None:
+                        record = {"disposition": "skipped", "reasons": [reason],
+                                  "requested": requested, "attempted": False}
+                    else:
+                        try:
+                            result = call_owned_trial(client, prefill, decode, context,
+                                                      attempt, args.token_id)
+                            write_json(attempt / "core-result.json", result)
+                            record = summarize_owned_result(
+                                result, requested, attempt, expected_ranks=args.tp * args.pp,
+                                rank_devices=mapping,
+                            )
+                            record["attempted"] = True
+                        except Exception as error:
+                            write_json(attempt / "failure.json", {
+                                "error_type": type(error).__name__, "requested": requested,
+                            })
+                            raise  # executor, ownership, capacity and I/O errors are not mismatches
+                    record.update(schema_id=TRIAL_SCHEMA, energy_label=ENERGY_LABEL,
+                                  legacy_lookup_compatible=False, calibration_claim=False,
+                                  clock_mhz_requested=clock, repeat=repeat)
+                    write_json(attempt / "disposition.json", record)
+                    journal.write(json.dumps(record, allow_nan=False) + "\n")
+                    journal.flush()
+                    records.append(record)
+                    if record["disposition"] != "accepted":
+                        continue
+                    for rank, sample in record["profile"]["ranks"].items():
+                        measurements.append({
+                            "schema_id": "beam_owned_mixed_measurement_v1",
+                            **requested, "clock_mhz_requested": clock, "repeat": repeat,
+                            "rank": rank, "uuid": mapping[rank],
+                            "logical_forward_count": record["logical_forward_count"],
+                            "device_forward_count": sample["forwards"],
+                            "window_energy_mj": sample["energy_j"] * 1000,
+                            "window_seconds": sample["window_seconds"],
+                            "cuda_forward_ms": sample["sum_forward_ms"],
+                            "observed_clock_mhz": sample["observed_clock_mhz"],
+                            "energy_label": ENERGY_LABEL, "legacy_lookup_compatible": False,
+                            "calibration_claim": False,
+                        })
+        groups = {}
+        for row in measurements:
+            key = tuple(row[name] for name in (
+                "clock_mhz_requested", "prefill_tokens", "decode_tokens", "total_ctx_len", "rank"))
+            groups.setdefault(key, []).append(row)
+        aggregates = [{
+            **dict(zip(("clock_mhz_requested", "prefill_tokens", "decode_tokens",
+                        "total_ctx_len", "rank"), key)),
+            "accepted_repeats": len(rows), "requested_repeats": args.repeats,
+            "complete_point": len(rows) == args.repeats,
+            **{f"mean_{name}": statistics.mean(row[name] for row in rows)
+               for name in ("window_energy_mj", "window_seconds", "cuda_forward_ms")},
+        } for key, rows in groups.items()]
+        write_json(directory / "summary.json", {
+            "schema_id": "beam_mixed_profile_grid_v1", "source_trial_schema": TRIAL_SCHEMA,
+            "energy_label": ENERGY_LABEL, "legacy_lookup_compatible": False,
+            "calibration_claim": False, "rank_devices": mapping,
+            "complete_grid": all(record["disposition"] == "accepted" for record in records),
+            "accepted_trials": sum(record["disposition"] == "accepted" for record in records),
+            "skipped_trials": sum(record["disposition"] == "skipped" for record in records),
+            "points": aggregates,
+        })
+        if measurements:
+            with (directory / "measurements.csv").open("x", newline="") as stream:
+                writer = csv.DictWriter(stream, fieldnames=list(measurements[0]))
+                writer.writeheader()
+                writer.writerows(measurements)
+    finally:
+        try:
+            llm.collective_rpc("reset_beam_clock")
+        finally:
+            client.shutdown()
