+# along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+# Orchestrates Apache-2.0 vLLM EngineCore/Scheduler/Request interfaces.
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+"""Bounded, exclusively owned native-request profiling, not dummy attention.
+
+Call EngineCore.beam_profile_trial through a core utility (SyncMPClient's
+call_utility or AsyncMPClient's call_utility_async), NOT a worker collective_rpc.
+An exclusive InprocClient owner can call client.engine_core.beam_profile_trial
+directly. No frontend requests/profilers may be used concurrently with a trial.
+
+Contexts are decode input sequence lengths, including each one-token query;
+the prefill prompt is excluded from total_ctx_len. Native padding, PP/sample
+work and device-stream tails remain native. Energy is a host-bounded custom
+profiler counter window, not legacy per-forward energy or a calibration row.
+Failed reply ownership forbids further worker RPCs. A failed native step
+quarantines the engine even if bounded driver/worker cleanup subsequently runs;
+unretired invocation identities are reported, never retired with fake output.
+"""
+
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import TYPE_CHECKING, cast
+from uuid import uuid4
+
+from vllm.sampling_params import SamplingParams
+from vllm.v1.core.sched.interface import PauseState
+from vllm.v1.request import Request, RequestStatus
+
+if TYPE_CHECKING:
+    from vllm.v1.core.sched.output import SchedulerOutput
+    from vllm.v1.core.sched.scheduler import Scheduler
+    from vllm.v1.engine.core import EngineCore
+
+
+@dataclass
+class BeamProfileObservation:
+    owned: dict[str, Request]
+    snapshots: list[dict] = field(default_factory=list)
+    errors: list[str] = field(default_factory=list)
+
+    def capture(self, scheduler: "Scheduler", output: "SchedulerOutput") -> None:
+        """Copy finalized allocation facts BEFORE upstream advances counters.
+
+        Never reject a coordinate here: scheduling has already mutated native
+        allocation state. Validation happens only after execute/sample/update.
+        """
+        try:
+            rows = []
+            prefill = decode = context = 0
+            unknown = False
+            for rid, count in output.num_scheduled_tokens.items():
+                request = scheduler.requests.get(rid)
+                if request is None or self.owned.get(rid) is not request:
+                    self.errors.append(f"unexpected request identity: {rid}")
+                if request is None:
+                    unknown = True
+                    rows.append({"request_id": rid, "scheduled_tokens": count,
+                                 "kind": "unknown"})
+                    continue
+                computed = request.num_computed_tokens
+                is_decode = (request.num_output_tokens > 0
+                             and computed >= request.num_prompt_tokens)
+                if is_decode:
+                    decode += count
+                    context += computed + count
+                else:
+                    prefill += count
+                rows.append({
+                    "request_id": rid, "scheduled_tokens": count,
+                    "kind": "decode" if is_decode else "prefill",
+                    "computed_tokens_before": computed,
+                    "prompt_tokens": request.num_prompt_tokens,
+                    "output_tokens_before": request.num_output_tokens,
+                    "input_context_len": computed + count if is_decode else None,
+                })
+            self.snapshots.append({
+                "prefill_tokens": None if unknown else prefill,
+                "decode_tokens": None if unknown else decode,
+                "total_ctx_len": None if unknown else context,
+                "decode_context_lengths": [
+                    row["input_context_len"] for row in rows if row["kind"] == "decode"
+                ],
+                "total_num_scheduled_tokens": output.total_num_scheduled_tokens,
+                "num_scheduled_tokens": dict(output.num_scheduled_tokens),
+                "preempted_req_ids": sorted(output.preempted_req_ids or ()),
+                "scheduler_step": scheduler.current_step, "requests": rows,
+            })
+        except Exception as exc:
+            # The dispatcher must still execute this already finalized output.
+            self.errors.append(f"observation failed: {type(exc).__name__}: {exc}")
+
+
+def _validate(core: "EngineCore", p: int, n: int, ctx: int, directory: str,
+              token_id: int) -> list[int]:
+    from vllm.v1.core.sched.async_scheduler import AsyncScheduler
+    from vllm.v1.core.sched.scheduler import Scheduler
+
+    if core._beam_profile_transport_failed():
+        core._beam_profile_unusable = True
+    if core._beam_profile_unusable:
+        raise ValueError("owned profiling engine unusable; cleanup unconfirmed; restart required")
+
+    for name, value in (("prefill_tokens", p), ("decode_tokens", n),
+                        ("total_ctx_len", ctx), ("token_id", token_id)):
+        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
+            raise ValueError(f"{name} must be a nonnegative integer, not bool")
+    if not isinstance(directory, str) or not directory.strip() or "\x00" in directory:
+        raise ValueError("output_dir must be a nonempty local directory")
+    if "://" in directory:
+        raise ValueError("owned profiling requires a local output_dir")
+    cfg, scheduler = core.vllm_config, core.scheduler
+    parallel, model = cfg.parallel_config, cfg.model_config
+    if not isinstance(scheduler, Scheduler) or isinstance(scheduler, AsyncScheduler):
+        raise ValueError("owned profiling requires the native synchronous Scheduler")
+    if not parallel.custom_profiler:
+        raise ValueError("owned profiling requires custom_profiler=True")
+    if any((parallel.use_s1, parallel.use_s1_dvfs_only, parallel.use_s2,
+            parallel.use_window_based_dvfs_only, parallel.measure_fidelity,
+            parallel.disagg_mode)):
+        raise ValueError("owned profiling requires S1/S2/window/fidelity/disagg off")
+    if core.async_scheduling or cfg.scheduler_config.async_scheduling:
+        raise ValueError("owned profiling does not support async scheduling")
+    if cfg.speculative_config is not None or cfg.lora_config is not None:
+        raise ValueError("owned profiling does not support speculation or LoRA")
+    if (model.runner_type != "generate" or model.is_encoder_decoder
+            or model.is_multimodal_model or core.is_pooling_model):
+        raise ValueError("owned profiling requires a text-only decoder generate model")
+    if (cfg.kv_transfer_config is not None or cfg.ec_transfer_config is not None
+            or scheduler.connector is not None or scheduler.ec_connector is not None):
+        raise ValueError("owned profiling does not support KV/EC connectors")
+    if (parallel.data_parallel_size != 1 or parallel.decode_context_parallel_size != 1
+            or parallel.prefill_context_parallel_size != 1):
+        raise ValueError("owned profiling does not support distributed DP/context parallel")
+    if parallel.use_ubatching or parallel.enable_eplb:
+        raise ValueError("owned profiling does not support ubatching/DBO or EPLB")
+    if scheduler.has_mamba_layers or not scheduler.kv_cache_config.kv_cache_groups:
+        raise ValueError("owned profiling requires attention KV, not hybrid/SSM state")
+    if cfg.device_config.device_type != "cuda":
+        raise ValueError("owned custom profiling requires the configured CUDA device")
+    backend_names = {
+        f"{cls.__module__}.{cls.__qualname__}"
+        for cls in type(core.model_executor).__mro__
+    }
+    if (not backend_names.intersection({
+        "vllm.v1.executor.uniproc_executor.UniProcExecutor",
+        "vllm.v1.executor.multiproc_executor.MultiprocExecutor",
+    }) or "vllm.v1.executor.uniproc_executor.ExecutorWithExternalLauncher"
+            in backend_names):
+        raise ValueError("owned profiling supports native uni/mp/RayV2 core executors")
+    if parallel.pipeline_parallel_size > 1 and not core.model_executor.supports_pp:
+        raise ValueError("the configured executor does not support native PP")
+    beam = getattr(scheduler, "_beam", None)
+    if beam is None:
+        raise ValueError("owned profiling requires the scheduler's BEAM profiler hooks")
+    status = beam.get_status()
+    if (status["chunk_size"]["manual"] or status["chunk_size"]["pending"]
+            or status["microbatch_size"]["manual"] or beam.has_work
+            or status["outstanding_invocations"] or status["state"] != "ACTIVE"
+            or beam.model is not None or beam.clock_selector is not None):
+        raise ValueError("clear/drain manual controls and BEAM work before profiling")
+    if (core.batch_queue or scheduler.requests or scheduler.has_requests()
+            or scheduler.has_finished_requests() or not core.aborts_queue.empty()):
+        raise ValueError("owned profiling requires an idle engine with worker cleanup drained")
+    if scheduler.pause_state != PauseState.UNPAUSED:
+        raise ValueError("owned profiling requires an unpaused scheduler")
+    if (core._beam_profile_active or beam._log_files
+            or core._beam_profile_trial_active or scheduler.beam_profile_expected is not None):
+        raise ValueError("stop active profilers/trials before owned profiling")
+    if p + n == 0 or p + n > scheduler.max_num_scheduled_tokens:
+        raise ValueError("measurement work must be in 1..configured hard token budget")
+    if n + int(p > 0) > scheduler.max_num_running_reqs:
+        raise ValueError("measurement requests exceed max_num_seqs")
+    if token_id >= model.get_vocab_size():
+        raise ValueError("token_id is outside the model vocabulary")
+    if n == 0:
+        if ctx != 0:
+            raise ValueError("total_ctx_len must be zero with no decode requests")
+        contexts = []
+    else:
+        if ctx < 2 * n or ctx > n * (scheduler.max_model_len - 1):
+            raise ValueError("decode context sum must allow lengths in 2..max_model_len-1")
+        quotient, remainder = divmod(ctx, n)
+        contexts = [quotient + 1] * remainder + [quotient] * (n - remainder)
+    if p > scheduler.max_model_len - 1:
+        raise ValueError("prefill prompt leaves no room for its sampled output")
+    threshold = cfg.scheduler_config.long_prefill_token_threshold
+    if threshold > 0 and p > threshold:
+        raise ValueError("measurement prefill exceeds long_prefill_token_threshold")
+    if (not cfg.scheduler_config.enable_chunked_prefill
+            and any(c - 1 > scheduler.max_num_scheduled_tokens for c in contexts)):
+        raise ValueError("warming these contexts requires chunked prefill")
+    return contexts
+
+
+def run_trial(core: "EngineCore", prefill_tokens: int, decode_tokens: int,
+              total_ctx_len: int, output_dir: str, token_id: int = 0) -> dict:
+    contexts = _validate(core, prefill_tokens, decode_tokens, total_ctx_len,
+                         output_dir, token_id)
+    scheduler = cast("Scheduler", core.scheduler)  # validated native ownership
+    cfg = core.vllm_config
+    pp = cfg.parallel_config.pipeline_parallel_size
+    trial_id = f"beam-mixed-{uuid4().hex}"
+    directory = str(Path(output_dir).expanduser().absolute() / trial_id)
+    saved_admission = scheduler.beam_profile_admission
+    owned: dict[str, Request] = {}
+    decoders: list[Request] = []
+    primary: BaseException | None = None
+    cleanup_errors: list[Exception] = []
+    result: dict | None = None
+    native_step_failed = False
+    profile_stop_confirmed = True  # no profile has been attempted yet
+    warm_forwards = carry_steps = cleanup_steps = 0
+    core._beam_profile_cleanup_report = None
+
+    def step():
+        nonlocal native_step_failed
+        try:
+            return core.step()
+        except BaseException:
+            native_step_failed = True
+            core._beam_profile_unusable = True
+            raise
+
+    def add(role: str, prompt_len: int, max_tokens: int) -> Request:
+        rid = f"{trial_id}-{role}"
+        request = Request(
+            request_id=rid, prompt_token_ids=[token_id] * prompt_len,
+            sampling_params=SamplingParams(
+                temperature=0, ignore_eos=True, max_tokens=max_tokens,
+                detokenize=False,
+            ),
+            pooling_params=None, cache_salt=rid,
+            block_hasher=core.request_block_hasher,
+        )
+        owned[rid] = request  # owns any partially completed add_request too
+        core.add_request(request)
+        return request
+
+    def exclusive() -> None:
+        if core.batch_queue or any(owned.get(rid) is not request
+                                   for rid, request in scheduler.requests.items()):
+            raise RuntimeError("external request/queue interference during owned trial")
+        if any(request.num_preemptions for request in owned.values()):
+            raise RuntimeError("native KV pressure preempted an owned trial request")
+
+    def prepared(request: Request, context: int) -> bool:
+        return (
+            scheduler.requests.get(request.request_id) is request
+            and not request.is_finished() and request.num_output_tokens == 1
+            and request.num_computed_tokens == context - 1
+            and request.num_tokens == context
+        )
+
+    scheduler.beam_profile_admission = {}
+    core._beam_profile_trial_active = True
+    try:
+        for i, context in enumerate(contexts):
+            request = add(f"decode-{i}", context - 1, 2)
+            decoders.append(request)
+            scheduler.beam_profile_admission = {
+                request.request_id: scheduler.max_num_scheduled_tokens,
+            }
+            # Progress is native computed work or a real first sample, never a
+            # reset/placeholder. Even threshold=1 is bounded by prompt length.
+            for _ in range(request.num_prompt_tokens + 1):
+                exclusive()
+                before = request.num_computed_tokens
+                _, executed = step()
+                warm_forwards += int(executed)
+                exclusive()
+                if request.num_output_tokens:
+                    break
+                if request.num_computed_tokens <= before:
+                    raise RuntimeError("native warmup made no progress (KV/budget pressure)")
+            if not prepared(request, context):
+                raise RuntimeError("warmup did not produce the exact owned decode context")
+            scheduler.beam_profile_admission = {}  # HOLD all prepared requests
+
+        # V2 PP applies sampled state at T+P even in synchronous mode. These
+        # real empty invocations are outside the measured profiler window.
+        if decoders and pp > 1:
+            for _ in range(pp):
+                _, executed = step()
+                if executed:
+                    raise RuntimeError("held warmup unexpectedly admitted forward work")
+                carry_steps += 1
+        if any(not prepared(request, context) for request, context in zip(decoders, contexts)):
+            raise RuntimeError("held decode contexts changed before measurement")
+        prefill = add("prefill", prefill_tokens, 1) if prefill_tokens else None
+        exclusive()
+        expected = {request.request_id: 1 for request in decoders}
+        if prefill is not None:
+            expected[prefill.request_id] = prefill_tokens
+        scheduler.beam_profile_admission = dict(expected)
+        observation = BeamProfileObservation(owned)
+        profile_stop_confirmed = False
+        try:
+            core.profile(True, output_dir=directory)
+            scheduler.beam_profile_expected = observation
+            _, executed = step()  # one measurement, including mismatch
+        except BaseException as exc:
+            primary = exc
+        finally:
+            scheduler.beam_profile_expected = None
+            if core._beam_profile_transport_failed():
+                core._beam_profile_unusable = True
+                cleanup_errors.append(RuntimeError(
+                    "profiler stop skipped: reply ownership ambiguous; restart required"
+                ))
+            else:
+                try:
+                    core.profile(False)
+                    profile_stop_confirmed = True
+                except Exception as exc:
+                    if primary is None:
+                        primary = exc
+                    else:
+                        cleanup_errors.append(exc)
+        if primary is not None:
+            raise primary
+        errors = list(observation.errors)
+        actual = observation.snapshots[0] if len(observation.snapshots) == 1 else None
+        requested = {"prefill_tokens": prefill_tokens, "decode_tokens": decode_tokens,
+                     "total_ctx_len": total_ctx_len}
+        if actual is None:
+            errors.append("measurement did not capture exactly one native schedule")
+        else:
+            if actual["num_scheduled_tokens"] != expected:
+                errors.append("finalized per-request work differs from requested work")
+            if any(actual[name] != value for name, value in requested.items()):
+                errors.append("observed native coordinates differ from requested coordinates")
+            if actual["preempted_req_ids"]:
+                errors.append("measurement preempted native requests")
+            rows = {row["request_id"]: row for row in actual["requests"]}
+            for request, context in zip(decoders, contexts):
