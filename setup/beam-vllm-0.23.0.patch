+def test_fixed_flush_then_retire_only_and_prefill_override(monkeypatch, pp):
+    scheduler = create_scheduler(pipeline_parallel_size=pp)
+    beam = enable_beam(scheduler, monkeypatch, use_s2=True)
+    beam.num_microbatches = pp
+    if pp == 1:
+        assert beam.should_dispatch
+        assert beam.maybe_commit_transition(queue_empty=True) is False
+        return
+    request, = create_requests(1, num_tokens=8)
+    scheduler.add_request(request)
