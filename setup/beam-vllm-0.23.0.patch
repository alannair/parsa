+def test_private_server_guard_covers_all_routes_and_mounted_websockets(kind, method, path, root, public):
+    async def probe(authorized):
+        reached, sent = [], []
+
+        async def app(scope, receive, send):
+            reached.append(scope["path"])
+
+        async def send(event):
+            sent.append(event)
+
+        middleware = BeamToolsAuthMiddleware(app)
+        await middleware({"type": kind, "method": method, "path": path, "root_path": root,
+                          "headers": [(b"authorization", b"Bearer test-only" if authorized else b"")]},
+                         None, send)
+        return reached, sent
+
+    with patch.dict("os.environ", {"BEAM_TOOLS_RPC_TOKEN": "test-only"}):
+        reached, sent = asyncio.run(probe(False))
+        assert bool(reached) is public
+        if not public:
+            assert (sent[0].get("status") == 401 if kind == "http"
+                    else sent[0] == {"type": "websocket.close", "code": 1008})
+        reached, sent = asyncio.run(probe(True))
