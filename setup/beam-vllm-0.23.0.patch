+@pytest.mark.parametrize("failure", [
+    "exceeds_capacity", "out_of_space", "post_ack_oom", "pre_ack_oom", "wrong_owner",
+])
+def test_put_failure_is_terminal_not_double_acked_and_listener_continues(
+    monkeypatch, failure,
+):
+    import torch
+
+    from vllm.distributed.kv_transfer.kv_connector.v1.p2p.tensor_memory_pool import (
+        TensorMemoryPool,
+    )
+
+    # The wrong-owner peer has a valid negotiated overlap (layers 4 and 5),
+    # but does not own the incoming layer 3. All other cases use PP=1 producer.
+    remote_partition = [2, 2, 2] if failure == "wrong_owner" else [6]
+    engine = _engine(_metadata([2, 4], remote_partition, 1, tp_rank=1, producer=False))
+    engine._beam_peers["p:10001"] = _metadata(
+        remote_partition, [2, 4], 2 if failure == "wrong_owner" else 0, tp_rank=1,
+    )
+    engine.buffer_size_threshold = 0
+    state, events, responses = {}, [], []
+    lock = engine._beam_pool_lock = _PoolLock(state)
+    # Real pool capacity logic, with pinned allocation and tensor copy faked.
+    allocator = object.__new__(TensorMemoryPool)
+    allocator.max_block_size = 512 if failure == "exceeds_capacity" else 8192
+    allocator.min_block_size = 512
+    allocator.free_lists = {}
+    allocator.allocated_blocks = {}
+    allocator._initialize_free_lists()  # No free blocks: exhausted in the second case.
+
+    def store(value, *, on_reserve=None):
+        assert lock.depth == 1
+        engine.buffer_size_threshold = 1000000  # Next PUT can use a resident buffer.
+        if failure == "post_ack_oom":
+            raise torch.cuda.OutOfMemoryError("spill copy allocation failed")
+        return allocator.allocate(value.element_size() * value.numel())
+
+    engine.pool = SimpleNamespace(store_tensor=store)
+    bad_id = "bad#model.layers.3.self_attn.attn"
+    good_id = "good#model.layers.4.self_attn.attn"
+    commands = [{
+        "cmd": "PUT", "tensor_id": tensor_id,
+        "shape": [1, 2, 16, 2, 64], "dtype": "float16",
+    } for tensor_id in (bad_id, good_id)]
+    _put_listener(engine, commands, responses, monkeypatch, events)
+    original_empty = torch.empty
+    allocations = 0
+
+    def allocate(*args, **kwargs):
+        nonlocal allocations
+        allocations += 1
+        if failure == "pre_ack_oom" and allocations == 1:
+            engine.buffer_size_threshold = 1000000
+            raise torch.cuda.OutOfMemoryError("receive allocation failed")
+        if failure == "wrong_owner":
+            engine.buffer_size_threshold = 1000000
+        return original_empty(*args, **kwargs)
+
+    monkeypatch.setattr(torch, "empty", allocate)
+    notifications = []
+    original_notify_all = engine.recv_store_cv.notify_all
+
+    def notify_all():
+        assert engine.recv_store_cv._is_owned()
+        assert isinstance(engine.recv_store.get(bad_id), Exception)
+        notifications.append("terminal published before waking all waiters")
+        original_notify_all()
+
+    monkeypatch.setattr(engine.recv_store_cv, "notify_all", notify_all)
+    with pytest.raises(StopIteration):
+        engine.listen_for_requests()
+    first_ack = b"1" if failure in ("pre_ack_oom", "wrong_owner") else b"0"
+    assert responses == [[b"p:10001", first_ack], [b"p:10001", b"0"]]
+    assert len(notifications) == 1 and lock.depth == 0
+    assert isinstance(engine.recv_store[good_id], torch.Tensor)
+
+    def no_wait(*args, **kwargs):
+        raise AssertionError("Terminal receive failure must never wait for a tensor")
+
+    monkeypatch.setattr(engine.recv_store_cv, "wait", no_wait)
+    with pytest.raises(RuntimeError, match="BEAM receive/storage failed") as caught:
+        engine.recv_tensor(bad_id)
+    assert caught.value.__cause__ is engine.recv_store[bad_id]
+    assert engine.recv_tensor(good_id).shape == (1, 2, 16, 2, 64)
+
+
+@pytest.mark.parametrize("failure", [
+    None, "view_value_error", "view_memory_error", "copy_failure",
+    "sync_failure", "copy_and_sync_failure", "publication_failure",
+])
+def test_reserved_spill_is_published_reclaimed_or_quarantined(monkeypatch, failure):
+    import ctypes
+
+    import torch
+
+    from vllm.distributed.kv_transfer.kv_connector.v1.p2p.tensor_memory_pool import (
+        MemoryBlock, TensorMemoryPool,
+    )
+
+    engine = _engine(_metadata([2, 4], [6], 1, tp_rank=1, producer=False))
+    engine.device = torch.device("cuda:3")
+    engine._beam_peers["p:10001"] = _metadata([6], [2, 4], 0, tp_rank=1)
+    engine.buffer_size_threshold = 0
+    events, responses = [], []
+    state = {"pending": False}
+    # A real successful buddy reservation, with ordinary CPU backing instead of
+    # pinned allocation. Fake views/copies never dereference it from CUDA.
+    backing = ctypes.create_string_buffer(8192)
+    address = ctypes.addressof(backing)
+    pool = object.__new__(TensorMemoryPool)
+    pool.base_address = address
+    pool.max_block_size, pool.min_block_size = 8192, 512
+    pool.allocated_blocks, pool.free_lists = {}, {}
+    pool._initialize_free_lists()
+    pool.free_lists[8192][address] = MemoryBlock(size=8192, addr=address)
+    engine.pool = pool
+    allocate_block, free_block = pool.allocate, pool.free
+
+    def reserve(size):
+        result = allocate_block(size)
+        assert result == address
+        events.append("reserved")
+        return result
+
+    def free(addr):
+        assert addr == address and not state["pending"]
+        events.append("reclaimed")
+        free_block(addr)
+
+    monkeypatch.setattr(pool, "allocate", reserve)
+    monkeypatch.setattr(pool, "free", free)
+
+    class Tensor:
+        shape = (1, 2, 16, 2, 64)
+        dtype = torch.float16
+        is_cuda = True
+        device = engine.device
+
+        def data_ptr(self):
+            return 0
+
+        def numel(self):
+            return 4096
+
+        def element_size(self):
+            return 2
+
+    tensor = Tensor()
+
+    class View:
+        def reshape(self, shape):
+            assert shape == tensor.shape
+            return self
+
+        def copy_(self, value):
+            assert value is tensor and address in pool.allocated_blocks
+            state["pending"] = True
+            events.append("copy submitted")
+            if failure in ("copy_failure", "copy_and_sync_failure"):
+                raise RuntimeError("injected D2H copy failure")
+
+    def view(*args, **kwargs):
+        assert address in pool.allocated_blocks
+        events.append("raw view")
+        if failure == "view_value_error":
+            raise ValueError("injected raw view failure")
+        if failure == "view_memory_error":
+            raise MemoryError("injected raw view allocation failure")
+        return View()
+
+    def synchronize():
+        assert address in pool.allocated_blocks
+        events.append("copy stream sync")
+        if failure in ("sync_failure", "copy_and_sync_failure"):
+            raise RuntimeError("injected unconfirmed GPU context")
+        state["pending"] = False
+
+    stream = SimpleNamespace(synchronize=synchronize)
+    monkeypatch.setattr(torch, "frombuffer", view)
+    monkeypatch.setattr(torch, "empty", lambda *args, **kwargs: tensor)
+    monkeypatch.setattr(torch.cuda, "current_stream", lambda device: stream)
+    tensor_id = "reserved#model.layers.4.self_attn.attn"
+    _put_listener(engine, [{
+        "cmd": "PUT", "tensor_id": tensor_id,
+        "shape": list(tensor.shape), "dtype": "float16",
+    }], responses, monkeypatch, events)
+    original_notify = engine.recv_store_cv.notify
+    failed_publication = False
+
+    def notify(n=1):
+        nonlocal failed_publication
+        if failure == "publication_failure" and not failed_publication:
+            assert isinstance(engine.recv_store[tensor_id], tuple)
+            failed_publication = True
+            raise MemoryError("injected descriptor publication failure")
+        original_notify(n)
+
+    monkeypatch.setattr(engine.recv_store_cv, "notify", notify)
+    terminal_notifications = []
+    original_notify_all = engine.recv_store_cv.notify_all
+
+    def notify_all():
+        assert isinstance(engine.recv_store[tensor_id], Exception)
+        terminal_notifications.append(tensor_id)
+        original_notify_all()
+
+    monkeypatch.setattr(engine.recv_store_cv, "notify_all", notify_all)
+    with pytest.raises(StopIteration):
+        engine.listen_for_requests()
+    # Every injected fault occurs AFTER successful reservation and the PUT ACK.
+    assert responses == [[b"p:10001", b"0"]]
+    assert events.count("reserved") == 1 and events.count("copy stream sync") == 1
+    quarantined = failure in ("sync_failure", "copy_and_sync_failure")
+    if failure is None:
+        assert engine.recv_store[tensor_id] == (address, tensor.dtype, tensor.shape)
+        assert address in pool.allocated_blocks and "reclaimed" not in events
+        assert terminal_notifications == [] and engine._beam_pool_quarantine == {}
+    else:
+        assert terminal_notifications == [tensor_id]
+        assert isinstance(engine.recv_store[tensor_id], Exception)
+        with pytest.raises(RuntimeError, match="BEAM receive/storage failed"):
+            engine.recv_tensor(tensor_id)
+        if quarantined:
+            assert address in pool.allocated_blocks and "reclaimed" not in events
+            owner = engine._beam_pool_quarantine[address]
+            assert owner[0] == tensor_id and owner[1] is tensor
+            assert "quarantined" in str(engine.recv_store[tensor_id])
+        else:
+            assert events.index("copy stream sync") < events.index("reclaimed")
+            assert events.count("reclaimed") == 1 and pool.allocated_blocks == {}
+            assert engine._beam_pool_quarantine == {}
+
+    engine.get_finished({"reserved"}, {"model.layers.4.self_attn.attn": object()})
+    if quarantined:
+        # Terminal request cleanup must not drop the separate pending owner.
+        assert address in engine._beam_pool_quarantine and state["pending"]
+        with pytest.raises(ValueError, match="Insufficient memory"):
+            allocate_block(8192)
+        before = list(events)
+        engine._spill_beam_tensor(tensor_id, tensor)
+        assert events == before  # A quarantined pool admits no further spills.
+        assert address in pool.allocated_blocks
+    else:
+        assert not state["pending"] and pool.allocated_blocks == {}
+        assert allocate_block(8192) == address
