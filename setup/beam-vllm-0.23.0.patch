+@pytest.mark.parametrize("failed_start", [False, True])
+def test_trial_is_a_core_utility_not_a_worker_collective(trial_core, tmp_path, failed_start):
+    from vllm.v1.engine import EngineCoreRequestType, UtilityOutput
+    from vllm.v1.engine.core import EngineCoreProc
+    from vllm.v1.engine.core_client import SyncMPClient, _process_utility_output
+
+    core = trial_core()
+    if failed_start:
+        def profile(is_start=True, prefix=None, **kwargs):
+            core.model_executor._beam_response_stream_failed = True
+            raise RuntimeError("first rank profile start failed")
+
+        core.model_executor.profile = profile
+    client = SyncMPClient.__new__(SyncMPClient)
+    client.utility_results = {}
+    packets = []
+
+    def send(request_type, payload):
+        packets.append((request_type, payload[2]))
+        _, call_id, method_name, args = payload
+        method = getattr(core, method_name)
+        output = UtilityOutput(call_id=call_id)
+        EngineCoreProc._invoke_utility_method(
+            method_name,
+            lambda: method(*EngineCoreProc._convert_msgspec_args(method, args)),
+            output,
+            lambda reply: _process_utility_output(reply, client.utility_results),
+        )
+
+    client._send_input = send
+    if failed_start:
+        with pytest.raises(Exception) as raised:
+            client.call_utility("beam_profile_trial", 3, 1, 4, str(tmp_path), 0)
+        assert "first rank profile start failed" in str(raised.value)
+        assert "cleanup unconfirmed" in str(raised.value)
+        assert "restart required" in str(raised.value)
+        assert packets == [(EngineCoreRequestType.UTILITY, "beam_profile_trial")]
+        assert core._beam_profile_unusable
+        return
+    result = client.call_utility("beam_profile_trial", 3, 1, 4, str(tmp_path), 0)
+    assert packets == [(EngineCoreRequestType.UTILITY, "beam_profile_trial")]
+    assert result["schema_id"] == "beam_owned_mixed_window_v1"
+    assert result["status"] == "ok"
+    assert not core.scheduler.requests
