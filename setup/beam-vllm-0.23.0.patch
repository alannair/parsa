+def test_manual_m_coalesces_and_survives_slos_and_prefill_override(monkeypatch):
+    scheduler = create_scheduler(pipeline_parallel_size=4)
+    beam = enable_beam(scheduler, monkeypatch, use_s2=True)
+    request, = create_requests(1, num_tokens=8)
+    scheduler.add_request(request)
+    work = scheduler.schedule()
+    beam.update_microbatch_size(1)
+    first = scheduler.schedule()
