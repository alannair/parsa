+        feasible = [point for point in candidates
+                    if point.ttft_ms <= self.ttft_slo_ms
+                    and point.tbt_ms <= self.tbt_slo_ms]
+        if feasible:
+            best = min(feasible, key=lambda point: (
+                point.energy_per_req_j, point.ttft_ms, point.freq_mhz))
+            return replace(best, feasible=True)
+        return replace(max(candidates, key=lambda point: point.freq_mhz), feasible=False)
