+def _app(frontend, profile=False):
+    from fastapi import FastAPI, HTTPException
+    from fastapi.exceptions import RequestValidationError
+    from vllm.entrypoints.serve.profile.api_router import attach_router
+    from vllm.entrypoints.serve.utils.server_utils import (
+        http_exception_handler, validation_exception_handler,
+    )
+
+    app = FastAPI()
+    app.state.args = SimpleNamespace(
+        profiler_config=None, log_error_stack=False, custom_profiler=profile
+    )
+    app.state.engine_client = frontend
+    app.exception_handler(HTTPException)(http_exception_handler)
+    app.exception_handler(RequestValidationError)(validation_exception_handler)
+    attach_router(app)
+    return app
+
