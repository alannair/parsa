+def load_policy_module():
+    """Load only the two stdlib policy files; no vLLM package/CUDA/NVML imports."""
+    path = ROOT / "vllm/v1/core/sched"
+    name = "_beam_tools_standalone_policy"
+    if name not in sys.modules:
+        spec = importlib.util.spec_from_file_location(
+            name, path / "__init__.py", submodule_search_locations=[str(path)])
+        module = importlib.util.module_from_spec(spec)
+        sys.modules[name] = module
+        spec.loader.exec_module(module)
+    return __import__(name + ".beam_policy", fromlist=["choose_s1"])
+
+
+def algorithm_overhead(output, *, trials=200, warmup=10, pp=4, profile=None,
+                       gpu_name="NVIDIA A100-SXM4-80GB", model_name="synthetic"):
+    """Future CPU-only measurement of real target S1/S2/TPOT candidate selectors."""
+    if trials < 1 or warmup < 0 or pp < 1:
+        raise ValueError("positive trials/PP and nonnegative warmup required")
+    policy = load_policy_module()
+    directory = Path(output)
+    directory.mkdir(parents=True, exist_ok=False)
+    synthetic = profile is None
+    if synthetic:
+        profile = directory / "synthetic-profile.csv"
+        gpu_name = "NVIDIA A100-SXM4-80GB"
+        with profile.open("x", newline="") as source:
+            writer = csv.writer(source)
+            writer.writerow(("clock", "batch_size", "total_ctx_len",
+                             "time_taken", "energy_consumption"))
+            for clock in (1050, 1410):
+                for batch in (128, 256, 512, 1024):
+                    for context in (2048, 40000):
+                        latency = (batch * .00001 + context * .00000001) * 1410 / clock
+                        writer.writerow((clock, batch, context, latency, latency * 300000))
+    model = policy.EnergySimulator(str(profile), pp, 1, gpu_name=gpu_name,
+                                   model_name=model_name)
+    functions = {
+        "dispatch_baseline": lambda: None,
+        "S1": lambda: policy.choose_s1(model, prefill_tokens=1024, num_running=8,
+                                       tbt_slo=.4, ttft_slo=1),
+        "S1_DVFS_only": lambda: policy.choose_s1(
+            model, prefill_tokens=1024, num_running=8,
+            tbt_slo=.4, ttft_slo=1, dvfs_only=True),
+        "S2": lambda: policy.choose_s2(model, num_running=8, total_ctx_len=4096,
+                                       tbt_slo=.4),
+        "S1_TPOT": lambda: policy.choose_s1_tpot(
+            model, prefill_tokens=1024, histories=[[.1] * 16],
+            tpot_slo=.4, ttft_slo=1),
+    }
+    measurements, decisions = {}, {}
+    for name, function in functions.items():
+        for _ in range(warmup):
+            function()
+        timings = []
+        for _ in range(trials):
+            start = time.perf_counter_ns()
+            decision = function()
+            timings.append((time.perf_counter_ns() - start) / 1_000_000)
+        measurements[name] = timings
+        decisions[name] = vars(decision) if decision is not None else None
+    write_json(directory / "overhead.json", {
+        "units": "host milliseconds", "kind": "policy_only_no_GPU_actuation",
+        "profile": "synthetic" if synthetic else str(profile),
+        "profile_source": input_reference(profile),
+        "policy_sources": [input_reference(ROOT / "vllm/v1/core/sched" / name)
+                           for name in ("beam_policy.py", "energy_model.py")],
+        "statistics": {name: distribution(values) for name, values in measurements.items()},
+        "raw_ms": measurements, "last_decisions": decisions,
+    })
+    svg_panels(directory / "overhead.svg", [("Host algorithm milliseconds vs trial", [
+        {"name": name, "points": list(enumerate(values))}
+        for name, values in measurements.items()
+    ])])
+
