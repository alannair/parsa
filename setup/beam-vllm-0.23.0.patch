+def compare_runs(directories, output, objectives, *, artifact_filters=False):
+    """Aggregate comparable case windows, never batch cumulative counters."""
+    from benchmarks.energy.beam_tools import summarize_profile
+
+    if not directories:
+        raise ValueError("comparison requires at least one run")
+    root = Path(output)
+    root.mkdir(parents=True, exist_ok=False)
+    records, excluded = [], []
+    workload = None
+    identity = None
+    for directory in map(Path, directories):
+        requests = json.loads((directory / "requests.json").read_text())
+        if workload is not None and requests != workload:
+            raise ValueError("Pareto runs must replay the identical requests/arrivals")
+        workload = requests
+        data = json.loads((directory / "result.json").read_text())
+        manifest = json.loads((directory / "manifest.json").read_text())
+        cohort = comparison_cohort(manifest, data, directory.name)
+        if identity is not None and cohort != identity:
+            fields = sorted(key for key in set(identity) | set(cohort)
+                            if identity.get(key) != cohort.get(key))
+            raise ValueError(f"{directory.name}: incompatible comparison cohort: {', '.join(fields)}")
+        identity = cohort
+        mapping = json.loads((directory / "devices.json").read_text())
+        summary = summarize_profile(directory / "worker", expected_ranks=len(mapping),
+                                    rank_devices=mapping)
+        record = {"name": directory.name,
+                  "energy_j": sum(rank["energy_j"] for rank in summary["ranks"].values()),
+                  "mean_power_w": sum(rank["window_power_w"]
+                                      for rank in summary["ranks"].values()),
+                  "mean_ttft_ms": data["mean_ttft_ms"],
+                  "mean_tbt_ms": data["mean_itl_ms"],
+                  "p90_ttft_ms": data["p90_ttft_ms"],
+                  "p90_itl_ms": data["p90_itl_ms"],
+                  "p99_ttft_ms": data["p99_ttft_ms"],
+                  "p99_tbt_ms": data["p99_itl_ms"],
+                  "energy_kj": sum(rank["energy_j"]
+                                   for rank in summary["ranks"].values()) / 1000,
+                  "request_goodput": data["request_goodput"],
+                  "output_throughput": data["output_throughput"],
+                  "failed": data["failed"]}
+        tokens = data.get("total_output_tokens")
+        record["window_energy_per_output_token_j"] = (
+            record["energy_j"] / tokens if tokens is not None and tokens > 0 else None)
+        if record["failed"] or data.get("control_errors"):
+            raise ValueError(f"Pareto comparison includes failed request/control case {directory.name}")
+        if artifact_filters and (not record["mean_ttft_ms"]
+                or record["mean_ttft_ms"] > 2000
+                or record["p90_itl_ms"] is None
+                or record["p90_itl_ms"] > data["goodput_slos_seconds"]["tbt"] * 1000):
+            excluded.append({"case": directory.name,
+                             "reason": "artifact mean-TTFT<=2000ms / p90-TBT<=SLO filter"})
+            continue
+        records.append(record)
+    if not records:
+        write_json(root / "excluded.json", excluded)
+        raise ValueError("no comparable cases remain after explicit filters")
+    frontier = pareto_frontier(records, objectives)
+    write_json(root / "pareto.json", {"cases": records, "frontier": frontier,
+               "comparison_cohort": identity,
+               "objectives": objectives, "excluded": excluded,
+               "energy_domain": "sum of unique-rank whole-profile windows, staggered bounds"})
+    with (root / "comparison.csv").open("x", newline="") as stream:
+        writer = csv.DictWriter(stream, fieldnames=list(records[0]))
+        writer.writeheader()
+        writer.writerows(records)
+    x, y = list(objectives)[:2] if len(objectives) > 1 else ("energy_j", "p90_itl_ms")
+    svg_panels(root / "pareto.svg", [(f"Pareto: {y} vs {x}", [
+        {"name": "all cases", "points": [(row[x], row[y]) for row in records]},
+        {"name": "nondominated", "points": sorted((row[x], row[y]) for row in frontier)},
+    ])])
+    svg_panels(root / "latency-energy-comparison.svg", [
+        (f"{energy} vs {latency} (independent whole-profile windows)", [
+            {"name": "cases", "points": [(row[latency], row[energy]) for row in records]}
+        ]) for energy in ("mean_power_w", "energy_kj")
+        for latency in ("mean_ttft_ms", "mean_tbt_ms", "p90_ttft_ms", "p90_itl_ms",
+                        "p99_ttft_ms", "p99_tbt_ms")
+    ])
