+    assert beam.flush_remaining == 3
+    status = beam.update_microbatch_size(2)
+    assert status["microbatch_size"]["requested"] == 2
+    assert status["microbatch_size"]["effective"] == 4
+    assert status["microbatch_size"]["pending"] is True
+    beam.update_slo("tbt_slo", 0.2)
+    for _ in range(3):
+        empty = scheduler.schedule()
+        assert empty.total_num_scheduled_tokens == 0
+        retire(scheduler, empty)
+    assert beam.state == "RETIRE_ONLY"
+    assert not beam.maybe_commit_transition(queue_empty=True)
+    retire(scheduler, first)
+    retire(scheduler, work)
+    assert beam.maybe_commit_transition(queue_empty=True)
+    assert beam.num_microbatches == 2
+    assert beam.get_status()["microbatch_size"]["pending"] is False
+    beam.update_slo("tbt_slo", 0.15)
