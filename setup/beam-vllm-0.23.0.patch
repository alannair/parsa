+@pytest.mark.parametrize("stop_fails", [False, True])
+@pytest.mark.parametrize("custom", [False, True])
+def test_profile_writer_failure_stops_workers_and_preserves_start_error(
+    monkeypatch, tmp_path, stop_fails, custom,
+):
+    scheduler = create_scheduler()
+    beam = enable_beam(
+        scheduler, monkeypatch, custom_profiler=custom, use_s1=not custom,
+    )
+    core = core_for(scheduler)
