+class _Socket:
+    def __init__(self, response=None, ready=True):
+        import msgpack
+
+        self.response = msgpack.dumps(response) if response is not None else b"0"
+        self.ready = ready
+        self.sent = []
+        self.closed = False
+
+    def setsockopt_string(self, *args):
+        pass
+
+    def connect(self, address):
+        self.address = address
+
+    def send(self, data):
+        import msgpack
+
+        self.sent.append(msgpack.loads(data))
+
+    def recv(self):
+        return self.response
+
+    def poll(self, timeout, events):
+        return self.ready
+
+    def close(self, linger):
+        self.closed = True
+
+
+def _engine(metadata):
+    import threading
+    from collections import deque
+    from contextlib import nullcontext
+
+    import torch
+
+    from vllm.distributed.kv_transfer.kv_connector.v1.p2p.p2p_nccl_engine import (
+        P2pNcclEngine,
+    )
+
+    engine = object.__new__(P2pNcclEngine)
+    engine._beam_config = metadata
+    engine._beam_peers = {}
+    engine._beam_send_pending = 0
+    engine._beam_send_error = None
+    engine._beam_pool_quarantine = {}
+    engine._beam_pool_lock = threading.RLock() if metadata is not None else nullcontext()
+    engine.send_type = metadata["send_type"] if metadata is not None else "PUT"
+    engine.send_queue = deque()
+    engine.send_queue_cv = threading.Condition()
+    engine.send_store_cv = threading.Condition()
+    engine.recv_store_cv = threading.Condition()
+    engine.send_store = {}
+    engine.recv_store = {}
+    engine.send_request_id_to_tensor_ids = {}
+    engine.recv_request_id_to_tensor_ids = {}
+    engine.socks, engine.comms = {}, {}
+    engine.rank = (
+        metadata["pp_rank"] * metadata["tp_size"] + metadata["tp_rank"]
+        if metadata is not None else 1
+    )
+    engine.zmq_address = f"p:{10000 + engine.rank}"
+    engine.device = torch.device("cpu")
+    engine.send_stream = engine.recv_stream = object()
+    engine.buffer_size = 0
+    engine.buffer_size_threshold = 1000000
+    engine.nccl_num_channels = "8"
+    engine.config = SimpleNamespace(kv_port=10000)
+    return engine
