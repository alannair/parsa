+
+"""Real control chains with only the core/transport replaced; no engine startup."""
+
+import asyncio
+from concurrent.futures import Future
+from types import MethodType, SimpleNamespace
+
+import pytest
+
+
+def _parallel(policy="tbt", enabled=True):
+    from vllm.config import ParallelConfig
+
+    # Invoke the real policy gate without platform/worker initialization.
+    result = SimpleNamespace(
+        use_s1=enabled, use_s2=enabled, use_window_based_dvfs_only=False,
+        disagg_mode=False,
+        beam_s1_policy=policy, validate_beam_slo=ParallelConfig.validate_beam_slo,
+    )
+    result.validate_beam_slo_update = MethodType(
+        ParallelConfig.validate_beam_slo_update, result
+    )
+    return result
+
+
+def _async_frontend(policy="tbt", enabled=True, failure=False, dp=False):
+    from vllm.v1.engine.async_llm import AsyncLLM
+    from vllm.v1.engine.core_client import (
+        AsyncMPClient, DPLBAsyncMPClient, _process_utility_output,
+    )
+    from vllm.v1.engine import UtilityOutput, UtilityResult
+
+    # Use real utility selection and response processing, replacing only ZMQ/core.
+    state = {"rank0": {}, "rank1": {}}
+
+    async def transport(self, method, *args, engine):
+        assert method in {"update_tpot_slo", "update_tbt_slo", "update_ttft_slo"}
+        assert len(args) == 1
+        future = Future()
+        if failure:
+            output = UtilityOutput(
+                call_id=7, failure_message=f"Call to {method} method failed: no policy"
+            )
+        else:
+            state[engine][method] = args[0]
+            output = UtilityOutput(call_id=7, result=UtilityResult(None))
+        _process_utility_output(output, {7: future})
+        return future.result()
+
+    client = SimpleNamespace(
+        vllm_config=SimpleNamespace(parallel_config=_parallel(policy, enabled)),
+        core_engine="rank0", core_engines=["rank0", "rank1"],
+    )
+    client._call_utility_async = MethodType(transport, client)
+    client.call_utility_async = MethodType(
+        (
+            DPLBAsyncMPClient.call_utility_async
+            if dp else AsyncMPClient.call_utility_async
+        ),
+        client,
+    )
+    frontend = SimpleNamespace(engine_core=client)
+    for name in ("update_tpot_slo", "update_tbt_slo", "update_ttft_slo"):
+        setattr(
+            client, name + "_async",
+            MethodType(getattr(AsyncMPClient, name + "_async"), client),
+        )
+        setattr(frontend, name, MethodType(getattr(AsyncLLM, name), frontend))
+    return frontend, state
+
