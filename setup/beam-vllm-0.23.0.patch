+def test_lazy_uuid_binding_clock_validation_and_restore():
+    nvml = FakeNVML()
+    controller = GPUClockController(GPU_UUID.removeprefix("GPU-"), nvml=nvml)
+    assert nvml.calls == []
+    assert controller.set_clock(None) is None
+    assert nvml.calls == []
+    assert controller.set_clock(1500) == 1500
+    with pytest.raises(RuntimeError, match="supported"):
+        controller.set_clock(1400)
+    assert controller.current_clock_mhz is None  # Failed intents invalidate caches.
+    controller.close()
+    assert nvml.locked == (900, 1200)
+    assert nvml.calls[-1] == "shutdown"
+    controller.close()
