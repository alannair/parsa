+def _put_listener(engine, commands, responses, monkeypatch, events):
+    from contextlib import nullcontext
+
+    import msgpack
+    import torch
+    import zmq
+
+    messages = iter(commands)
+
+    class Router:
+        def recv_multipart(self):
+            return b"p:10001", msgpack.dumps(next(messages))
+
+        def send_multipart(self, response):
+            responses.append(response)
+            events.append(("ack", response[1]))
+
+    engine.router_socket = Router()
+    engine.poller = SimpleNamespace(poll=lambda: [(engine.router_socket, zmq.POLLIN)])
+    engine.comms["p:10001"] = ("comm", 1)
+    engine.recv_stream = SimpleNamespace(
+        cuda_stream=0, synchronize=lambda: events.append("NCCL receive complete"),
+    )
+    # Keep the real recv wrapper and fake only its CUDA context/NCCL boundary.
+    engine.nccl = SimpleNamespace(ncclRecv=lambda *args: events.append("NCCL receive"))
+    monkeypatch.setattr(torch.cuda, "stream", lambda stream: nullcontext())
+
