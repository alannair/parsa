+def _energy_csv(tmp_path, curves, name="profile.csv"):
+    # Curves specify (batch, max joules, latency at ctx=100, latency at ctx=300).
+    rows = []
+    for clock, points in curves.items():
+        for batch, energy, low_time, high_time in points:
+            rows.extend([
+                (batch, clock, 100, energy * 500, low_time),
+                (batch, clock, 300, energy * 1000, high_time),
+            ])
+    return _write_csv(tmp_path / name, ENERGY_COLUMNS, rows)
