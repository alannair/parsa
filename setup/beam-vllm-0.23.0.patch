+"""Pure CSV energy/latency estimates; no serving or hardware dependencies."""
+
+import csv
+import math
+import re
+from bisect import bisect_left
+from pathlib import Path
+
+
+def _number(value: object, name: str, *, positive: bool = False) -> float:
+    """Parse a finite nonnegative number, or a strictly positive metric."""
+    try:
+        number = float(value)
+    except (TypeError, ValueError, OverflowError) as exc:
+        raise ValueError(f"{name} must be a finite number") from exc
+    if (isinstance(value, bool) or not math.isfinite(number)
+            or number < 0 or (positive and number == 0)):
+        domain = "positive" if positive else "nonnegative"
+        raise ValueError(f"{name} must be finite and {domain}")
+    return number
+
+
+def _integer(value: object, name: str, *, positive: bool = False) -> int:
+    """Validate counts without truncating fractional values."""
+    if isinstance(value, int) and not isinstance(value, bool):
+        if value < 0 or (positive and value == 0):
+            raise ValueError(f"{name} is outside its integer domain")
+        return value
+    number = _number(value, name, positive=positive)
+    if not number.is_integer():
+        raise ValueError(f"{name} must be an integer")
+    return int(number)
+
+
+def _read_profile(
+    path: str, columns: tuple[str, ...], *, nonnegative: tuple[str, ...] = ()
+) -> list[dict[str, float]]:
+    """Read required numeric columns, retaining row order for endpoint ties."""
+    rows = []
+    with open(path, newline="", encoding="utf-8-sig") as stream:
+        reader = csv.DictReader(stream, strict=True)
+        fields = reader.fieldnames or []
+        missing = sorted(set(columns) - set(fields))
+        if missing:
+            raise ValueError(f"CSV missing required columns: {missing}")
+        if len(fields) != len(set(fields)):
+            raise ValueError("Duplicate CSV columns")
+        try:
+            for row in reader:
+                if None in row:
+                    raise ValueError("CSV row has more fields than its header")
+                rows.append({
+                    column: _number(row[column], column,
+                                    positive=column not in nonnegative)
+                    for column in columns
+                })
+        except (csv.Error, ValueError) as exc:
+            raise ValueError(f"{path}:{reader.line_num}: {exc}") from exc
+    if not rows:
+        raise ValueError("Profile contains no data rows")
+    return rows
+
+
+class EnergySimulator:
+    """Estimate joules and seconds using the artifact's healthy lookup rules.
+
+    Energy is the maximum across contexts after mJ-to-J conversion. Latency
+    interpolates the rows at minimum/maximum context, clipping the requested
+    context; None uses the maximum-context row. Ties retain the first CSV row.
+    Positive batches <=512 round up within that clock's measured batches;
+    larger batches interpolate. Both paths clamp to per-clock batch endpoints.
+    Zero work costs zero, even at an unprofiled clock. Negative/nonfinite input
+    and positive work at an unprofiled clock raise ValueError.
+
+    Names must be explicit or inferable from
+    dvfs_profile_<gpu>_<model>_tp<N>_pp<N>[_one].csv. A100 defaults remain
+    128/1050/1410; other GPUs use 128/1260/1800. Both default clocks must
+    contain a measured 128-token row, otherwise construction raises ValueError.
+    Sparse coverage at other clocks is supported without cross-clock lookups.
+    """
+
+    def __init__(
+        self,
+        profiling_csv_path: str,
+        num_pp: int,
+        num_tp: int,
+        gpu_name: str | None = None,
+        model_name: str | None = None,
+    ):
+        self.profiling_csv_path = profiling_csv_path
+        self.num_pp = _integer(num_pp, "num_pp", positive=True)
+        self.num_tp = _integer(num_tp, "num_tp", positive=True)
+        self.num_gpus = self.num_pp * self.num_tp
+        if gpu_name is None or model_name is None:
+            match = re.fullmatch(
+                r"dvfs_profile_([^_]+)_(.+)_tp\d+_pp\d+(?:_one)?\.csv",
+                Path(profiling_csv_path).name,
+            )
+            if match is None:
+                raise ValueError("Cannot infer GPU/model names; supply both explicitly")
+            if gpu_name is None:
+                gpu_name = match[1]
+            if model_name is None:
+                model_name = match[2]
+        if not isinstance(gpu_name, str) or not gpu_name.strip():
+            raise ValueError("gpu_name must be a nonempty string")
+        if not isinstance(model_name, str) or not model_name.strip():
+            raise ValueError("model_name must be a nonempty string")
+        self.gpu_name = gpu_name
+        self.model_name = model_name
+        gpu = gpu_name.upper()
+        self.min_clock = 800 if "A6000" in gpu else 500
+        self.default_chunk_size = 128
+        self.default_clock = 1050 if "A100" in gpu else 1260
+        self.default_clock_high = 1410 if "A100" in gpu else 1800
+        self.standard_clock = 1410 if "100" in gpu else 1800
+        self.standard_model_prefill_size = 256
+        self.dvfs_delay = .01
+        self.scheduling_overhead = .012
+        self.scheduling_overhead_decode_only = .003 * self.num_pp
+
+        rows = _read_profile(profiling_csv_path, (
+            "batch_size", "clock", "total_ctx_len", "energy_consumption", "time_taken"
+        ), nonnegative=("total_ctx_len",))
+        self._energy: dict[int, dict[int, float]] = {}
+        self._time: dict[int, dict[int, tuple[float, float, float, float]]] = {}
+        for row in rows:
+            clock = _integer(row["clock"], "clock", positive=True)
+            batch = _integer(row["batch_size"], "batch_size", positive=True)
+            if clock < self.min_clock:
+                continue
+            energies = self._energy.setdefault(clock, {})
+            times = self._time.setdefault(clock, {})
+            energy = row["energy_consumption"] / 1000
+            if energy <= 0:
+                raise ValueError("Energy underflows during mJ-to-J conversion")
+            energies[batch] = max(energies.get(batch, energy), energy)
+            ctx, latency = row["total_ctx_len"], row["time_taken"]
+            low_ctx, high_ctx, low_time, high_time = times.get(
+                batch, (ctx, ctx, latency, latency))
+            if ctx < low_ctx:
+                low_ctx, low_time = ctx, latency
+            if ctx > high_ctx:
+                high_ctx, high_time = ctx, latency
+            times[batch] = (low_ctx, high_ctx, low_time, high_time)
+
+        self.available_clocks = sorted(self._energy)
+        for clock in (self.default_clock, self.default_clock_high):
+            if self.default_chunk_size not in self._energy.get(clock, {}):
+                raise ValueError(
+                    f"Profile missing default coverage: batch=128, clock={clock}")
+        self._batches = {clock: sorted(points)
+                         for clock, points in self._energy.items()}
+        self.profiled_batch_sizes = sorted({
+            batch for points in self._batches.values() for batch in points
+        })
+        self.available_chunk_sizes = [
+            batch for batch in (128, 256, 320, 384, 448, 512)
+            if batch in self.profiled_batch_sizes
+        ]
+
+    def _bounds(self, batch: int, clock: int) -> tuple[int, int, float]:
+        if clock not in self._batches:
+            raise ValueError(f"No data for clock {clock}")
+        batches = self._batches[clock]
+        index = bisect_left(batches, batch)
+        if index == len(batches):
+            return batches[-1], batches[-1], 0.0
+        upper = batches[index]
+        if batch <= 512 or index == 0 or upper == batch:
+            return upper, upper, 0.0
+        lower = batches[index - 1]
+        return lower, upper, (batch - lower) / (upper - lower)
+
+    def get_energy(self, batch_size: int, clock: int) -> float:
+        """Return the maximum energy across contexts in joules."""
+        batch_size = _integer(batch_size, "batch_size")
+        if batch_size == 0:
+            return 0.0
+        clock = _integer(clock, "clock", positive=True)
+        lower, upper, alpha = self._bounds(batch_size, clock)
+        low = self._energy[clock][lower]
+        high = self._energy[clock][upper]
+        return (1 - alpha) * low + alpha * high
+
+    def get_time_taken(
+        self, batch_size: int, clock: int, total_ctx_len: int | None = None
+    ) -> float:
+        """Return seconds; fractional contexts from S2 are also accepted."""
+        batch_size = _integer(batch_size, "batch_size")
+        ctx = None if total_ctx_len is None else _number(total_ctx_len, "total_ctx_len")
+        if batch_size == 0:
+            return 0.0
+        clock = _integer(clock, "clock", positive=True)
+        lower, upper, alpha = self._bounds(batch_size, clock)
+
+        def at_context(batch: int) -> float:
+            low_ctx, high_ctx, low_time, high_time = self._time[clock][batch]
+            if ctx is None or low_ctx == high_ctx:
+                return high_time
+            clipped = min(high_ctx, max(low_ctx, ctx))
+            weight = (clipped - low_ctx) / (high_ctx - low_ctx)
+            return (1 - weight) * low_time + weight * high_time
+
+        low, high = at_context(lower), at_context(upper)
+        return (1 - alpha) * low + alpha * high
