+def visualize_run(directory, output):
+    directory, output = Path(directory), Path(output)
+    output.mkdir(parents=True, exist_ok=False)
+    data = json.loads((directory / "result.json").read_text())
+    samples = data.get("monitor_samples", [])
+    timelines = timeline_panels(directory / "worker", samples)
+    timelines.append(("Client TTFT ms vs HTTP dispatch elapsed seconds", [
+        {"name": "TTFT", "points": [(entry, first * 1000)
+          for ok, entry, first in zip(data["successes"], data["dispatch_times"],
+                                      data["ttfts"], strict=True) if ok]}]))
+    phases = data.get("phase_info", [])
+    if phases:
+        timelines.append(("Offered synthetic phase requests/s vs client elapsed seconds", [
+            {"name": "phase target rate", "points": phase_step_points(phases)}]))
+    svg_panels(output / "timeline.svg", timelines)
+    panels = []
+    for key, title in (("ttfts", "TTFT"), ("e2el", "End-to-last-token latency")):
+        points = [(i, number(value) * 1000) for i, (ok, value) in enumerate(zip(
+            data["successes"], data[key], strict=True)) if ok and value is not None]
+        panels.append((title + " milliseconds vs request index",
+                       [{"name": title, "points": points}]))
+    itls = [number(value) * 1000 for ok, gaps in zip(
+        data["successes"], data["itls"], strict=True) if ok for value in gaps]
+    panels.append(("Stream ITL milliseconds vs interval index", [
+        {"name": "ITL (not guaranteed token gaps)", "points": list(enumerate(itls))}]))
+    tpots = [(i, (latency - first) / (count - 1) * 1000)
+             for i, (ok, latency, first, count) in enumerate(zip(
+                 data["successes"], data["e2el"], data["ttfts"], data["output_lens"],
+                 strict=True)) if ok and count is not None and count > 1]
+    panels.append(("TPOT milliseconds vs request index", [{"name": "TPOT", "points": tpots}]))
+    firsts = [(i, estimate * 1000) for i, (ok, estimate) in enumerate(zip(
+        data["successes"], data["estimated_ttfts"], strict=True)) if ok and estimate is not None]
+    panels[0][1].append({"name": "estimated TTFT", "points": firsts})
+    paired = []
+    for ok, gaps, estimates, count, chunks, complete in zip(
+        data["successes"], data["itls"], data["estimated_tbts_list"],
+        data["output_lens"], data["stream_token_chunks"],
+        data.get("token_id_coverage_complete", [False] * len(data["successes"])), strict=True,
+    ):
+        if ok and complete is True and count is not None and count == chunks == len(estimates or []):
+            paired.extend(zip(gaps, estimates[1:]))
+    panels.append(("Token-aligned actual/estimated TBT ms (grouped streams excluded)", [
+        {"name": name, "points": [(i, pair[column] * 1000)
+                                   for i, pair in enumerate(paired)]}
+        for name, column in (("actual", 0), ("estimated", 1))]))
+    svg_panels(output / "latency-fidelity.svg", panels)
