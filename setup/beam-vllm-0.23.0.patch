+            clock = _integer(row["clock"], "clock", positive=True)
+            tp = _integer(row["tp"], "tp", positive=True)
+            pp = _integer(row["pp"], "pp", positive=True)
+            tps = _integer(row["tps"], "tps", positive=True)
+            key = tp, pp, clock, tps
+            if key in seen:
+                raise ValueError(f"Duplicate profile configuration: {key}")
+            seen.add(key)
+            choice = ClockChoice(
+                tp, pp, clock, tps, row["gpu_power"],
+                row["ttft_p99" if use_ttft_p99 else "ttft_mean"],
+                row["tbt_p90" if use_tbt_p90 else "tbt_mean"], False,
+            )
+            self._profiles.setdefault((tp, pp), {}).setdefault(clock, []).append(choice)
+        for clocks in self._profiles.values():
+            for points in clocks.values():
+                points.sort(key=lambda point: point.target_tps)
+
+    def choose(
