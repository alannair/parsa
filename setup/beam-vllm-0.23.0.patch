+
+"""Optional admission/telemetry state; upstream still owns all token/KV state.
+
+S2 estimates retain the artifact's ranking, but are heuristic snapshots: a
+physical-PP phase and strict result-retirement guard can delay an invocation.
+The engine FIFO and the worker's sample-carry ring are separate drain domains.
+"""
+
+import csv
+import math
+import os
+import time
+from copy import copy
+from itertools import chain
+from pathlib import Path
+from typing import TYPE_CHECKING
+from weakref import WeakKeyDictionary
+
+from .beam_policy import S1Decision, S2Decision, choose_s1, choose_s1_tpot, choose_s2
+from .dynamo_energy_model import ClockSelector
+from .energy_model import EnergySimulator
+
+if TYPE_CHECKING:
+    from vllm.v1.request import Request
+
+    from .output import SchedulerOutput
+    from .scheduler import Scheduler
+
+
+class BeamScheduler:
+    def __init__(self, scheduler: "Scheduler"):
+        self.scheduler = scheduler
+        self.config = scheduler.parallel_config
+        self.pp = self.config.pipeline_parallel_size
+        self.tp = self.config.tensor_parallel_size
+        self.ttft_slo = self.config.beam_ttft_slo
+        self.tbt_slo = self.config.beam_tbt_slo
+        self.tpot_slo = self.config.beam_tpot_slo
+        self.model: EnergySimulator | None = None
+        if self.config.use_s1 or self.config.use_s2:
+            assert self.config.beam_profile_path is not None
+            self.model = EnergySimulator(
+                self.config.beam_profile_path, self.pp, self.tp,
+                gpu_name=self.config.beam_gpu_name,
+                model_name=scheduler.vllm_config.model_config.model,
+            )
+        self.clock_selector: ClockSelector | None = None
+        if self.config.use_window_based_dvfs_only:
+            assert self.config.beam_dynamo_profile_path is not None
+            self.clock_selector = ClockSelector(
+                self.config.beam_dynamo_profile_path,
+                self.ttft_slo * 1000, self.tbt_slo * 1000,
+                use_tbt_p90=True, use_ttft_p99=False,
+            )
+            if self.clock_selector.choose(self.tp, self.pp, 0) is None:
+                raise ValueError(
+                    "BEAM DynamoLLM profile has no matching TP/PP topology"
+                )
+        self.state = "ACTIVE"
+        self.num_microbatches = self.pp
+        self.flush_remaining = 0
+        self.dirty = True
+        self.s1_decision: S1Decision | None = None
+        self.s2_decision: S2Decision | None = None
+        self.clock = self.model.default_clock if self.model is not None else None
+        self.last_chunk = self.model.default_chunk_size if self.model else 0
+        self.last_prefill_at = 0.0
+        self.last_prefill_ttft = 0.0
+        self.decode_only_steps = 0
+        self._had_prefill = False
+        self._schedule_started = 0.0
+        self._selected_sampling: set[Request] = set()
+        self._selected_prefill: dict[Request, int] = {}
+        self._s1_num_running = 0
+        self._owners: dict[Request, int] = {}
+        self._generation: WeakKeyDictionary[Request, int] = WeakKeyDictionary()
+        self._queued_at: WeakKeyDictionary[Request, float] = WeakKeyDictionary()
+        # Strong references last only until the exact dispatched invocation is
+        # retired. No Request objects travel in SchedulerOutput to workers.
+        self._invocations: dict[int, dict[str, tuple[Request, int]]] = {}
+        self._sampling: dict[str, tuple[Request, int]] = {}
+        self._next_invocation = 0
+        self.window_started = time.monotonic()
+        self.window_tokens = 0
+        self.tps_ema = 0.0
+        self.log_namespace = (
+            f"scheduler-dp{self.config.data_parallel_rank}"
+            f"-rank{self.config.rank}-pid{os.getpid()}"
+        )
+        self._log_files = {}
+        self._writers = {}
+        # Intentional repair of the artifact's auto-overwritten manual controls:
+        # requested overrides persist until clear/new manual input/restart.
+        self.manual_chunk_size: int | None = None
+        self.manual_microbatch_size: int | None = None
+        self._active_chunk_override: int | None = None
+        self._seen_manual_m: int | None = None
+        self._chunk_revision = self._chunk_seen_revision = 0
+        self._m_revision = self._m_seen_revision = 0
+        self._effective_chunk_limit = scheduler.max_num_scheduled_tokens
+        self._chunk_model_available: bool | None = None
+
+    @property
+    def should_dispatch(self) -> bool:
+        return self.state != "RETIRE_ONLY"
+
+    @property
+    def has_work(self) -> bool:
+        return self._chunk_revision != self._chunk_seen_revision or (
+            self.config.use_s2 and (
+                self.state != "ACTIVE"
+                or bool(self._invocations)
+                or self._m_revision != self._m_seen_revision
+                or (self.dirty and (
+                    self.num_microbatches != self.pp
+                    or self.manual_microbatch_size is not None
+                ))
+            )
+        )
+
+    def update_chunk_size(
+        self, chunk_size: int | None = None, *, clear: bool = False,
+    ) -> dict:
+        self.config.validate_beam_control_update(
+            "chunk_size", chunk_size, clear=clear,
+            max_chunk_size=self.scheduler.max_num_scheduled_tokens,
+        )
+        self.manual_chunk_size = None if clear else chunk_size
+        self._chunk_revision += 1
+        return self.get_status()
+
+    def update_microbatch_size(
+        self, microbatch_size: int | None = None, *, clear: bool = False,
+    ) -> dict:
+        self.config.validate_beam_control_update(
+            "microbatch_size", microbatch_size, clear=clear,
+            max_chunk_size=self.scheduler.max_num_scheduled_tokens,
+        )
+        self.manual_microbatch_size = None if clear else microbatch_size
+        self._m_revision += 1
+        self.dirty = True
+        return self.get_status()
+
+    def get_status(self) -> dict:
+        """Read local state without running policies or applying commands.
+
+        requested=None denotes AUTO. The effective chunk is the last boundary's
+        admission cap, not a claim about already queued batches or actual token
+        counts. Applied m denotes a committed phase count, not an SLO guarantee.
+        """
+        self.config.validate_beam_enabled()
+        prefill = self._prefill_pending()
+        superseded = (
+            prefill and self.manual_microbatch_size is not None
+            and self.manual_microbatch_size != self.pp
+        )
+        chunk_pending = self._chunk_revision != self._chunk_seen_revision
+        m_pending = self.config.use_s2 and (
+            self.state != "ACTIVE" or self._m_revision != self._m_seen_revision
+            or (self.manual_microbatch_size is None and self.dirty
+                and (bool(self._live_requests()) or self.num_microbatches != self.pp))
+            or (self.manual_microbatch_size is not None
+                and (self.num_microbatches != self.manual_microbatch_size or superseded))
+        )
+        return {
+            "status": "queued" if chunk_pending or m_pending else "applied",
+            "data_parallel_rank": self.config.data_parallel_rank,
+            "physical_pp": self.pp, "state": self.state,
+            "step": self.scheduler.current_step,
+            "flush_remaining": self.flush_remaining,
+            "outstanding_invocations": len(self._invocations),
+            "chunk_size": {
+                "requested": self.manual_chunk_size,
+                "effective": self._effective_chunk_limit,
+                "manual": self.manual_chunk_size is not None,
+                "pending": chunk_pending,
+                "hard_ceiling": self.scheduler.max_num_scheduled_tokens,
+                "model_available": self._chunk_model_available,
+            },
+            "microbatch_size": {
+                "requested": self.manual_microbatch_size,
+                "effective": self.num_microbatches,
+                "manual": self.manual_microbatch_size is not None,
+                "pending": m_pending, "supported": self.config.use_s2,
+                "prefill_superseded": superseded,
+            },
+            "cohort_sizes": list(self.cohort_sizes()) if self.config.use_s2 else [],
+            "prediction_is_heuristic": self.model is not None,
+        }
+
+    def queued(self, request: "Request", *, new_incarnation: bool = False) -> None:
+        # v0.23 InputProcessor sends wall-clock arrival_time. Convert its age
+        # once at ingress; all subsequent policy elapsed times are monotonic.
+        now = time.monotonic()
+        self._queued_at[request] = now - max(0.0, time.time() - request.arrival_time)
+        if new_incarnation:
+            self._generation[request] = self._generation.get(request, 0) + 1
+            self.invalidate(request)
+            request._estimated_ttft = None
+            request._output_token_estimated_tbts.clear()
+            request._output_token_tbts.clear()
+            request._last_output_append_time = None
+            request._last_timed_output_token_count = 0
+        self.dirty = True
+
+    def invalidate(self, request: "Request") -> None:
+        self._owners.pop(request, None)
+        self._selected_sampling.discard(request)
+        self._selected_prefill.pop(request, None)
+        # Abort/preemption invalidates phase ownership, never an in-flight
+        # sampling guard. Only retire() is allowed to release that guard.
+        self.dirty = True
+
+    def sampling_pending(self, request: "Request") -> bool:
+        # Also serialize replacement objects with the same worker-facing ID.
+        return request.request_id in self._sampling
+
+    def _live_requests(self) -> list["Request"]:
+        from vllm.v1.request import RequestStatus
+
+        return [
+            request for request in chain(
+                self.scheduler.running,
+                self.scheduler.waiting,
+                self.scheduler.skipped_waiting,
+            )
+            if not request.is_finished()
+            and request.status != RequestStatus.WAITING_FOR_STREAMING_REQ
+        ]
+
+    def _prefills(self) -> list[tuple["Request", int]]:
+        from vllm.v1.request import RequestStatus
+
+        prefills = []
+        for request in self._live_requests():
+            target = (
+                max(request.num_prompt_tokens, request.num_tokens - 1)
+                if request.status == RequestStatus.RUNNING else request.num_tokens
+            )
+            remaining = max(0, target - request.num_computed_tokens)
+            if remaining:
+                prefills.append((request, remaining))
+        return prefills
+
+    def remaining_prefill_tokens(self) -> int:
+        return sum(remaining for _, remaining in self._prefills())
+
+    def _prefill_pending(self) -> bool:
+        from vllm.v1.request import RequestStatus
+
+        # A full async prefix hit can have zero remaining counted work while
+        # still waiting for transfer/promotion and final-token recomputation.
+        return bool(self._prefills()) or any(
+            request.status != RequestStatus.RUNNING for request in self._live_requests()
+        )
+
+    def cohort_sizes(self) -> tuple[int, ...]:
+        loads = [0] * self.num_microbatches
+        for phase in self._owners.values():
+            loads[phase] += 1
+        return tuple(loads)
+
+    def _desired_s2(self) -> int:
+        self.dirty = False
+        self._m_seen_revision = self._m_revision
+        self._seen_manual_m = self.manual_microbatch_size
+        started = time.monotonic()
+        # Pending new/resumed/prefill work always requests physical P before
+        # admission. In particular, final-prefill sampling is not an exception.
+        if self._prefill_pending():
+            self.s2_decision = None
+            self._log("s2_log", self.pp)
+            self._log("s2_exec_time_log", time.monotonic() - started)
+            return self.pp
+        live = self._live_requests()
+        if not live and self.manual_microbatch_size is None:
+            self.s2_decision = None
+            return self.pp
+        assert self.model is not None
+        self.s2_decision = choose_s2(
+            self.model, num_running=len(live),
+            total_ctx_len=sum(r.num_tokens for r in live),
+            tbt_slo=self.tbt_slo, fixed_m=self.manual_microbatch_size,
+        )
+        self._log("s2_log", self.s2_decision.num_microbatches)
+        self._log("s2_exec_time_log", time.monotonic() - started)
+        return self.s2_decision.num_microbatches or self.pp
+
+    def maybe_commit_transition(self, *, queue_empty: bool) -> bool:
+        if self.state != "RETIRE_ONLY" or not queue_empty or self._invocations:
+            return False
+        # Coalesce arrivals, cancellations and SLO changes during the fixed
+        # flush. Recompute once at the drained boundary, never restart a flush.
+        new_m = self._desired_s2()
+        survivors = [
+            request for request in self._owners
+            if self.scheduler.requests.get(request.request_id) is request
+            and not request.is_finished()
+        ]
+        self._owners.clear()
+        self.num_microbatches = new_m
+        loads = [0] * new_m
+        for request in survivors:
+            phase = min(range(new_m), key=loads.__getitem__)
+            self._owners[request] = phase
+            loads[phase] += 1
+        self.state = "ACTIVE"
+        # current_step and next_decode_eligible_step belong to upstream and
+        # remain absolute across all transitions.
+        return True
+
+    def begin_step(self, token_budget: int) -> int:
+        self._schedule_started = time.monotonic()
+        self._selected_sampling.clear()
+        self._selected_prefill.clear()
+        self.s1_decision = None
+        self._active_chunk_override = self.manual_chunk_size
+        self._chunk_seen_revision = self._chunk_revision
+        self._effective_chunk_limit = (
+            self._active_chunk_override or self.scheduler.max_num_scheduled_tokens
+        )
+        self._chunk_model_available = (
+            self.model is not None
+            and self._active_chunk_override in self.model.profiled_batch_sizes
+            if self._active_chunk_override is not None else None
+        )
+        token_budget = min(token_budget, self._effective_chunk_limit)
+        prefills = self._prefills()
+        self._had_prefill = self._prefill_pending()
+        if self.config.use_s2 and self.state == "ACTIVE" and self.dirty:
+            if self._desired_s2() != self.num_microbatches:
+                self.state = "FLUSH"
+                self.flush_remaining = self.pp
+        if self.state != "ACTIVE":
+            return 0
+        phase = self.scheduler.current_step % self.pp
+        if self.config.use_s2 and phase >= self.num_microbatches:
+            return 0
+        if (
+            self.model is not None and prefills and token_budget
+            and (self.config.use_s1 or self._active_chunk_override is not None)
+        ):
+            token_budget = self._s1_budget(token_budget, prefills)
+            self._effective_chunk_limit = token_budget
+        return token_budget
+
+    def _s1_budget(self, budget: int, prefills: list[tuple["Request", int]]) -> int:
+        model = self.model
+        assert model is not None
+        started = time.monotonic()
+        self._s1_num_running = len(self.scheduler.running)
+        chunks = model.available_chunk_sizes
+        prefill_in_flight = any(
+            request in self.scheduler.running and request.num_computed_tokens > 0
+            for request, _ in prefills
+        ) or any(
+            request.num_output_tokens == 0
+            for snapshot in self._invocations.values()
+            for request, _ in snapshot.values()
+        )
+        if self._active_chunk_override is not None:
+            chunks = [self._active_chunk_override]
+            if not self._chunk_model_available:
+                self.clock = model.default_clock_high
+                self._log("s1_exec_time_log", time.monotonic() - started)
+                return budget
+        elif self.last_chunk in chunks and (
+            prefill_in_flight
+            or started - self.last_prefill_at < self.last_prefill_ttft
+        ):
+            index = chunks.index(self.last_chunk)
+            chunks = chunks[max(0, index - 1):index + 2]
+        candidates = [256] if self.config.use_s1_dvfs_only else chunks
+        eligible = [
+            size for size in candidates
+            if size <= budget and (
+                self.config.beam_s1_policy == "tpot"
+                or size > len(self.scheduler.running) // self.pp
+            )
+        ]
+        if not eligible:
+            # No profiled candidate can respect the target budget/capacity.
+            # Keep upstream progress at high clock and mark model infeasibility;
+            # never invent an out-of-budget candidate or swallow profile errors.
+            self.clock = model.default_clock_high
+            self._log("s1_exec_time_log", time.monotonic() - started)
+            return min(budget, 256) if self.config.use_s1_dvfs_only else budget
+        work = sum(remaining for _, remaining in prefills)
+        queue_time = max((
+            max(0.0, started - self._queued_at.get(request, started))
+            for request, _ in prefills if request not in self.scheduler.running
+        ), default=0.0)
+        if self.config.beam_s1_policy == "tpot":
+            # Its API takes a model catalog instead of a chunk subset. A shallow
+            # copy restricts candidates without mutating the shared CSV model.
+            policy_model = copy(model)
+            policy_model.available_chunk_sizes = chunks
+            self.s1_decision = choose_s1_tpot(
+                policy_model,
+                histories=[r._output_token_tbts for r in self.scheduler.running],
+                tpot_slo=self.tpot_slo, ttft_slo=self.ttft_slo,
+                prefill_tokens=work, max_chunk_size=budget,
+                remaining_prefill_time=max(
+                    0.0, self.last_prefill_ttft - (started - self.last_prefill_at)
+                ),
+            )
+        else:
+            self.s1_decision = choose_s1(
+                model, prefill_tokens=work, num_running=len(self.scheduler.running),
+                tbt_slo=self.tbt_slo, ttft_slo=self.ttft_slo,
+                queue_time=queue_time, dvfs_only=self.config.use_s1_dvfs_only,
+                disagg=self.config.disagg_mode, max_chunk_size=budget,
+                chunk_sizes=chunks,
+            )
+        self.last_chunk = self.s1_decision.chunk_size
+        self.clock = self.s1_decision.clock
+        self._log("s1_log", self.last_chunk)
+        self._log("s1_exec_time_log", time.monotonic() - started)
+        return min(budget, self.last_chunk)
+
+    def can_schedule(self, request: "Request", count: int, computed: int) -> bool:
+        if not self.config.use_s2:
+            return True
+        if self.sampling_pending(request):
+            return False
+        if computed + count < request.num_tokens + request.num_output_placeholders:
+            return True  # nonfinal prefill, no sampling ownership yet
+        phase = self.scheduler.current_step % self.pp
+        owner = self._owners.get(request)
+        if owner is not None:
+            return phase == owner
+        loads = list(self.cohort_sizes())
+        for selected in self._selected_sampling:
+            if selected not in self._owners:
+                loads[phase] += 1
+        # Ties can use the present phase. This keeps actual live ownership
+        # balanced without basing phases on a shifting running-list index.
+        return loads[phase] == min(loads)
+
+    def selected(self, request: "Request", count: int, computed: int) -> None:
+        if computed < max(request.num_prompt_tokens, request.num_tokens - 1):
+            self._selected_prefill[request] = max(
+                0, request.num_prompt_tokens - computed
+            )
+        if computed + count >= request.num_tokens + request.num_output_placeholders:
+            self._selected_sampling.add(request)
+
+    def finalize(self, output: "SchedulerOutput") -> None:
+        """Commit only the final allocation/preemption result, after upstream."""
+        output.beam_step = self.scheduler.current_step
+        output.beam_phase = self.scheduler.current_step % self.pp
+        output.beam_num_microbatches = self.num_microbatches
+        output.beam_prediction_is_heuristic = self.model is not None
+        output.beam_chunk_size = self._effective_chunk_limit
+        output.beam_manual_chunk_size = self._active_chunk_override
+        output.beam_manual_microbatch_size = self._seen_manual_m
+        output.beam_chunk_model_available = self._chunk_model_available
+        if self.state == "FLUSH":
+            assert output.total_num_scheduled_tokens == 0
+            self.flush_remaining -= 1
+            if self.flush_remaining == 0:
+                self.state = "RETIRE_ONLY"
+        selected = [
+            self.scheduler.requests[rid] for rid in output.num_scheduled_tokens
+        ]
+        has_prefill = any(request in self._selected_prefill for request in selected)
+        self._window_update(output.total_num_scheduled_tokens)
+        if has_prefill:
+            self.decode_only_steps = 0
+            self.last_prefill_at = time.monotonic()
+            self.last_prefill_ttft = (
+                self.s1_decision.ttft if self.s1_decision else 0.0
+            )
+        else:
+            self.decode_only_steps += 1
+        if selected:
+            self._next_invocation += 1
+            invocation = self._next_invocation
+            output.beam_invocation_id = invocation
+            self._invocations[invocation] = {
+                request.request_id: (request, self._generation.get(request, 0))
+                for request in selected
+            }
+            sampling = [request for request in selected if not request.is_prefill_chunk]
+            output.beam_sampling_req_ids = tuple(r.request_id for r in sampling)
+            if self.config.use_s2:
+                for request in sampling:
+                    assert not self.sampling_pending(request)
+                    self._sampling[request.request_id] = (request, invocation)
+                    self._owners.setdefault(request, output.beam_phase)
+                output.beam_request_phases = tuple(
+                    (request.request_id, self._owners[request]) for request in sampling
+                )
+            if self.model is not None:
+                if self.config.use_s2 and not has_prefill and self.s2_decision:
+                    self.clock = self.s2_decision.clock
+                elif (
+                    has_prefill and not self.config.use_s1
+                    and self._active_chunk_override is None
+                ):
+                    self.clock = self.model.default_clock
+                elif not self.config.use_s2 and self.decode_only_steps >= 5:
+                    self.clock = self.model.default_clock
+                if has_prefill and (
+                    self.config.use_s1 or self._active_chunk_override is not None
+                ):
+                    output.beam_model_feasible = (
+                        self.s1_decision.feasible if self.s1_decision else False
+                    )
+                elif not has_prefill and self.s2_decision:
+                    output.beam_model_feasible = self.s2_decision.feasible
+            output.beam_clock_mhz = self.clock
+            if self.config.measure_fidelity and not (
+                has_prefill and self._active_chunk_override is not None
+                and not self._chunk_model_available
+            ):
+                assert self.model is not None
+                assert self.clock is not None
+                overhead = (
+                    self.model.scheduling_overhead if has_prefill
+                    else self.model.scheduling_overhead_decode_only
+                )
+                # Actual finalized batch size/context, never TPOT S1Decision.tbt
+                # or an assumed ceil(n/m) cohort in place of the batch dispatched.
+                output.expected_tbt = (
+                    self.model.get_time_taken(
+                        output.total_num_scheduled_tokens, self.clock,
+                        None if has_prefill else sum(r.num_tokens for r in selected),
+                    ) + overhead
+                ) * self.pp
+                now = time.monotonic()
+                for request in selected:
+                    if (
+                        request._estimated_ttft is None
+                        and request.num_output_tokens == 0
+                    ):
+                        remaining = self._selected_prefill.get(request, 0)
+                        chunk = (
+                            self.s1_decision.chunk_size if self.s1_decision
+                            else min(
+                                self._effective_chunk_limit, remaining
+                            )
+                        )
+                        if chunk:
+                            capacity = (
+                                chunk - self._s1_num_running // self.pp
+                                if self.s1_decision
+                                and self.config.beam_s1_policy == "tbt"
+                                else chunk
+                            )
+                            assert capacity > 0
+                            chunks = (remaining + capacity - 1) // capacity
+                            latency = self.model.get_time_taken(chunk, self.clock)
+                            queued = max(
+                                0.0, now - self._queued_at.get(request, now)
+                            )
+                            request._estimated_ttft = (
+                                (chunks + self.pp - 1)
+                                * (latency + self.model.scheduling_overhead) + queued
+                            )
+        output.beam_cohort_sizes = self.cohort_sizes() if self.config.use_s2 else ()
+        if self._had_prefill and not self._prefill_pending():
+            self.dirty = True
+        self._log("kv_usage_log", self.scheduler.kv_cache_manager.usage)
+        self._log("schedule_exec_time_log", time.monotonic() - self._schedule_started)
+
+    def matches(self, output: "SchedulerOutput", rid: str, request: "Request") -> bool:
+        if output.beam_invocation_id is None:
+            return False
+        snapshot = self._invocations.get(output.beam_invocation_id, {}).get(rid)
+        return snapshot is not None and (
+            snapshot[0] is request
+            and snapshot[1] == self._generation.get(request, 0)
+        )
+
+    def retire(self, output: "SchedulerOutput") -> None:
+        invocation = output.beam_invocation_id
+        if invocation is None:
+            return
+        snapshot = self._invocations.pop(invocation, {})
+        for rid, (request, _) in snapshot.items():
+            if self._sampling.get(rid) == (request, invocation):
+                del self._sampling[rid]
+
+    def _window_update(self, tokens: int) -> None:
+        if self.clock_selector is None:
+            return
+        self.window_tokens += tokens
+        now = time.monotonic()
+        elapsed = now - self.window_started
+        if elapsed < 5.0:
+            return
+        instantaneous = self.window_tokens / elapsed
+        self.tps_ema = (
+            instantaneous if self.tps_ema == 0.0
+            else 0.2 * instantaneous + 0.8 * self.tps_ema
+        )
+        choice = self.clock_selector.choose(self.tp, self.pp, int(self.tps_ema))
+        if choice is None:
+            raise ValueError("BEAM DynamoLLM profile has no matching TP/PP topology")
+        self.clock = choice.freq_mhz
+        self.window_tokens = 0
+        self.window_started = now
+
+    def update_slo(self, name: str, value: float) -> None:
+        self.config.validate_beam_slo_update(name, value)
+        if (
+            self.clock_selector is not None
+            and name in ("ttft_slo", "tbt_slo")
+            and not math.isfinite(value * 1000)
+        ):
+            raise ValueError("BEAM SLO overflows the millisecond profile domain")
+        setattr(self, name, value)
+        setattr(self.config, f"beam_{name}", value)
+        if self.clock_selector is not None:
+            self.clock_selector.ttft_slo_ms = self.ttft_slo * 1000
+            self.clock_selector.tbt_slo_ms = self.tbt_slo * 1000
+        self.dirty = True
+
+    def profile_directory(self, output_dir: str | None, prefix: str | None) -> Path:
+        # EngineCore owns resolution so the worker and scheduler share a base.
+        if output_dir is None or not str(output_dir).strip():
+            raise ValueError("BEAM profiling requires output_dir or beam_log_dir")
+        path = Path(output_dir)
+        if prefix:
+            if Path(prefix).name != prefix or prefix in (".", ".."):
+                raise ValueError("BEAM profile_prefix must be one directory name")
+            path /= prefix
+        return path / self.log_namespace
+
+    def start_profile(self, directory: Path) -> None:
+        if self._log_files:
+            raise RuntimeError("BEAM scheduler profiling is already active")
+        directory.mkdir(parents=True, exist_ok=True)
+        columns = {
+            "s1_log": "optimal_chunk_size", "s2_log": "optimal_num_microbatches",
+            "kv_usage_log": "usage", "s1_exec_time_log": "execution_time",
+            "s2_exec_time_log": "execution_time",
+            "schedule_exec_time_log": "execution_time",
+        }
+        try:
+            for name, value_column in columns.items():
+                stream = (directory / f"{name}.csv").open(
+                    "w", newline="", encoding="utf-8"
+                )
+                self._log_files[name] = stream
+                writer = csv.writer(stream)
+                writer.writerow(("timestamp", value_column))
+                self._writers[name] = writer
+        except BaseException as start_error:
+            try:
+                self.stop_profile()
+            except Exception as close_error:
+                raise start_error from close_error
+            raise
+
+    def _log(self, name: str, value: float) -> None:
+        if name in self._writers:
+            self._writers[name].writerow((time.time(), value))
+
+    def stop_profile(self) -> None:
+        for stream in self._log_files.values():
+            stream.close()
+        self._log_files.clear()
+        self._writers.clear()
