+@pytest.mark.parametrize("pp", [1, 2, 4])
+@pytest.mark.parametrize("v2", [False, True])
+def test_owned_window_exact_coordinates_native_kv_and_pp_lifetime(trial_core, tmp_path, pp, v2):
+    core = trial_core(pp=pp, v2=v2)
+    scheduler, executor = core.scheduler, core.model_executor
+    free = scheduler.kv_cache_manager.block_pool.get_num_free_blocks()
+    saved = {}
+    scheduler.beam_profile_admission = saved
+    result = core.beam_profile_trial(5, 2, 9, str(tmp_path))
+    assert result["schema_id"] == "beam_owned_mixed_window_v1"
+    assert result["status"] == "ok"
+    assert result["requested"] == {
+        "prefill_tokens": 5, "decode_tokens": 2, "total_ctx_len": 9,
+    }
+    assert result["requested_decode_context_lengths"] == [5, 4]
+    observed = result["observed"]
+    assert observed["decode_context_lengths"] == [5, 4]  # actual native snapshot
+    assert (observed["prefill_tokens"], observed["decode_tokens"],
+            observed["total_ctx_len"]) == (5, 2, 9)
+    assert result["actual_forward_count"] == 1
+    assert result["energy_label"] == "window_amortized_not_legacy_per_forward"
+    assert result["legacy_lookup_compatible"] is False
+    assert result["calibration_claim"] is False
+    assert result["config"]["pipeline_parallel_size"] == pp
+    assert result["config"]["runner"] == ("v2" if v2 else "v1")
+    assert executor.profile_calls == [
+        (True, None, result["output_dir"]), (False, None, None),
+    ]
+    measured = [output for output, active in executor.executed if active]
+    assert len(measured) == 1
+    assert measured[0].total_num_scheduled_tokens == 7
+    # The real KV manager supplies non-null, independent blocks to new requests.
+    allocated = [r.block_ids[0][0] for output, _ in executor.executed
+                 for r in output.scheduled_new_reqs]
+    assert len(allocated) == 3
+    assert len(set(allocated)) == 3
+    assert all(block > 0 for block in allocated)
+    assert not scheduler.requests
+    assert not scheduler.finished_req_ids
+    assert scheduler.kv_cache_manager.block_pool.get_num_free_blocks() == free
+    assert not executor.worker_requests
+    assert all(slot is None for slot in executor.ring)
+    assert scheduler.beam_profile_admission is saved
+    assert scheduler.beam_profile_expected is None
+    assert not core._beam_profile_trial_active
+    assert not core._beam_profile_active
+    assert not core._beam_profile_unusable
+    assert core._beam_profile_cleanup_report["confirmed"] is True
+    assert core._beam_profile_cleanup_report["unresolved_invocations"] == []
+    assert not core.batch_queue
+    if pp > 1:
+        assert core.batch_queue.maxlen == pp
+    assert [stage for stage, forward, active in executor.stages if forward and active] == (
+        list(range(pp))
+    )
