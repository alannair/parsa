+@pytest.fixture
+def policy_profile(gpu_engine):
+    _, tp, pp, _ = gpu_engine
+    name = os.environ.get('BEAM_GPU_NAME')
+    path = os.environ.get(f'BEAM_GPU_PROFILE_TP{tp}_PP{pp}')
+    template = os.environ.get('BEAM_GPU_PROFILE_TEMPLATE')
+    if not name or not (path or template):
+        pytest.skip(f'Set BEAM_GPU_NAME and a matching TP{tp}/PP{pp} profile')
+    if not path:
+        assert '{tp}' in template and '{pp}' in template
+        path = template.format(tp=tp, pp=pp)
+    path = os.path.abspath(os.path.expanduser(path))
+    assert os.path.isfile(path), f'Missing topology-specific profile: {path}'
+    return dict(beam_profile_path=path, beam_gpu_name=name)
+
+
+def _generate(llm, token):
+    from vllm import SamplingParams
+
+    prompts = [{'prompt_token_ids': [token] * n} for n in (129, 193, 257, 321)]
+    outputs = llm.generate(prompts, SamplingParams(
+        temperature=0, seed=0, ignore_eos=True, max_tokens=24), use_tqdm=False)
+    assert len(outputs) == len(prompts)
+    for output, prompt in zip(outputs, prompts):
+        assert output.finished and output.prompt_token_ids == prompt['prompt_token_ids']
+        assert len(output.outputs) == 1
+        assert output.outputs[0].finish_reason == 'length'
+        assert len(output.outputs[0].token_ids) == 24
+    return [(tuple(o.outputs[0].token_ids), o.outputs[0].text) for o in outputs]
+
+
+def _settled_status(llm):
+    import time
+
+    deadline = time.monotonic() + 30
+    while True:
+        status = llm.get_beam_status()
+        if (status['status'] == 'applied' and status['state'] == 'ACTIVE'
+                and status['outstanding_invocations'] == 0):
+            return status
+        assert time.monotonic() < deadline, status
+        time.sleep(0.05)
+
+
+def _worker_snapshot(worker):
+    controller = worker._get_beam_clock_controller()
+    return dict(rank=worker.rank, uuid=controller.device_uuid,
+                observed_mhz=controller.get_clock_mhz(),
+                current_clock_mhz=controller.current_clock_mhz,
+                energy_mj=controller.get_total_energy_mj())
+
+
+def _worker_clock(worker, mhz):
+    return worker._get_beam_clock_controller().set_clock(mhz)
+
