+@pytest.mark.parametrize("metadata", [False, True])
+def test_real_completion_serving_full_and_stream(metadata):
+    from vllm.entrypoints.openai.completion.protocol import CompletionRequest
+    from vllm.entrypoints.openai.completion.serving import OpenAIServingCompletion
+    from vllm.v1.engine import EngineCoreOutput, FinishReason
+
+    processor = _processor()
+    result = processor.process_outputs([EngineCoreOutput(
+        request_id="r", new_token_ids=[10, 11], finish_reason=FinishReason.LENGTH,
+        estimated_ttft=1.0 if metadata else None,
+        estimated_tbts=[0.2] if metadata else None,
+    )]).request_outputs[0]
+    serving = SimpleNamespace(
+        enable_prompt_tokens_details=False, system_fingerprint=None,
+        enable_force_include_usage=False,
+    )
+    serving._raise_if_error = MethodType(
+        OpenAIServingCompletion._raise_if_error, serving
+    )
+    request = CompletionRequest(model="test", prompt="prompt", max_tokens=2)
+    response = OpenAIServingCompletion.request_output_to_completion_response(
+        serving, [result], request, "id", 1, "test", None, SimpleNamespace()
+    )
+    choice = response.model_dump()["choices"][0]
+
+    async def results():
+        yield 0, result
+
+    async def stream():
+        generator = OpenAIServingCompletion.completion_stream_generator(
+            serving, request, [], results(), "id", 1, "test", 1, None, SimpleNamespace()
+        )
+        return [chunk async for chunk in generator]
+
+    chunks = asyncio.run(stream())
+    streamed = json.loads(chunks[0].removeprefix("data: "))["choices"][0]
+    assert chunks[-1] == "data: [DONE]\n\n"
+    for item in (choice, streamed):
+        if metadata:
+            assert item["estimated_ttft"] == 1.0
+            assert item["estimated_tbts"] == [0.2]
+        else:
+            assert "estimated_ttft" not in item and "estimated_tbts" not in item
