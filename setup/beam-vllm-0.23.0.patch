+def atomic_csv(path, fields, rows):
+    """Publish only a closed, complete CSV; an interrupted temp is never resumable."""
+    path = Path(path)
+    if path.exists():
+        raise FileExistsError(path)
+    temporary = None
+    try:
+        with tempfile.NamedTemporaryFile("w", dir=path.parent, prefix="." + path.name + ".",
+                                         suffix=".tmp", delete=False, newline="", encoding="utf-8") as stream:
+            temporary = Path(stream.name)
+            writer = csv.DictWriter(stream, fieldnames=fields)
+            writer.writeheader()
+            writer.writerows(rows)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temporary, path)
+    finally:
+        if temporary is not None:
+            temporary.unlink(missing_ok=True)
+
+
+def generation_spec(args):
+    return {name: getattr(args, name) for name in (
+        "model", "tp", "pp", "clocks", "input_len", "output_len", "batch_size",
+        "token_id", "budget", "warmup", "repeats",
+    )}
+
+
+def read_generation_rows(path):
+    with Path(path).open(newline="", encoding="utf-8") as stream:
+        reader = csv.DictReader(stream)
+        if reader.fieldnames != list(GENERATION_FIELDS):
+            raise ValueError("generation table schema/header differs")
+        return list(reader)
+
+
+def validate_generation_rows(path, specification, devices):
+    devices = rank_device_map(devices, specification["tp"] * specification["pp"])
+    rows = read_generation_rows(path)
+    expected = {(clock, rank) for clock in specification["clocks"] for rank in devices}
+    observed = []
+    for row in rows:
+        rank = row["rank"]
+        if (row["schema_id"] != GENERATION_SCHEMA or rank not in devices
+                or row["uuid"] != devices[rank]):
+            raise ValueError("generation table schema/device coverage differs")
+        observed.append((positive_integer(row["clock"], "clock"), rank))
+        for column, name in (("request_batch", "batch_size"),
+                             ("input_tokens_per_request", "input_len"),
+                             ("output_tokens_per_request", "output_len"),
+                             ("generation_calls", "repeats")):
+            if positive_integer(row[column], column) != specification[name]:
+                raise ValueError(f"generation table {column} differs from request")
+        positive(row["window_seconds"], "window_seconds")
+        positive_integer(row["forward_count"], "forward_count")
+        for name in ("window_energy_mj", "mean_forward_ms"):
+            value = float(row[name])
+            if not math.isfinite(value) or value < 0:
+                raise ValueError(f"invalid generation {name}")
+    if len(observed) != len(expected) or set(observed) != expected:
+        raise ValueError("generation table clock×rank coverage is incomplete or duplicated")
+    return rows
+
+
+def validate_generation_point(directory, args, source_fingerprint, artifact_fingerprint):
+    directory = Path(directory)
+    marker_path = directory / "completed.json"
+    if not marker_path.is_file():
+        raise ValueError("generation point lacks a post-cleanup completion marker")
+    marker = json.loads(marker_path.read_text())
+    if (marker.get("schema_id") != "beam_generation_point_complete_v1"
+            or marker.get("specification") != generation_spec(args)
+            or marker.get("source_fingerprint") != source_fingerprint
+            or marker.get("artifact_fingerprint") != artifact_fingerprint):
+        raise ValueError("generation completion schema/configuration/source/artifact fingerprint differs")
+    for filename, key in (("measurements.csv", "table_sha256"), ("manifest.json", "manifest_sha256")):
+        if input_reference(directory / filename)["sha256"] != marker.get(key):
+            raise ValueError(f"generation point {filename} hash differs from completion marker")
+    manifest = json.loads((directory / "manifest.json").read_text())
+    devices = marker["rank_devices"]
+    if (manifest.get("schema_id") != GENERATION_SCHEMA
+            or manifest.get("rank_devices") != devices):
+        raise ValueError("generation manifest schema/device mapping differs")
+    return validate_generation_rows(directory / "measurements.csv", generation_spec(args), devices), devices
+
+
+def engine_options(mode, *, profile=None, dynamo_profile=None, gpu_name=None,
+                   fidelity=False, budget=2048, ttft=1., tbt=.2, tpot=.2,
+                   s1_policy="tbt"):
+    if mode not in MODES:
+        raise ValueError(f"unknown mode {mode}")
+    if type(budget) is not int or budget <= 0:
+        raise ValueError("budget must be a positive integer")
+    if s1_policy not in ("tbt", "tpot"):
+        raise ValueError("s1_policy must be tbt or tpot")
+    if mode == "B3" and s1_policy != "tbt":
+        raise ValueError("B3 fixed-256 candidate supports only the tbt policy")
+    options = {name: True for name in MODES[mode]}
+    options["max_num_batched_tokens"] = (
+        256 if mode in ("A", "B", "B2", "B3") else budget
+    )
+    model_mode = mode in ("B3", "C", "D", "S2")
+    if fidelity and not model_mode:
+        raise ValueError("fidelity requires S1 or S2")
+    if model_mode:
+        if not profile or not gpu_name:
+            raise ValueError("S1/S2 requires explicit profile and gpu_name")
+        options.update(beam_profile_path=str(Path(profile).resolve(strict=True)),
+                       beam_gpu_name=gpu_name, measure_fidelity=fidelity,
+                       beam_s1_policy=s1_policy)
+    if mode == "B2":
+        if not dynamo_profile:
+            raise ValueError("Dynamo requires explicit dynamo_profile")
+        options["beam_dynamo_profile_path"] = str(
+            Path(dynamo_profile).resolve(strict=True))
+    options.update(beam_ttft_slo=positive(ttft, "ttft"),
+                   beam_tbt_slo=positive(tbt, "tbt"),
+                   beam_tpot_slo=positive(tpot, "tpot"))
+    return options
+
+
+def slo_controls(mode, tpot, tbt, ttft, s1_policy="tbt"):
+    if mode not in MODES:
+        raise ValueError(f"unknown mode {mode}")
+    controls = {}
+    if mode in ("B3", "C", "D") and s1_policy == "tpot":
+        controls["tpot_slo"] = positive(tpot, "tpot")
+    if mode in ("B2", "D", "S2") or (mode in ("B3", "C") and s1_policy == "tbt"):
+        controls["tbt_slo"] = positive(tbt, "tbt")
+    if mode in ("B2", "B3", "C", "D"):
+        controls["ttft_slo"] = positive(ttft, "ttft")
+    return controls
+
+
+def cli_options(options):
+    result = []
+    for key, value in options.items():
+        flag = "--" + key.replace("_", "-")
+        if isinstance(value, bool):
+            result.append(flag if value else "--no-" + key.replace("_", "-"))
+        elif value is not None:
+            if isinstance(value, list):
+                result.extend((flag, *map(str, value)))
+            else:
+                result.extend((flag, str(value)))
+    return result
+
+
+def write_json(path, data):
+    with Path(path).open("x", encoding="utf-8") as output:
+        json.dump(data, output, indent=2, allow_nan=False)
+
+
+def worker_identity(worker):
+    """Callable LLM.collective_rpc boundary; controller binds assigned UUID."""
+    controller = worker._get_beam_clock_controller()
+    return {"rank": worker.rank, "uuid": controller.device_uuid}
+
+
+def worker_clock(worker, clock):
+    return worker._get_beam_clock_controller().set_clock(clock)
+
+
+def profile_generation(llm, prompts, sampling, directory, *, warmup=2, repeats=10):
+    if warmup < 0 or repeats < 1:
+        raise ValueError("warmup must be nonnegative and repeats positive")
+    for _ in range(warmup):
+        llm.generate(prompts, sampling, use_tqdm=False)
+    # Start BEFORE any measured forward: worker events remain queued until stop.
+    try:
+        llm.collective_rpc("profile", kwargs={
+            "is_start": True, "output_dir": str(directory),
+        })
+        start = time.perf_counter()
+        for _ in range(repeats):
+            llm.generate(prompts, sampling, use_tqdm=False)
+        return time.perf_counter() - start
+    finally:
+        # Also flush workers that started before a partial collective failure.
+        llm.collective_rpc("profile", kwargs={"is_start": False})
+
+
+def summarize_profile(directory, *, expected_ranks, rank_devices=None):
+    """Use dedicated start/stop counters, never differences of batch curr_energy."""
+    directory = Path(directory)
+    if type(expected_ranks) is not int or expected_ranks < 1:
+        raise ValueError("expected_ranks must be positive")
+    expected = {str(rank) for rank in range(expected_ranks)}
+    files = {p.stem.removeprefix("energy_log_GPU_"): p
+             for p in directory.glob("energy_log_GPU_*.csv")}
+    if set(files) != expected:
+        raise ValueError(f"energy rank coverage differs: expected {sorted(expected)}")
+    if rank_devices is not None:
+        rank_devices = rank_device_map(rank_devices, expected_ranks)
+    ranks = {}
+    for rank, path in files.items():
+        with path.open(newline="", encoding="utf-8") as source:
+            snapshots = list(csv.DictReader(source))
+        if len(snapshots) < 2:
+            raise ValueError(f"rank {rank} lacks start/stop energy snapshots")
+        counters = [int(row["total_energy_mj"]) for row in snapshots]
+        times = [float(row["monotonic_s"]) for row in snapshots]
+        if (not all(math.isfinite(v) and v >= 0 for v in counters + times)
+                or any(b < a for a, b in zip(counters, counters[1:]))):
+            raise ValueError(f"rank {rank} invalid/decreasing energy counter")
+        if any(b <= a for a, b in zip(times, times[1:])):
+            raise ValueError(f"rank {rank} nonpositive snapshot interval")
+        joules = (counters[-1] - counters[0]) / 1000
+        duration = times[-1] - times[0]
+        with (directory / f"batch_log_GPU_{rank}.csv").open(
+            newline="", encoding="utf-8"
+        ) as source:
+            batches = list(csv.DictReader(source))
+        elapsed = []
+        for row in batches:
+            if (row.get("timing_domain") != "cuda_event_model_forward_ms"
+                    or row.get("energy_domain") != "device_cumulative_mj_host_snapshot"):
+                raise ValueError("legacy/unknown timing domains require separate analysis")
+            value = float(row["elapsed_time"])
+            if not math.isfinite(value) or value < 0:
+                raise ValueError("invalid CUDA forward time")
+            elapsed.append(value)
+        ranks[rank] = {"energy_j": joules, "window_seconds": duration,
+                       "window_power_w": joules / duration, "forwards": len(elapsed),
+                       "mean_forward_ms": statistics.mean(elapsed) if elapsed else None,
+                       "sum_forward_ms": sum(elapsed)}
+    return {"ranks": ranks, "rank_devices": rank_devices,
+            "energy_domain": "physical_device_profile_window",
+            "timing_domain": "cuda_event_model_forward_ms",
+            "note": "Rank windows are not synchronized; no per-forward energy attribution."}
+
+
+def percentile(values, fraction):
+    if not values:
+        return None
+    values = sorted(values)
+    index = (len(values) - 1) * fraction
+    low, high = math.floor(index), math.ceil(index)
+    return values[low] + (values[high] - values[low]) * (index - low)
+
+
+def error_metrics(pairs, unpaired_actual=0):
+    if any(isinstance(v, bool) or not isinstance(v, (int, float))
+           or not math.isfinite(v) or v < 0 for pair in pairs for v in pair):
+        raise ValueError("fidelity observations must be nonnegative finite seconds")
+    errors = [estimate - actual for actual, estimate in pairs]
+    relative = [abs(estimate - actual) / actual * 100
+                for actual, estimate in pairs if actual > 0]
+    return {"pairs": len(pairs), "unpaired_actual": unpaired_actual,
+            "mae_ms": statistics.mean(map(abs, errors)) * 1000 if errors else None,
+            "bias_ms": statistics.mean(errors) * 1000 if errors else None,
+            "mape_percent": statistics.mean(relative) if relative else None}
+
+
+def fidelity_metrics(data, *, alignment="token"):
+    if alignment not in ("token", "direct", "artifact-shift"):
+        raise ValueError("alignment must be token, direct or artifact-shift")
+    ttft_pairs, tbt_pairs = [], []
+    ttft_missing = tbt_missing = 0
+    grouped = 0
+    observations = zip(
+        data["successes"], data["ttfts"], data["itls"],
+        data["estimated_ttfts"], data["estimated_tbts_list"], strict=True,
+    )
+    for index, observation in enumerate(observations):
+        ok, actual_ttft, actual_itls, estimate_ttft, estimate_tbts = observation
+        if not ok:
+            continue
+        if estimate_ttft is None:
+            ttft_missing += 1
+        else:
+            ttft_pairs.append((actual_ttft, estimate_ttft))
+        estimates = estimate_tbts or []
+        if alignment == "token":
+            lengths = data.get("output_lens", [])
+            chunks = data.get("stream_token_chunks", [])
+            coverage = data.get("token_id_coverage_complete", [])
+            if (index >= len(lengths) or index >= len(chunks)
+                    or lengths[index] is None or lengths[index] != chunks[index]
+                    or index >= len(coverage) or coverage[index] is not True
+                    or lengths[index] != len(estimates)):
+                # No invented token correspondence for grouped/unknown streams.
+                grouped += 1
+                tbt_missing += len(actual_itls)
+                continue
+            # Scheduler snapshots contain one estimate per output token, including
+            # the first token; ITL[0] is the interval to the SECOND output token.
+            estimates = estimates[1:]
+        elif alignment == "artifact-shift":
+            # Historical figure's shift is explicit; never cross request boundaries.
+            estimates, actual_itls = estimates[1:], actual_itls[:-1]
+        count = min(len(actual_itls), len(estimates))
+        tbt_pairs.extend(zip(actual_itls[:count], estimates[:count]))
+        tbt_missing += len(actual_itls) - count
+    return {"alignment": alignment, "ttft": error_metrics(ttft_pairs, ttft_missing),
+            "tbt": error_metrics(tbt_pairs, tbt_missing),
+            "grouped_or_unknown_requests": grouped,
+            "note": "ITLs are stream-chunk intervals, not guaranteed token intervals."}
+
+
+def fidelity_svg(data, path):
+    """Dependency-free TTFT scatter; no GPU/energy attribution or plot imports."""
+    pairs = [(a * 1000, b * 1000) for ok, a, b in zip(
+        data["successes"], data["ttfts"], data["estimated_ttfts"], strict=True)
+        if ok and a is not None and b is not None]
+    if not pairs:
+        raise ValueError("no TTFT estimate pairs to visualize")
+    error_metrics(pairs)
+    limit = max(max(a, b) for a, b in pairs) or 1
+    points = "".join(f'<circle cx="{50 + a / limit * 500:.2f}" '
+                     f'cy="{550 - b / limit * 500:.2f}" r="2" fill="navy"/>'
+                     for a, b in pairs)
+    with Path(path).open("x", encoding="utf-8") as output:
+        output.write('<svg xmlns="http://www.w3.org/2000/svg" width="640" height="620">'
+                     '<rect width="640" height="620" fill="white"/>'
+                     '<path d="M50 50V550H550M50 550L550 50" fill="none" stroke="gray"/>'
+                     '<text x="50" y="25">'
+                     'TTFT: actual (x), estimated (y), milliseconds</text>'
+                     f'<text x="50" y="590">Axis range: 0–{limit:.2f} ms</text>'
+                     + points + '</svg>')
+
+
+def dynamo_row(data, profile, *, clock, tp, pp, tps, time_limit=60,
+               power_mode="historical", power_seconds=30):
+    """Legacy selector schema: gpu_power is summed window Watts, NOT J/request."""
+    clock, tp, pp, tps = (positive_integer(value, name) for value, name in (
+        (clock, "clock"), (tp, "tp"), (pp, "pp"), (tps, "tps")))
+    positive(time_limit, "time_limit")
+    mapping = rank_device_map(profile.get("rank_devices"), tp * pp)
+    if set(mapping) != set(profile["ranks"]):
+        raise ValueError("Dynamo aggregation requires unique physical rank_devices")
+    ttfts, tbts = [], []
+    for ok, entry, ttft, itls in zip(
+        data["successes"], data.get("dispatch_times", data["entry_times"]),
+        data["ttfts"], data["itls"], strict=True
+    ):
+        if not ok or entry + ttft >= time_limit:
+            continue
+        ttfts.append(ttft * 1000)
+        elapsed = entry + ttft
+        for itl in itls:
+            elapsed += itl
+            if elapsed > time_limit:
+                break
+            tbts.append(itl * 1000)
+    if not ttfts or not tbts:
+        raise ValueError("Dynamo row needs completed TTFT and ITLs within time_limit")
+    if any(not isinstance(row["energy_j"], (int, float))
+           or not math.isfinite(row["energy_j"]) or row["energy_j"] <= 0
+           for row in profile["ranks"].values()):
+        raise ValueError("Dynamo energy must be positive finite window Joules")
+    if power_mode == "whole-window":
+        power = sum(r["energy_j"] / positive(r["window_seconds"], "window")
+                    for r in profile["ranks"].values())
+    else:
+        from benchmarks.energy.analysis import power_window
+
+        window = power_window(data.get("monitor_samples", []), power_seconds,
+                               mode=power_mode)
+        if window["rank_devices"] != mapping:
+            raise ValueError("monitor UUID mapping differs from profile rank devices")
+        power = window["total_power_w"]
+    return validate_dynamo_row({"clock": clock, "tp": tp, "pp": pp, "tps": tps,
+            "gpu_power": power,
+            "ttft_mean": statistics.mean(ttfts), "tbt_mean": statistics.mean(tbts),
+            "ttft_p99": percentile(ttfts, .99), "tbt_p90": percentile(tbts, .9),
+            "ttft_std": statistics.pstdev(ttfts), "tbt_std": statistics.pstdev(tbts)})
+
+
+DYNAMO_COLUMNS = ("clock", "tp", "pp", "tps", "gpu_power", "ttft_mean", "tbt_mean",
+                  "ttft_p99", "tbt_p90", "ttft_std", "tbt_std")
+
+
+def validate_dynamo_row(row):
+    if not set(DYNAMO_COLUMNS) <= set(row):
+        raise ValueError("Dynamo row lacks required profile fields")
+    normalized = {}
+    for name in DYNAMO_COLUMNS:
+        if name in ("clock", "tp", "pp", "tps"):
+            normalized[name] = positive_integer(row[name], name)
+        elif name in ("ttft_std", "tbt_std"):
+            value = float(row[name])
+            if isinstance(row[name], bool) or not math.isfinite(value) or value < 0:
+                raise ValueError(f"Dynamo {name} must be finite and nonnegative")
+            normalized[name] = value
+        else:
+            normalized[name] = positive(row[name], name)
+    return normalized
+
+
+def write_dynamo(path, rows):
+    rows = [validate_dynamo_row(row) for row in rows]
+    if not rows:
+        raise ValueError("cannot publish an empty Dynamo profile")
+    atomic_csv(path, DYNAMO_COLUMNS, rows)
+
+
+def merge_dynamo(paths, output, *, duplicates="error"):
+    if duplicates not in ("error", "mean"):
+        raise ValueError("duplicates must be error or mean")
+    groups = {}
+    for path in paths:
+        with Path(path).open(newline="") as source:
+            for raw in csv.DictReader(source):
+                row = validate_dynamo_row(raw)
+                key = tuple(row[name] for name in ("clock", "tp", "pp", "tps"))
+                groups.setdefault(key, []).append(row)
+    if not groups:
+        raise ValueError("no Dynamo rows to merge")
+    rows = []
+    for key, values in sorted(groups.items()):
+        if len(values) > 1 and duplicates == "error":
+            raise ValueError(f"duplicate Dynamo topology/clock/TPS key: {key}")
+        rows.append({name: statistics.mean(row[name] for row in values)
+                     for name in DYNAMO_COLUMNS})
+    write_dynamo(output, rows)
+    write_json(str(output) + ".metadata.json", {
+        "inputs": [input_reference(path) for path in paths],
+        "duplicates": duplicates, "rows": len(rows),
+        "aggregation": "arithmetic row means, not pooled percentile/std estimates",
+        "units": "gpu_power=W; latency columns=ms; tps=nominal offered input tokens/s",
+    })
+
+
+def offline(args):
+    if args.tp < 1 or args.pp < 1 or args.warmup < 0 or args.repeats < 1:
+        raise ValueError("positive TP/PP/repeats and nonnegative warmup required")
+    if any(clock < 1 for clock in args.clocks):
+        raise ValueError("clocks must be positive MHz")
+    provenance = check_target(args.artifact_root)
+    fingerprint, artifact_fingerprint = source_stamp(), artifact_stamp(args.artifact_root)
+    from vllm import LLM, SamplingParams
+    from vllm.engine.arg_utils import EngineArgs
+
+    if args.input_len < 1 or args.output_len < 1 or args.batch_size < 1:
+        raise ValueError("input/output/batch lengths must be positive")
+    if args.token_id < 0 or len(set(args.clocks)) != len(args.clocks):
+        raise ValueError("token ID must be nonnegative and clocks must be unique")
+    directory = Path(args.output).resolve()
+    directory.mkdir(parents=True, exist_ok=False)
+    options = dict(model=args.model, tensor_parallel_size=args.tp,
+                   pipeline_parallel_size=args.pp, custom_profiler=True,
+                   beam_log_dir=str(directory), enable_prefix_caching=False,
+                   max_num_batched_tokens=args.budget, max_num_seqs=args.batch_size,
+                   max_model_len=args.input_len + args.output_len,
+                   enable_chunked_prefill=True, async_scheduling=False)
+    # EngineArgs is the authoritative current option/validation contract.
+    engine_args = EngineArgs(**options)
+    llm = LLM.from_engine_args(engine_args)
+    measurements = []
+    try:
+        identities = llm.collective_rpc(worker_identity)
+        mapping = rank_device_map(
+            {str(r["rank"]): r["uuid"] for r in identities}, args.tp * args.pp)
+        prompts = [{"prompt_token_ids": [args.token_id] * args.input_len}
+                   for _ in range(args.batch_size)]
+        sampling = SamplingParams(max_tokens=args.output_len, ignore_eos=True,
+                                  temperature=0, detokenize=False)
+        write_json(directory / "manifest.json", {
+            **provenance, "engine_args": options, "workload": vars(args),
+            "schema_id": GENERATION_SCHEMA, "source_fingerprint": fingerprint,
+            "artifact_fingerprint": artifact_fingerprint,
+            "rank_devices": mapping,
+            "kind": "real_generation_not_mixed_lookup_calibration",
+        })
+        for clock in args.clocks:
+            window = directory / f"clock_{clock}"
+            window.mkdir()
+            llm.collective_rpc(worker_clock, args=(clock,))
+            duration = profile_generation(llm, prompts, sampling, window,
+                                          warmup=args.warmup, repeats=args.repeats)
+            summary = summarize_profile(window, expected_ranks=args.tp * args.pp,
+                                        rank_devices=mapping)
+            if any(rank["forwards"] == 0 for rank in summary["ranks"].values()):
+                raise ValueError("offline profile recorded no actual forwards on a rank")
+            summary.update(generation_seconds=duration, repeats=args.repeats,
+                            requested_clock_mhz=clock)
+            write_json(window / "summary.json", summary)
+            measurements.extend({
+                "schema_id": GENERATION_SCHEMA,
+                "clock": clock, "request_batch": args.batch_size,
+                "input_tokens_per_request": args.input_len,
+                "output_tokens_per_request": args.output_len, "rank": rank,
+                "generation_calls": args.repeats,
+                "window_seconds": record["window_seconds"],
+                "window_energy_mj": record["energy_j"] * 1000,
+                "mean_forward_ms": record["mean_forward_ms"],
+                "forward_count": record["forwards"], "uuid": mapping[rank],
+            } for rank, record in summary["ranks"].items())
+        atomic_csv(directory / "measurements.csv", GENERATION_FIELDS, measurements)
+    finally:
+        try:
+            llm.collective_rpc("reset_beam_clock")
+        finally:
+            llm.llm_engine.engine_core.shutdown()
+    if source_stamp() != fingerprint or artifact_stamp(args.artifact_root) != artifact_fingerprint:
+        raise ValueError("source/artifact changed during profile; no completion marker published")
+    validate_generation_rows(directory / "measurements.csv", generation_spec(args), mapping)
+    # Deliberately AFTER successful clock restoration and client shutdown.
+    write_json(directory / "completed.json", {
+        "schema_id": "beam_generation_point_complete_v1", "specification": generation_spec(args),
+        "source_fingerprint": fingerprint, "artifact_fingerprint": artifact_fingerprint,
+        "rank_devices": mapping,
+        "table_sha256": input_reference(directory / "measurements.csv")["sha256"],
+        "manifest_sha256": input_reference(directory / "manifest.json")["sha256"],
+    })
+    return directory
+
+
+def generation_grid(args):
+    """Actual-request workload grid; deliberately NOT a synthetic mixed-forward CSV."""
+    for values in (args.batch_sizes, args.input_lens, args.output_lens, args.clocks):
+        if not values or len(set(values)) != len(values) or any(value < 1 for value in values):
+            raise ValueError("grid dimensions must contain unique positive integers")
+    provenance = check_target(args.artifact_root)
+    root = Path(args.output).resolve()
+    configuration = {key: value for key, value in vars(args).items()
+                     if key not in ("output", "resume", "command")}
+    stamp = source_stamp()
+    artifact_fingerprint = artifact_stamp(args.artifact_root)
+    manifest = {"configuration": configuration, "source_fingerprint": stamp,
+                "schema_id": "beam_generation_grid_v2", "artifact_fingerprint": artifact_fingerprint,
+                "kind": "real_generation_grid_not_EnergySimulator_calibration"}
+    if args.resume:
+        if json.loads((root / "grid.json").read_text()) != manifest:
+            raise ValueError("resume configuration/source/artifact fingerprint differs")
+    else:
+        root.mkdir(parents=True, exist_ok=False)
+        write_json(root / "grid.json", manifest)
+        write_json(root / "provenance.json", provenance)
+    rows, device_map = [], None
+    for batch in args.batch_sizes:
+        for input_len in args.input_lens:
+            for output_len in args.output_lens:
+                if (source_stamp() != stamp
+                        or artifact_stamp(args.artifact_root) != artifact_fingerprint):
+                    raise ValueError("port code/artifact changed during generation grid")
+                directory = root / f"batch{batch}_in{input_len}_out{output_len}"
+                point_args = parser().parse_args([
+                        "offline-profile", "--artifact-root", args.artifact_root,
+                        "--model", args.model, "--tp", str(args.tp), "--pp", str(args.pp),
+                        "--output", str(directory), "--clocks", *map(str, args.clocks),
+                        "--token-id", str(args.token_id), "--input-len", str(input_len),
+                        "--output-len", str(output_len), "--batch-size", str(batch),
+                        "--budget", str(args.budget), "--warmup", str(args.warmup),
+                        "--repeats", str(args.repeats),
+                    ])
+                if directory.exists() and not args.resume:
+                    raise ValueError(f"existing point retained: choose a new directory: {directory}")
+                if not directory.exists():
+                    offline(point_args)
+                point_rows, recorded = validate_generation_point(
+                    directory, point_args, stamp, artifact_fingerprint)
+                if device_map is not None and recorded != device_map:
+                    raise ValueError("grid points used different physical devices")
+                device_map = recorded
+                rows.extend(point_rows)
+    destination = root / "generation-grid.csv"
+    if destination.exists():
+        if args.resume and read_generation_rows(destination) == rows:
+            return
+        raise ValueError("existing final grid does not match validated point/clock/rank rows")
+    atomic_csv(destination, GENERATION_FIELDS, rows)
+
+
+def serve_command(binary, model, options):
+    binary = Path(binary).absolute()
+    # Pin the binary to this interpreter's environment, not ambient PATH.
+    if (binary.parent != Path(sys.executable).absolute().parent
+            or not binary.is_file()):
+        raise ValueError("--vllm-bin must be beside the running environment's Python")
+    output = subprocess.check_output([str(binary), "--version"], text=True).strip()
+    version = output.splitlines()[-1] if output else ""
+    if version.split("+", 1)[0] != "0.23.0":
+        raise ValueError("--vllm-bin must report 0.23.0")
+    return [str(binary), "serve", model, *cli_options(options)]
+
+
+@contextmanager
+def client_auth(token):
+    previous = os.environ.get("OPENAI_API_KEY")
+    os.environ["OPENAI_API_KEY"] = token
+    try:
+        yield
+    finally:
+        if previous is None:
+            os.environ.pop("OPENAI_API_KEY", None)
+        else:
+            os.environ["OPENAI_API_KEY"] = previous
+
+
+def harness_environment(token):
+    """Use only an unregistered middleware key; native compile factors see no key."""
+    environment = {**os.environ, "BEAM_TOOLS_RPC_TOKEN": token,
+                   "VLLM_SERVER_DEV_MODE": "1"}
+    environment.pop("VLLM_API_KEY", None)
+    environment.pop("OPENAI_API_KEY", None)
+    return environment
+
+
+def run_cohort(args):
+    """Identity of workload measurement semantics; mode and TP/PP may differ."""
+    from benchmarks.energy.backend_request_func import SAMPLING_PARAMETERS
+
+    return {
+        "schema_id": "beam_comparison_cohort_v1", "model": args.model,
+        "endpoint": "/v1/chat/completions" if args.chat else "/v1/completions",
+        "tokenizer": args.tokenizer or args.model,
+        "monitor": {"minimum_seconds": args.monitor_seconds,
+                    "interval_seconds": args.monitor_interval},
+        "profile_window_policy": "start_before_work;stop_after_requests_controls_minimum_monitor_and_final_sample",
+        "control_wait_policy": {"timeout_seconds": args.control_timeout,
+                                "poll_seconds": args.control_poll_interval,
+                                "pattern_interval_seconds": args.control_interval},
+        "output_sampling": {**SAMPLING_PARAMETERS, "stream": True,
+                            "output_length": "per_request_max_tokens"},
+    }
