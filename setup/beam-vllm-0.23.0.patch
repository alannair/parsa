+def test_forward_events_deferred_until_stop_and_csv_units_preserved(tmp_path):
+    calls = []
+    profiler = EnergyLogger(
+        rank=3,
+        controller=FakeController(),
+        event_factory=lambda: FakeEvent(calls),
+    )
+    runner = SimpleNamespace(beam_profiler=profiler)
+    profiler.start(str(tmp_path / "new-directory"))
+    profiler.log_dvfs(900, 13, 0.1, requested_clock_mhz=1500, step=7, phase=2)
+    with beam_forward_context(runner, batch(), batch_size=16, num_reqs=3):
+        calls.append("forward")
+    assert calls == ["record", "forward", "record"]
+    profiler.stop()
+    assert calls == ["record", "forward", "record", "synchronize", "elapsed_time"]
+    directory = tmp_path / "new-directory"
+    with (directory / "batch_log_GPU_3.csv").open() as source:
+        row = next(csv.DictReader(source))
+    assert row["elapsed_time"] == "2.5"  # CUDA-event milliseconds.
+    assert row["batch_size"] == "16"  # Padded forward tokens, not requests.
+    assert row["num_scheduled_tokens"] == "13"
+    assert row["num_reqs"] == "3"
+    assert row["gpu_clock"] == "900"  # Observation, not the requested 1500.
+    assert row["requested_clock_mhz"] == "1500"
+    assert row["step"] == "7" and row["phase"] == "2"
+    assert row["curr_energy"] == "1020"  # Cumulative, not 10 mJ/forward.
+    assert row["energy_domain"] == "device_cumulative_mj_host_snapshot"
+    with (directory / "energy_log_GPU_3.csv").open() as source:
+        snapshots = list(csv.DictReader(source))
