+GENERATION_SCHEMA = "beam_generation_window_v1"
+GENERATION_FIELDS = ("schema_id", "clock", "request_batch", "input_tokens_per_request",
+                     "output_tokens_per_request", "rank", "generation_calls",
+                     "window_seconds", "window_energy_mj", "mean_forward_ms",
+                     "forward_count", "uuid")
