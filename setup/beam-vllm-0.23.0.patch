+"""Trace replay and rate/burst/stair experiments against the BEAM v0.23 server.
+
+Adapted from BEAM-artifact 0febb08 benchmarks/energy/benchmark_script.py and
+benchmarks/benchmark_dataset.py: timed replay, gamma arrivals, weighted phases,
+random token prompts, goodput and fidelity result arrays. Original Apache-2.0,
+copyright contributors to the vLLM project. Stdlib RNG is seeded but does NOT
+promise NumPy byte-identical random workloads; recorded arrivals are reusable.
+"""
+
+import asyncio
+import csv
+import json
+import math
+import random
+import statistics
+import time
+from concurrent.futures import ThreadPoolExecutor
+from functools import partial
+from datetime import datetime
+from pathlib import Path
+
+from benchmarks.energy.backend_request_func import (
+    collective_rpc, post_control, request, update_chunk_size, update_microbatch_size,
+    wait_for_beam_control,
+)
+from benchmarks.energy.beam_tools import (
+    artifact_path,
+    percentile,
+    positive,
+    run_cohort,
+    slo_controls,
+    write_json,
+)
+
+
+def load_trace(path):
+    rows = []
+    with Path(path).open(newline="", encoding="utf-8") as source:
+        reader = csv.DictReader(source)
+        required = {"TIMESTAMP", "ContextTokens", "GeneratedTokens"}
+        if not required <= set(reader.fieldnames or []):
+            raise ValueError("trace requires TIMESTAMP, ContextTokens, GeneratedTokens")
+        first = None
+        for raw in reader:
+            timestamp = datetime.fromisoformat(raw["TIMESTAMP"])
+            if first is None:
+                first = timestamp
+            offset = (timestamp - first).total_seconds()
+            if offset < 0 or (rows and offset < rows[-1]["timestamp"]):
+                raise ValueError("trace timestamps must be ordered")
+            input_len, output_len = int(raw["ContextTokens"]), int(raw["GeneratedTokens"])
+            if input_len < 1 or output_len < 1:
+                raise ValueError("trace lengths must be positive integers")
+            rows.append({"timestamp": offset, "input_len": input_len,
+                         "output_len": output_len})
+    if not rows:
+        raise ValueError("empty trace")
+    return rows
+
+
+def synthetic(count, input_len, output_len, ratio, rates, burstiness, seed):
+    if count < 1 or input_len < 1 or output_len < 1 or not 0 < ratio <= 1:
+        raise ValueError("positive count/lengths and 0 < ratio <= 1 required")
+    if not rates:
+        raise ValueError("at least one rate is required")
+    rates = [positive(rate, "rate") for rate in rates]
+    burstiness = positive(burstiness, "burstiness")
+    rng = random.Random(seed)
+    # Largest remainder allocation preserves the weighted-phase intent and total.
+    weights = [count * rate / sum(rates) for rate in rates]
+    counts = [math.floor(weight) for weight in weights]
+    order = sorted(range(len(rates)), key=lambda i: weights[i] - counts[i],
+                   reverse=True)
+    for i in order[:count - sum(counts)]:
+        counts[i] += 1
+    rows, phases, elapsed = [], [], 0.
+    for rate, size in zip(rates, counts):
+        phases.append({"rate": rate, "start_time": elapsed, "count": size})
+        for _ in range(size):
+            rows.append({
+                "timestamp": elapsed,
+                "input_len": rng.randint(max(1, int(input_len * ratio)), input_len),
+                "output_len": rng.randint(max(1, int(output_len * ratio)), output_len),
+            })
+            elapsed += rng.gammavariate(burstiness, 1 / (rate * burstiness))
+        phases[-1]["end_time"] = elapsed
+    return rows, phases
+
+
+def add_prompts(rows, tokenizer, seed, *, chat=False):
+    rng = random.Random(seed)
+    vocab_size = tokenizer.vocab_size
+    for index, row in enumerate(rows):
+        offset = rng.randrange(vocab_size)
+        tokens = [(offset + index + i) % vocab_size for i in range(row["input_len"])]
+        # Completion token IDs preserve exact requested length, unlike decode/reencode.
+        row["prompt"] = tokenizer.decode(tokens) if chat else tokens
+
+
+async def replay(rows, *, base_url, model, output_dir=None, controls=None,
+                 max_concurrency=128, chat=False, timeout=21600,
+                 sample=None, monitor_interval=.2, monitor_seconds=0,
+                 live_controls=None, microbatch_pattern=None, control_timeout=30,
+                 control_poll_interval=.1, control_interval=2):
+    if max_concurrency < 1:
+        raise ValueError("max_concurrency must be positive")
+    if not rows:
+        raise ValueError("replay requires requests")
+    previous = 0
+    for row in rows:
+        timestamp = row["timestamp"]
+        if (not isinstance(timestamp, (int, float)) or not math.isfinite(timestamp)
+                or timestamp < previous):
+            raise ValueError("request timestamp must be finite, nonnegative and ordered")
+        previous = timestamp
+        if any(type(row[key]) is not int or row[key] < 1
+               for key in ("input_len", "output_len")):
+            raise ValueError("request lengths must be positive integers")
+        prompt = row["prompt"]
+        if not (isinstance(prompt, str) and prompt
+                or isinstance(prompt, list) and prompt
+                and all(type(token) is int and token >= 0 for token in prompt)):
+            raise ValueError("prompt must be nonempty text or nonnegative token IDs")
+        if chat and not isinstance(prompt, str):
+            raise ValueError("chat replay needs text prompts")
+    positive(timeout, "timeout")
+    positive(monitor_interval, "monitor_interval")
+    positive(control_timeout, "control_timeout")
+    positive(control_poll_interval, "control_poll_interval")
+    positive(control_interval, "control_interval")
+    if not math.isfinite(monitor_seconds) or monitor_seconds < 0:
+        raise ValueError("monitor_seconds must be finite and nonnegative")
+    semaphore = asyncio.Semaphore(max_concurrency)
+    tasks, entry_times, dispatch_times = [], [], [None] * len(rows)
+    start = None
+    profile_attempted = False
+    monitor_task = None
+    monitor_samples = []
+    monitor_stop = asyncio.Event()
+    cycle = 0
+    monitor_executor = ThreadPoolExecutor(max_workers=1) if sample is not None else None
+    live_controls = live_controls or {}
+    if set(live_controls) - {"chunk_size", "microbatch_size"}:
+        raise ValueError("unknown manual control")
+    if microbatch_pattern and "microbatch_size" in live_controls:
+        raise ValueError("microbatch pattern and single manual override are mutually exclusive")
+    control_executor = (ThreadPoolExecutor(max_workers=2)
+                        if live_controls or microbatch_pattern else None)
+    control_events, control_errors, control_tasks = [], [], []
+    acknowledgments = {}
+
+    def event(name, phase, response=None, **extra):
+        control_events.append({"control": name, "phase": phase,
+                               "elapsed_s": time.perf_counter() - start if start is not None else None,
+                               "response": response, **extra})
+
+    async def post_manual(name, value, clear):
+        function = update_chunk_size if name == "chunk_size" else update_microbatch_size
+        response = await asyncio.get_running_loop().run_in_executor(
+            control_executor, partial(function, base_url, value, clear=clear,
+                                      timeout=min(timeout, control_timeout)))
+        event(name, "acknowledged", response, value=value, clear=clear)
+        return response
+
+    async def await_manual(name, value, clear, acknowledgment):
+        response = await asyncio.get_running_loop().run_in_executor(
+            control_executor, partial(wait_for_beam_control, base_url, name, value,
+                clear=clear, timeout=control_timeout, poll_interval=control_poll_interval,
+                initial_status=acknowledgment))
+        event(name, "effective", response, value=value, clear=clear)
+
+    async def track_manual(name, specification, acknowledgment):
+        try:
+            if name == "microbatch_size" and microbatch_pattern:
+                for index, value in enumerate(microbatch_pattern):
+                    if index:
+                        await asyncio.sleep(control_interval)
+                        acknowledgment = await post_manual(name, value, False)
+                    await await_manual(name, value, False, acknowledgment)
+            else:
+                await await_manual(name, specification["value"], specification["clear"],
+                                   acknowledgment)
+        except Exception as error:
+            detail = {"control": name, "error_type": type(error).__name__, "detail": str(error)}
+            control_errors.append(detail)
+            event(name, "failed", **detail)
+
+    async def sample_once():
+        nonlocal cycle
+        records = await asyncio.get_running_loop().run_in_executor(monitor_executor, sample)
+        elapsed = time.perf_counter() - start
+        monitor_samples.extend({**row, "cycle": cycle, "client_elapsed_s": elapsed}
+                               for row in records)
+        cycle += 1
+
+    async def monitor():
+        while not monitor_stop.is_set():
+            try:
+                await asyncio.wait_for(monitor_stop.wait(), timeout=monitor_interval)
+            except TimeoutError:
+                await sample_once()
+
+    async def send(index, row):
+        async with semaphore:
+            def dispatch():
+                dispatch_times[index] = time.perf_counter() - start
+                return request(base_url, model, row["prompt"], row["output_len"],
+                               chat=chat, timeout=timeout)
+
+            return await asyncio.to_thread(dispatch)
+
+    try:
+        for key, value in (controls or {}).items():
+            if key not in ("ttft_slo", "tbt_slo", "tpot_slo"):
+                raise ValueError("use typed live_controls for chunk/microbatch commands")
+            await asyncio.to_thread(post_control, base_url, "update_" + key,
+                                    {key: positive(value, key)}, timeout)
+        if output_dir is not None:
+            profile_attempted = True
+            await asyncio.to_thread(post_control, base_url, "start_profile",
+                                    {"output_dir": str(output_dir)}, timeout)
+        manual = dict(live_controls)
+        if microbatch_pattern:
+            manual["microbatch_size"] = {"value": microbatch_pattern[0], "clear": False}
+        for name, specification in manual.items():
+            acknowledgments[name] = await post_manual(
+                name, specification["value"], specification["clear"])
+        start = time.perf_counter()
+        control_tasks = [asyncio.create_task(track_manual(name, specification,
+                                                          acknowledgments[name]))
+                         for name, specification in manual.items()]
+        monitor_deadline = start
+        if sample is not None:
+            await sample_once()
+            monitor_deadline = time.perf_counter() + monitor_seconds
+            monitor_task = asyncio.create_task(monitor())
+        for index, row in enumerate(rows):
+            delay = start + row["timestamp"] - time.perf_counter()
+            await asyncio.sleep(max(0, delay))
+            entry_times.append(time.perf_counter() - start)
+            tasks.append(asyncio.create_task(send(index, row)))
+        # Gather every submitted request, including failures, before stopping workers.
+        outputs = await asyncio.gather(*tasks, return_exceptions=True)
+        for output in outputs:
+            if isinstance(output, BaseException):
+                raise output
+        duration = time.perf_counter() - start
+        if control_tasks:
+            await asyncio.gather(*control_tasks)
+        if sample is not None:
+            await asyncio.sleep(max(0, monitor_deadline - time.perf_counter()))
+    finally:
+        try:
+            if tasks:
+                await asyncio.gather(*tasks, return_exceptions=True)
+            if control_tasks:
+                await asyncio.gather(*control_tasks, return_exceptions=True)
+            monitor_stop.set()
+            if monitor_task is not None:
+                await monitor_task
+            if sample is not None and start is not None:
+                await sample_once()
+        finally:
+            try:
+                if profile_attempted:
+                    await asyncio.to_thread(post_control, base_url, "stop_profile", {}, timeout)
+            finally:
+                if monitor_executor is not None:
+                    monitor_executor.shutdown(wait=True)
+                if control_executor is not None:
+                    control_executor.shutdown(wait=True)
+    data = {
+        "duration": duration, "input_lens": [row["input_len"] for row in rows],
+        "requested_output_lens": [row["output_len"] for row in rows],
+        "scheduled_entry_times": [row["timestamp"] for row in rows],
+        "entry_times": entry_times, "dispatch_times": dispatch_times,
+        "client_queue_seconds": [sent - entry
+                                 for sent, entry in zip(dispatch_times, entry_times)],
+        "ttfts": [out["ttft"] for out in outputs],
+        "itls": [out["itl"] for out in outputs],
+        "e2el": [out["latency"] for out in outputs],
+        "output_lens": [out["output_tokens"] for out in outputs],
+        "successes": [out["success"] for out in outputs],
+        "errors": [out["error"] for out in outputs],
+        "generated_texts": [out["generated_text"] for out in outputs],
+        "estimated_ttfts": [out["estimated_ttft"] for out in outputs],
+        "estimated_tbts_list": [out["estimated_tbts"] for out in outputs],
+        "stream_token_chunks": [out["stream_token_chunks"] for out in outputs],
+        "stream_token_counts": [out.get("stream_token_count") for out in outputs],
+        "tokens_per_chunk": [out.get("tokens_per_chunk", []) for out in outputs],
+        "token_id_coverage_complete": [out.get("token_id_coverage_complete", False) for out in outputs],
+        "token_timing_sources": [out.get("token_timing_source", "unknown") for out in outputs],
+        "output_token_count_sources": [out.get("output_token_count_source", "unknown") for out in outputs],
+        "monitor_samples": monitor_samples,
+        "control_events": control_events, "control_errors": control_errors,
+        "timing_note": "seconds; TTFT/ITL from dispatch to chunks, excludes client queue",
+        "backend": "openai-chat" if chat else "vllm",
+    }
+    return data
+
+
+def metrics(data, *, ttft, tpot, tbt):
+    ttfts, tpots, itls, latencies = [], [], [], []
+    tokens = completed = good = unknown_tokens = 0
+    for ok, first, gaps, latency, length in zip(
+        data["successes"], data["ttfts"], data["itls"], data["e2el"],
+        data["output_lens"], strict=True,
+    ):
+        if not ok:
+            continue
+        completed += 1
+        ttfts.append(first)
+        itls.extend(gaps)
+        latencies.append(latency)
+        if length is None:
+            unknown_tokens += 1
+            continue
+        tokens += length
+        per_token = (latency - first) / (length - 1) if length > 1 else 0
+        if length > 1:
+            tpots.append(per_token)
+        good += first <= ttft and per_token <= tpot and all(gap <= tbt for gap in gaps)
+    result = {"completed": completed, "failed": len(data["successes"]) - completed,
+              "unknown_output_counts": unknown_tokens,
+              "known_output_tokens": tokens,
+              "total_output_tokens": None if unknown_tokens else tokens,
+              "request_throughput": completed / data["duration"],
+              "request_goodput": None if unknown_tokens else good / data["duration"],
+              "output_throughput": None if unknown_tokens else tokens / data["duration"],
+              "goodput_slos_seconds": {"ttft": ttft, "tpot": tpot, "tbt": tbt}}
+    series = (("ttft", ttfts), ("tpot", tpots), ("itl", itls), ("e2el", latencies))
+    for name, values in series:
+        for key, function in (("mean", statistics.mean), ("median", statistics.median),
+                              ("std", statistics.pstdev)):
+            result[f"{key}_{name}_ms"] = function(values) * 1000 if values else None
+        for p in (90, 99):
+            value = percentile(values, p / 100)
+            result[f"p{p}_{name}_ms"] = value * 1000 if value is not None else None
+    return result
+
+
+def workload_arguments(parser):
+    source = parser.add_mutually_exclusive_group(required=True)
+    source.add_argument("--trace", help="CSV path relative to --artifact-root")
+    source.add_argument("--requests", help="replay an earlier requests.json exactly")
+    source.add_argument("--rates", type=float, nargs="+",
+                        help="weighted stair/burst phase rates")
+    parser.add_argument("--num-prompts", type=int, default=180)
+    parser.add_argument("--input-len", type=int, default=512)
+    parser.add_argument("--output-len", type=int, default=64)
+    parser.add_argument("--range-ratio", type=float, default=.5)
+    parser.add_argument("--burstiness", type=float, default=1.)
+    parser.add_argument("--seed", type=int, default=42)
+    parser.add_argument("--tokenizer")
+    parser.add_argument("--chat", action="store_true")
+    parser.add_argument("--max-concurrency", type=int, default=128)
+    parser.add_argument("--timeout", type=float, default=21600)
+    parser.add_argument("--monitor-interval", type=float, default=.2)
+    parser.add_argument("--monitor-seconds", type=float, default=0,
+                        help="minimum sampled interval; use 30 for Dynamo calibration")
+    chunk = parser.add_mutually_exclusive_group()
+    chunk.add_argument("--chunk-size", type=int)
+    chunk.add_argument("--clear-chunk-size", action="store_true")
+    microbatch = parser.add_mutually_exclusive_group()
+    microbatch.add_argument("--microbatch-size", type=int)
+    microbatch.add_argument("--clear-microbatch-size", action="store_true")
+    microbatch.add_argument("--microbatch-pattern", type=int, nargs="+")
+    parser.add_argument("--control-timeout", type=float, default=30)
+    parser.add_argument("--control-poll-interval", type=float, default=.1)
+    parser.add_argument("--control-interval", type=float, default=2,
+                        help="seconds between confirmed effective microbatch pattern entries")
+
+
+def live_control_options(args, hard_budget):
+    controls = {}
+    for name in ("chunk_size", "microbatch_size"):
+        value, clear = getattr(args, name), getattr(args, "clear_" + name)
+        if value is not None or clear:
+            limit = hard_budget if name == "chunk_size" else args.pp
+            if value is not None and not 1 <= value <= limit:
+                raise ValueError(f"manual {name} must be in 1..{limit}")
+            controls[name] = {"value": value, "clear": clear}
+    if args.microbatch_pattern and any(not 1 <= value <= args.pp
+                                       for value in args.microbatch_pattern):
+        raise ValueError("microbatch pattern values must be in 1..physical PP")
+    if ("microbatch_size" in controls or args.microbatch_pattern) and args.mode not in ("D", "S2"):
+        raise ValueError("manual microbatch controls require an S2 mode")
+    if args.mode == "B3" and args.chunk_size not in (None, 256):
+        raise ValueError("B3 permits only manual chunk_size=256")
+    for name in ("control_timeout", "control_poll_interval", "control_interval"):
+        positive(getattr(args, name), name)
+    return controls
+
+
+def benchmark_case(args, base_url, directory):
+    phases = []
+    if args.requests:
+        rows = json.loads(Path(args.requests).read_text())
+    else:
+        from vllm.tokenizers import get_tokenizer
+
+        tokenizer = get_tokenizer(args.tokenizer or args.model)
+        if args.trace:
+            rows = load_trace(artifact_path(args.artifact_root, args.trace))
+        else:
+            rows, phases = synthetic(
+                args.num_prompts, args.input_len, args.output_len,
+                args.range_ratio, args.rates, args.burstiness, args.seed,
+            )
+        add_prompts(rows, tokenizer, args.seed, chat=args.chat)
+    if any(row["input_len"] + row["output_len"] > args.max_model_len for row in rows):
+        raise ValueError("trace/request exceeds max_model_len; no silent length clipping")
+    # Record workloads so future comparisons can use the exact generated arrivals.
+    write_json(directory / "requests.json", rows)
+    data = asyncio.run(replay(
+        rows, base_url=base_url, model=args.model, output_dir=str(directory / "worker"),
+        controls=slo_controls(args.mode, args.tpot, args.tbt, args.ttft, args.s1_policy),
+        max_concurrency=args.max_concurrency, chat=args.chat,
+        timeout=positive(args.timeout, "timeout"),
+        sample=lambda: collective_rpc(base_url, "beam_tools_sample"),
+        monitor_interval=args.monitor_interval, monitor_seconds=args.monitor_seconds,
+        live_controls=live_control_options(args, 256 if args.mode in ("A", "B", "B2", "B3") else args.budget),
+        microbatch_pattern=args.microbatch_pattern, control_timeout=args.control_timeout,
+        control_poll_interval=args.control_poll_interval, control_interval=args.control_interval,
+    ))
+    data.update(metrics(data, ttft=args.ttft, tpot=args.tpot, tbt=args.tbt))
+    data["comparison_cohort"] = run_cohort(args)
+    data["phase_info"] = phases
+    write_json(directory / "result.json", data)
+    from benchmarks.energy.analysis import legacy_monitor_csv
+
+    legacy_monitor_csv(data["monitor_samples"], directory / "gpu_energy_monitor.csv")
+    estimates = zip(data["estimated_ttfts"], data["estimated_tbts_list"],
+                    data["successes"], strict=True)
+    write_json(directory / "result_estimations.json", {"estimations": [
+        {"request_index": index, "estimated_ttft": first, "estimated_tbts": gaps,
+         "success": ok} for index, (first, gaps, ok) in enumerate(estimates)
+    ]})
+    if not all(data["successes"]):
+        raise RuntimeError("benchmark has failed requests; inspect saved result.json")
+    if data["control_errors"]:
+        raise RuntimeError("manual control failed/timed out; inspect saved control_events in result.json")
+
+
+if __name__ == "__main__":
+    # The lifecycle harness binds target version, model, mode and server binary.
+    raise SystemExit("Use -m benchmarks.energy.beam_tools run; see REPRODUCE.md")
