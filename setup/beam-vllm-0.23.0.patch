+@pytest.fixture
+def trial_core(monkeypatch):
+    from tests.v1.core.test_beam_scheduler import enable_beam, runner_output
+    from tests.v1.core.utils import create_scheduler
+    from tests.v1.engine.test_beam_pipeline import core_for
+    from vllm.v1.executor.multiproc_executor import MultiprocExecutor
+
+    class StagedExecutor(MultiprocExecutor):
+        """Only workers are fake; the scheduler, KV allocator and Core are real.
+
+        V2's fake sample ring deliberately carries even final samples so the
+        cleanup must advance P real invocations and discard freed request state.
+        """
+
+        def __init__(self, scheduler, pp, v2):
+            self.scheduler, self.pp, self.v2 = scheduler, pp, v2
+            self.output_rank = pp - 1  # fixture TP=1, last native pipeline stage
+            self.executed = []
+            self.stages = []
+            self.profile_calls = []
+            self.active = False
+            self.worker_requests = set()
+            self.sampled = {}
+            self.ring = deque([None] * pp)
+            self.before_measure = None
+            self.fail_measure = False
+            self.fail_sample = False
+            self.fail_stop = False
+            self.is_failed = False
+            self._beam_response_stream_failed = False
+
+        def execute_model(self, output, non_block=True):
+            assert non_block
+            self.executed.append((output, self.active))
+            if self.v2 and self.pp > 1:
+                carried = self.ring.popleft()
+                self.ring.append(None)
+                for rid, token in (carried or {}).items():
+                    if rid in self.worker_requests:
+                        self.sampled[rid] = token
+            self.worker_requests.difference_update(output.finished_req_ids)
+            self.worker_requests.update(r.req_id for r in output.scheduled_new_reqs)
+            for stage in range(self.pp):
+                self.stages.append((stage, output.total_num_scheduled_tokens > 0,
+                                    self.active))
+            if self.active and self.fail_measure:
+                self.fail_measure = False
+                raise RuntimeError("fake native forward failed")
+            cached = output.scheduled_cached_reqs
+            for i, rid in enumerate(cached.req_ids):
+                request = self.scheduler.requests[rid]
+                if request.num_output_tokens == 1:
+                    if self.v2 and self.pp > 1:
+                        assert self.sampled.get(rid) == 7, "PP carry used too early"
+                    elif self.pp > 1:
+                        assert cached.new_token_ids[i] == [7]
+            self.latest = output
+            return ready(runner_output(output) if not output.total_num_scheduled_tokens
+                         else None)
+
+        def sample_tokens(self, grammar_output, non_block=False):
+            assert grammar_output is None
+            assert not non_block
+            if self.active and self.fail_sample:
+                self.fail_sample = False
+                raise RuntimeError("fake native sampling failed")
+            tokens = {rid: [7] for rid in self.latest.beam_sampling_req_ids}
+            if self.v2 and self.pp > 1 and tokens:
+                self.ring[-1] = {rid: values[0] for rid, values in tokens.items()}
+            else:
+                self.sampled.update({rid: values[0] for rid, values in tokens.items()})
+            return runner_output(self.latest, tokens)
+
+        def profile(self, is_start=True, profile_prefix=None, output_dir=None):
+            self.profile_calls.append((is_start, profile_prefix, output_dir))
+            if not is_start and self.fail_stop:
+                raise OSError("fake profiler stop failed")
+            self.active = is_start
+            if is_start and self.before_measure is not None:
+                self.before_measure()
+
+    def make(pp=1, v2=False, **kwargs):
+        scheduler = create_scheduler(
+            pipeline_parallel_size=pp, max_num_batched_tokens=16,
+            max_model_len=256, **kwargs,
+        )
+        scheduler.use_v2_model_runner = v2
+        enable_beam(scheduler, monkeypatch, custom_profiler=True)
+        scheduler.parallel_config.distributed_executor_backend = "mp"
+        monkeypatch.setattr(scheduler.vllm_config.device_config, "device_type", "cuda")
+        core = core_for(scheduler, capacity=pp if pp > 1 else None)
+        core.request_block_hasher = None
+        core.model_executor = StagedExecutor(scheduler, pp, v2)
+        return core
+
+    return make
+
