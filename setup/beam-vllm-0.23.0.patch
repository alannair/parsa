+def campaign(args):
+    """Ordered explicit cases, fresh server per case; abort on any failed step."""
+    manifest = json.loads(Path(args.manifest).read_text())
+    cases = manifest["cases"]
+    if not cases or len({case["name"] for case in cases}) != len(cases):
+        raise ValueError("campaign requires nonempty uniquely named cases")
+    root = Path(args.output).resolve()
+    root.mkdir(parents=True, exist_ok=False)
+    write_json(root / "campaign.json", manifest)
+    for case in cases:
+        if not re.fullmatch(r"[A-Za-z0-9_-]+", case["name"]):
+            raise ValueError("campaign names must be safe directory names")
+        argv = case["args"]
+        reserved = ("--artifact-root", "--vllm-bin", "--output")
+        if any(value.split("=", 1)[0] in reserved for value in argv):
+            raise ValueError("campaign case cannot override artifact-root/vllm-bin/output")
+        run_case(parser().parse_args([
+            "run", "--artifact-root", args.artifact_root, "--vllm-bin", args.vllm_bin,
+            "--output", str(root / case["name"]), *argv,
+        ]))
+
+
+def pipeline(args):
+    """Typed workflow sequencing, with no shell evaluation or arbitrary scripts."""
+    manifest = json.loads(Path(args.manifest).read_text())
+    steps = manifest["steps"]
+    allowed = {"run", "offline-profile", "generation-grid", "mixed-profile", "dynamo-sweep",
+               "dynamo-collect", "dynamo-merge", "evaluate", "visualize",
+               "compare", "heatmap", "overhead"}
+    if not steps or len({step["name"] for step in steps}) != len(steps):
+        raise ValueError("pipeline requires nonempty uniquely named steps")
+    for step in steps:
+        if not re.fullmatch(r"[A-Za-z0-9_-]+", step["name"]) or step["command"] not in allowed:
+            raise ValueError("pipeline requires safe names and supported tooling commands")
+        if any(value.split("=", 1)[0] in ("--artifact-root", "--vllm-bin", "--output")
+               for value in step["args"]):
+            raise ValueError("pipeline step cannot override root/binary/output")
+    root = Path(args.output).resolve()
+    root.mkdir(parents=True, exist_ok=False)
+    write_json(root / "pipeline.json", manifest)
+    for step in steps:
+        command = step["command"]
+        extension = {"dynamo-collect": ".csv", "dynamo-merge": ".csv",
+                     "evaluate": ".json"}.get(command, "")
+        destination = root / (step["name"] + extension)
+        argv = [command, "--output", str(destination)]
+        if command in ("run", "offline-profile", "generation-grid", "mixed-profile", "dynamo-sweep"):
+            argv += ["--artifact-root", args.artifact_root]
+        if command in ("run", "dynamo-sweep"):
+            argv += ["--vllm-bin", args.vllm_bin]
+        argv += [value.replace("{root}", str(root)) for value in step["args"]]
+        try:
+            main(argv)
+        except BaseException as error:
+            write_json(root / "failure.json", {"step": step["name"],
+                                               "error_type": type(error).__name__})
+            raise
+        write_json(root / (step["name"] + ".completed.json"), {
+            "command": command, "output": str(destination),
+        })
+
