+No ambient proxy, global GPU monitor, or import-time vLLM initialization.
+"""
+
+import json
+import math
+import os
+import time
+from urllib.request import ProxyHandler, Request, build_opener
+from urllib.parse import urlparse
+
+SAMPLING_PARAMETERS = {"temperature": 0.0, "ignore_eos": True,
+                       "return_token_ids": True, "n": 1}
+
+
+def headers():
+    result = {"Content-Type": "application/json"}
+    if key := os.environ.get("OPENAI_API_KEY"):
+        result["Authorization"] = "Bearer " + key
+    return result
+
+
+def post_control(base_url, route, body, timeout=60, *, result=False):
+    request = Request(base_url.rstrip("/") + "/" + route,
+                      data=json.dumps(body, allow_nan=False).encode(),
+                      headers=headers(), method="POST")
+    # SLO/profile controls return empty 200 bodies; do not require JSON.
+    with build_opener(ProxyHandler({})).open(request, timeout=timeout) as response:
+        if response.status != 200:
+            raise RuntimeError(f"{route} returned HTTP {response.status}")
+        content = response.read()
+        return json.loads(content) if result else None
+
+
+def collective_rpc(base_url, method, kwargs=None, timeout=60):
+    if urlparse(base_url).hostname not in ("127.0.0.1", "localhost", "::1"):
+        raise ValueError("tooling dev RPC requires a loopback-owned server")
+    if method not in ("beam_tools_identity", "beam_tools_clock", "beam_tools_sample"):
+        raise ValueError("unsupported tooling worker RPC")
+    return post_control(base_url, "collective_rpc", {
+        "method": method, "kwargs": kwargs or {}, "timeout": timeout,
+    }, timeout, result=True)["results"]
+
+
+def _beam_states(status):
+    """Validate local status or the DP frontend's per-engine status envelope."""
+    if not isinstance(status, dict) or status.get("status") not in ("queued", "applied"):
+        raise ValueError("BEAM control response must be a queued/applied status object")
+    if "engines" in status:
+        engines = status["engines"]
+        if not isinstance(engines, list) or not engines:
+            raise ValueError("BEAM status envelope requires nonempty engine results")
+        return [state for engine in engines for state in _beam_states(engine)]
+    if (type(status.get("physical_pp")) is not int or status["physical_pp"] < 1
+            or status.get("state") not in ("ACTIVE", "FLUSH", "RETIRE_ONLY")):
+        raise ValueError("BEAM status lacks physical PP/transition state")
+    for name in ("chunk_size", "microbatch_size"):
+        control = status.get(name)
+        if (not isinstance(control, dict)
+                or type(control.get("manual")) is not bool
+                or type(control.get("pending")) is not bool
+                or type(control.get("effective")) is not int or control["effective"] < 0
+                or "requested" not in control
+                or (control["requested"] is not None and (
+                    type(control["requested"]) is not int or control["requested"] < 1))):
+            raise ValueError(f"BEAM status lacks typed {name} intent/effective fields")
+    return [status]
+
+
+def get_beam_status(base_url, timeout=60) -> dict:
+    req = Request(base_url.rstrip("/") + "/beam_status", headers=headers(), method="GET")
+    with build_opener(ProxyHandler({})).open(req, timeout=timeout) as response:
+        if response.status != 200:
+            raise RuntimeError(f"beam_status returned HTTP {response.status}")
+        status = json.loads(response.read())
+    _beam_states(status)
+    return status
+
+
+def _update_beam_control(base_url, name, value, *, clear=False, timeout=60):
+    if type(clear) is not bool or (clear and value is not None) or (
+        not clear and (type(value) is not int or value < 1)
+    ):
+        raise ValueError("provide a positive integer control value or clear=True, not both")
+    body = {"clear": True} if clear else {name: value}
+    status = post_control(base_url, "update_" + name, body, timeout, result=True)
+    _beam_states(status)  # Never discard/accept an empty or untyped acknowledgment.
+    return status
+
+
+def update_chunk_size(base_url, chunk_size: int | None = None, *, clear: bool = False,
+                      timeout=60) -> dict:
+    return _update_beam_control(base_url, "chunk_size", chunk_size, clear=clear, timeout=timeout)
+
+
+def update_microbatch_size(base_url, microbatch_size: int | None = None, *, clear: bool = False,
+                           timeout=60) -> dict:
+    return _update_beam_control(base_url, "microbatch_size", microbatch_size,
+                                clear=clear, timeout=timeout)
+
+
+def wait_for_beam_control(base_url, name, value=None, *, clear=False, timeout=30,
+                          poll_interval=.1, initial_status=None) -> dict:
+    """Wait for every engine's effective state, not merely a queued HTTP 200."""
+    if name not in ("chunk_size", "microbatch_size"):
+        raise ValueError("unknown BEAM control name")
+    if type(clear) is not bool or (clear and value is not None) or (
+        not clear and (type(value) is not int or value < 1)
+    ):
+        raise ValueError("wait requires a positive integer intent or clear=True")
+    if (not math.isfinite(timeout) or timeout <= 0
+            or not math.isfinite(poll_interval) or poll_interval <= 0):
+        raise ValueError("control timeout/poll interval must be positive finite seconds")
+    deadline = time.monotonic() + timeout
+    status = initial_status if initial_status is not None else get_beam_status(base_url, timeout)
+    while True:
+        states = _beam_states(status)
+        applied = True
+        for state in states:
+            control = state[name]
+            if control["requested"] != (None if clear else value) or control["manual"] != (not clear):
+                raise ValueError(f"{name} intent was superseded before it became effective")
+            ready = not control["pending"]
+            if name == "microbatch_size":
+                if control.get("supported") is not True:
+                    raise ValueError("microbatch_size is unsupported by an engine")
+                ready = (ready and state["state"] == "ACTIVE"
+                         and not control.get("prefill_superseded", False)
+                         and (clear or control["effective"] == value))
+            elif not clear:
+                # A chunk is an admission ceiling; native capacity can lower it.
+                ready = ready and control["effective"] <= value
+            applied = applied and ready
+        if applied:
+            return status
+        remaining = deadline - time.monotonic()
+        if remaining <= 0:
+            raise TimeoutError(f"{name} did not become effective: {json.dumps(status)}")
+        time.sleep(min(poll_interval, remaining))
+        remaining = deadline - time.monotonic()
+        if remaining <= 0:
+            raise TimeoutError(f"{name} did not become effective: {json.dumps(status)}")
+        status = get_beam_status(base_url, min(60, remaining))
+
+
+def consume_sse(frames, *, chat):
+    output = {"success": False, "generated_text": "", "ttft": None, "itl": [],
+              "latency": None, "output_tokens": None, "error": "",
+              "estimated_ttft": None, "estimated_tbts": None,
+              "stream_token_chunks": 0, "stream_token_count": None,
+              "tokens_per_chunk": [], "token_id_coverage_complete": False}
+    previous = None
+    known_tokens = 0
+    text_fallback = False
+    for timestamp, data in frames:
+        if "error" in data:
+            raise ValueError("stream returned an error object")
+        if not math.isfinite(timestamp) or timestamp < 0:
+            raise ValueError("invalid stream timestamp")
+        choices = data.get("choices", [])
+        if len(choices) > 1:
+            raise ValueError("only n=1 streams are supported")
+        for choice in choices:
+            # Fields are full snapshots, not deltas. Never concatenate TBT lists.
+            for key in ("estimated_ttft", "estimated_tbts"):
+                value = choice.get(key)
+                if value is not None:
+                    values = value if key == "estimated_tbts" else [value]
+                    if (not isinstance(values, list)
+                            or any(isinstance(v, bool) or not isinstance(v, (int, float))
+                                   or not math.isfinite(v) or v < 0 for v in values)):
+                        raise ValueError("invalid fidelity estimate")
+                    output[key] = value
+            text = choice.get("delta", {}).get("content") if chat else choice.get("text")
+            token_ids = choice.get("token_ids")
+            if token_ids is not None:
+                if (not isinstance(token_ids, list)
+                        or any(type(token) is not int or token < 0 for token in token_ids)):
+                    raise ValueError("invalid delta token_ids")
+                token_chunk = bool(token_ids)
+                count = len(token_ids)
+            else:
+                # Text-only servers cannot identify empty decoded tokens or grouping.
+                token_chunk = isinstance(text, str) and bool(text)
+                count = None
+            if token_chunk:
+                if previous is None:
+                    output["ttft"] = timestamp
+                else:
+                    if timestamp < previous:
+                        raise ValueError("stream timestamps decreased")
+                    output["itl"].append(timestamp - previous)
+                previous = timestamp
+                output["latency"] = timestamp
+                output["stream_token_chunks"] += 1
+                output["tokens_per_chunk"].append(count)
+                if count is None:
+                    text_fallback = True
+                else:
+                    known_tokens += count
+            if isinstance(text, str):
+                output["generated_text"] += text
+        usage = data.get("usage")
+        if usage is not None and usage.get("completion_tokens") is not None:
+            tokens = usage["completion_tokens"]
+            if type(tokens) is not int or tokens < 0:
+                raise ValueError("invalid usage completion_tokens")
+            output["output_tokens"] = tokens
+    if previous is None:
+        raise ValueError("stream produced no text/token chunks")
+    complete_ids = (not text_fallback and known_tokens > 0
+                    and output["output_tokens"] in (None, known_tokens))
+    output["token_id_coverage_complete"] = complete_ids
+    output["stream_token_count"] = known_tokens if complete_ids else None
+    output["token_timing_source"] = "token_ids" if complete_ids else "text_or_incomplete_token_ids"
+    if output["output_tokens"] is not None:
+        output["output_token_count_source"] = "usage"
+    elif complete_ids:
+        output["output_tokens"] = known_tokens
+        output["output_token_count_source"] = "token_ids"
+    else:
+        output["output_token_count_source"] = "unknown"
+    output["success"] = True
+    return output
+
+
+def request(base_url, model, prompt, output_len, *, chat=False, timeout=21600):
+    payload = {"model": model, "stream": True, **SAMPLING_PARAMETERS,
+               "stream_options": {"include_usage": True}}
+    if chat:
+        if not isinstance(prompt, str):
+            raise ValueError("chat requires a decoded text prompt")
+        payload.update(messages=[{"role": "user", "content": prompt}],
+                       max_completion_tokens=output_len)
+    else:
+        payload.update(prompt=prompt, max_tokens=output_len)
+    route = "/v1/chat/completions" if chat else "/v1/completions"
+    http_request = Request(base_url.rstrip("/") + route,
+                           data=json.dumps(payload, allow_nan=False).encode(),
+                           headers=headers(), method="POST")
+    start = time.perf_counter()
+    try:
+        with build_opener(ProxyHandler({})).open(http_request, timeout=timeout) as response:
+            if response.status != 200:
+                raise RuntimeError(f"HTTP {response.status}")
+            done = False
+
+            def frames():
+                nonlocal done
+                lines = []
+                for raw in response:
+                    line = raw.decode("utf-8").rstrip("\r\n")
+                    if line.startswith("data:"):
+                        lines.append(line[5:].lstrip(" "))
+                    elif not line and lines:
+                        data = "\n".join(lines)
+                        lines.clear()
+                        if data == "[DONE]":
+                            done = True
+                            return
+                        yield time.perf_counter() - start, json.loads(data)
+                if lines:
+                    raise ValueError("incomplete SSE frame")
+
+            output = consume_sse(frames(), chat=chat)
+            if not done:
+                raise ValueError("stream ended before [DONE]")
+            output["response_elapsed"] = time.perf_counter() - start
+            return output
+    except Exception as error:
+        # Do not serialize request headers, credentials, or full remote bodies.
+        return {"success": False, "error": type(error).__name__,
+                "generated_text": "", "ttft": None, "itl": [], "latency": None,
+                "output_tokens": None, "estimated_ttft": None, "estimated_tbts": None,
+                "response_elapsed": time.perf_counter() - start,
+                "stream_token_chunks": 0, "stream_token_count": None, "tokens_per_chunk": [],
+                "token_id_coverage_complete": False, "token_timing_source": "failed",
+                "output_token_count_source": "unknown"}
