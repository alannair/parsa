+# Adapted selection rules from BEAM-artifact/.../sched/dynamo_energy_model.py.
+# Original portions: SPDX-License-Identifier: Apache-2.0
+
+"""Pure DynamoLLM baseline lookup without pandas/scipy or hardware imports."""
+
+import math
+from bisect import bisect_left
+from dataclasses import dataclass, replace
+
+from .energy_model import _integer, _number, _read_profile
+
+
+@dataclass
+class ClockChoice:
+    """Artifact-compatible result; energy_per_req_j retains a historical name.
+
+    Its value is the CSV's gpu_power metric, historically labeled energy per
+    request. No unit conversion or claim that it is measured joules is made.
+    TTFT/TBT and SLOs retain the baseline's milliseconds convention.
+    """
+
+    tp_degree: int
+    pp_degree: int
+    freq_mhz: int
+    target_tps: int
+    energy_per_req_j: float
+    ttft_ms: float
+    tbt_ms: float
+    feasible: bool
+
+
+class ClockSelector:
+    """Exact TPS, then per-clock linear estimates, then nearest measured TPS.
+
+    Linear extrapolation is limited to [0.5 * min TPS, 2 * max TPS] for each
+    clock. Nonpositive/nonfinite extrapolated metrics are discarded. If any
+    exact TPS rows exist, only those rows compete, as in the artifact. Nearest
+    TPS is used only when no linear candidates remain; equal distances choose
+    the lower TPS. A missing TP/PP topology returns None, never another layout.
+    Feasible candidates minimize (gpu_power, TTFT, clock); otherwise select the
+    maximum candidate frequency and mark it infeasible. Duplicate measurements
+    of the same topology/clock/TPS are rejected as ambiguous.
+    """
+
+    def __init__(
+        self,
+        profiling_csv_path: str,
+        ttft_slo_ms: float,
+        tbt_slo_ms: float,
+        use_ttft_p99: bool = False,
+        use_tbt_p90: bool = False,
+    ):
+        self.profiling_csv_path = profiling_csv_path
+        self.ttft_slo_ms = _number(ttft_slo_ms, "ttft_slo_ms", positive=True)
+        self.tbt_slo_ms = _number(tbt_slo_ms, "tbt_slo_ms", positive=True)
+        self.use_ttft_p99 = use_ttft_p99
+        self.use_tbt_p90 = use_tbt_p90
+        rows = _read_profile(profiling_csv_path, (
+            "clock", "tp", "pp", "tps", "gpu_power", "ttft_mean", "tbt_mean",
+            "ttft_p99", "tbt_p90",
+        ))
