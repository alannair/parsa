+@pytest.mark.parametrize("damage", ["header_only", "partial", "duplicate_clock", "missing_marker", "hash"])
+def test_generation_resume_rejects_incomplete_or_tampered_points(tmp_path, damage):
+    directory = tmp_path / "point"
+    args, marker = generation_point_fixture(directory)
+    table = directory / "measurements.csv"
+    lines = table.read_text().splitlines()
+    if damage == "missing_marker":
+        (directory / "completed.json").unlink()
+    else:
+        if damage == "header_only":
+            lines = lines[:1]
+        elif damage in ("partial", "hash"):
+            lines = lines[:2]
+        else:
+            lines = [lines[0], lines[1], lines[1]]
+        table.write_text("\n".join(lines) + "\n")
+        if damage != "hash":
+            # Even a matching digest must not bypass schema/clock×rank coverage.
+            marker["table_sha256"] = hashlib.sha256(table.read_bytes()).hexdigest()
+            (directory / "completed.json").write_text(json.dumps(marker))
+    with pytest.raises(ValueError, match="coverage|completion marker|hash"):
+        tools.validate_generation_point(directory, args, "source", "artifact")
